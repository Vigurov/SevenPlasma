#!/bin/sh
# Prints the user names of the accounts without a password (AccountsService PasswordMode 2), one per line.
# Used by the logon screen (runs as the sddm user) and the lock screen: Windows 7 shows no password box for
# them, a click on the picture logs on.
for p in $(busctl call org.freedesktop.Accounts /org/freedesktop/Accounts org.freedesktop.Accounts ListCachedUsers 2>/dev/null \
           | grep -o '/org/freedesktop/Accounts/User[0-9]*'); do
    if [ "$(busctl get-property org.freedesktop.Accounts "$p" org.freedesktop.Accounts.User PasswordMode 2>/dev/null)" = "i 2" ]; then
        busctl get-property org.freedesktop.Accounts "$p" org.freedesktop.Accounts.User UserName 2>/dev/null | cut -d'"' -f2
    fi
done
exit 0
