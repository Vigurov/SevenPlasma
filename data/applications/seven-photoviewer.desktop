[Desktop Entry]
Type=Application
Name=Windows Photo Viewer
Name[uk]=Засіб перегляду фотографій Windows
GenericName=Photo Viewer
GenericName[uk]=Перегляд фотографій
Comment=Views, rotates and prints pictures and plays slide shows.
Comment[uk]=Перегляд, поворот і друк рисунків, показ слайдів
Exec=seven-photoviewer %f
Icon=seven-photoviewer
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/bmp;image/gif;image/tiff;image/webp;image/x-icon;image/vnd.microsoft.icon;image/x-bmp;
StartupWMClass=seven-photoviewer
