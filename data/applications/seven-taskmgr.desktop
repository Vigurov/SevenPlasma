[Desktop Entry]
Type=Application
Name=Windows Task Manager
Name[uk]=Диспетчер задач
GenericName[uk]=Диспетчер задач Windows
Comment[uk]=Програми, процеси, служби та швидкодія комп'ютера
Exec=seven-taskmgr
Icon=utilities-system-monitor
Categories=System;Monitor;
X-KDE-Shortcuts=Ctrl+Shift+Esc
# KDE's window list on Wayland (Applications tab) is only given to programs that ask for it here
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
