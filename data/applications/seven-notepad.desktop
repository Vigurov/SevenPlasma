[Desktop Entry]
Type=Application
Name=Notepad
Name[uk]=Блокнот
GenericName=Text Editor
GenericName[uk]=Текстовий редактор
Comment=Creates and edits text files using basic text formatting.
Comment[uk]=Створення й редагування текстових файлів зі звичайним форматуванням.
Exec=seven-control --notepad %f
Icon=seven-notepad
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/x-log;text/x-readme;text/csv;application/x-zerosize;
StartupWMClass=seven-notepad
