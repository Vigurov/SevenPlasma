-function fillActionMenu(i18n, actionMenu, actionList, favoriteModel, favoriteId) {
+/* Windows 7 context menu of a program in the Start menu (photo of the real one):
+ *   Open (bold) / Open file location / Pin to Taskbar / Pin to (Unpin from) Start Menu /
+ *   Remove from this list / Properties
+ * `extra` = { open: function, url: string, exec: function(cmd) } */
+function win7ActionList(i18n, actionList, favoriteModel, favoriteId, extra) {
+    var find = function (id) {
+        for (var i = 0; i < actionList.length; ++i) {
+            if (actionList[i] && actionList[i].actionId === id) {
+                return actionList[i];
+            }
+        }
+        return null;
+    };
+    var renamed = function (action, text) {
+        var copy = {};
+        for (var k in action) {
+            copy[k] = action[k];
+        }
+        copy.text = text;
+        copy.icon = null;
+        return copy;
+    };
+    var result = [];
+    var separator = function () {
+        if (result.length > 0 && result[result.length - 1].type !== "separator") {
+            result.push({ "type": "separator" });
+        }
+    };
+
+    if (extra.open) {
+        result.push({ text: i18n("Open"), bold: true, action: extra.open });
+    }
+    var path = "";
+    if (extra.url && extra.url.toString().indexOf("file://") === 0) {
+        path = decodeURIComponent(extra.url.toString().substring(7));
+    }
+    var desktopName = path ? "" : String(favoriteId || "").replace(/^applications:/, "").replace(/^.*\//, "");
+    if (extra.exec && (path || desktopName.indexOf(".desktop") > 0)) {
+        result.push({ text: i18n("Open file location"), action: function () {
+            if (path) {
+                extra.exec("dolphin --select '" + path.replace(/'/g, "'\\''") + "'");
+            } else {
+                extra.exec("sh -c 'f=$(find ~/.local/share/applications /usr/share/applications /var/lib/flatpak/exports/share/applications ~/.local/share/flatpak/exports/share/applications -name \"" + desktopName + "\" 2>/dev/null | head -1); [ -n \"$f\" ] && dolphin --select \"$f\"'");
+            }
+        } });
+    }
+
+    separator();
+    var pin = find("pinToTasks");
+    if (pin) {
+        result.push(renamed(pin, pin.text === i18n("Unpin from taskbar") ? i18n("Unpin from taskbar") : i18n("Pin to taskbar")));
+    }
+    // one item for the Start menu, whatever the activities are (Windows has no activities)
+    if (favoriteModel && favoriteModel.enabled && favoriteId) {
+        var pinned = favoriteModel.isFavorite(favoriteId);
+        result.push({
+            text: pinned ? i18n("Unpin from Start Menu") : i18n("Pin to Start Menu"),
+            actionId: pinned ? "_kicker_favorite_remove" : "_kicker_favorite_add",
+            actionArgument: { favoriteModel: favoriteModel, favoriteId: favoriteId }
+        });
+    }
+
+    var forget = find("forget");
+    if (forget) {
+        separator();
+        result.push(renamed(forget, i18n("Remove from this list")));
+    }
+    var edit = find("editApplication");
+    if (edit) {
+        separator();
+        result.push(renamed(edit, i18n("Properties")));
+    }
+    if (result.length > 0 && result[result.length - 1].type === "separator") {
+        result.pop();
+    }
+    return result;
+}
+
+function fillActionMenu(i18n, actionMenu, actionList, favoriteModel, favoriteId, extra) {
     // Accessing actionList can be a costly operation, so we don't
     // access it until we need the menu.
 
+    if (extra && favoriteId) {
+        actionMenu.actionList = win7ActionList(i18n, actionList || [], favoriteModel, favoriteId, extra);
+        return;
+    }
+
     var actions = createFavoriteActions(i18n, favoriteModel, favoriteId);
 
     if (actions) {
