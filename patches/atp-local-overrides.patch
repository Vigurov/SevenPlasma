+    // ---- Windows 7: additional clocks and formats from "Date and Time" / "Region and Language"
+    readonly property var win7Clocks: {
+        try {
+            return JSON.parse(Plasmoid.configuration.win7ExtraClocks || "[]").filter(c => c.show && c.zone);
+        } catch (e) {
