diff --git a/plasma/plasmoids/io.gitgud.wackyideas.keyboardlayout/contents/ui/Win7ToolTip.qml b/plasma/plasmoids/io.gitgud.wackyideas.keyboardlayout/contents/ui/Win7ToolTip.qml
new file mode 100644
index 0000000..0c0845c
--- /dev/null
+++ b/plasma/plasmoids/io.gitgud.wackyideas.keyboardlayout/contents/ui/Win7ToolTip.qml
@@ -0,0 +1,92 @@
+/*
+ * Windows 7 tooltip for the taskbar: a plain white box (white to #e4e5f0, #767676 border, #575757 text)
+ * above the mouse pointer, after the pointer rests for 600 ms. Plasma's own tooltips are glass.
+ * Put it inside the item it belongs to; it fills it and follows the pointer with a HoverHandler.
+ */
+import QtQuick
+import QtQuick.Window
+import org.kde.plasma.core as PlasmaCore
+
+Item {
+    id: tipRoot
+    anchors.fill: parent
+
+    property string text
+    property bool active: true
+    // a MouseArea with hoverEnabled that already tracks the pointer (its hover hides it from the HoverHandler)
+    property var area: null
+    readonly property bool hovered: area ? area.containsMouse : hover.hovered
+    onHoveredChanged: hovered ? tipTimer.restart() : hide()
+
+    function hide() {
+        tipTimer.stop();
+        tipDialog.visible = false;
+    }
+
+    onActiveChanged: if (!active) hide()
+    onTextChanged: if (!text) hide()
+
+    HoverHandler {
+        id: hover
+        enabled: !tipRoot.area
+        onPointChanged: if (hovered && !tipDialog.visible) tipTimer.restart()
+    }
+
+    Connections {
+        target: tipRoot.area
+        function onPositionChanged() {
+            if (!tipDialog.visible) {
+                tipTimer.restart();
+            }
+        }
+    }
+
+    Timer {
+        id: tipTimer
+        interval: 600
+        onTriggered: {
+            if (!tipRoot.hovered || !tipRoot.active || !tipRoot.text) {
+                return;
+            }
+            const g = tipRoot.area ? tipRoot.area.mapToGlobal(tipRoot.area.mouseX, tipRoot.area.mouseY)
+                                   : tipRoot.mapToGlobal(hover.point.position.x, hover.point.position.y);
+            const right = Screen.virtualX + Screen.width;
+            tipDialog.x = Math.round(Math.max(Screen.virtualX, Math.min(g.x, right - tipBox.width - 2)));
+            // the taskbar is at the bottom: above the pointer
+            tipDialog.y = Math.round(g.y - tipBox.height - 10);
+            tipDialog.visible = true;
+        }
+    }
+
+    PlasmaCore.Dialog {
+        id: tipDialog
+        type: PlasmaCore.Dialog.Tooltip
+        backgroundHints: PlasmaCore.Dialog.NoBackground
+        flags: Qt.ToolTip | Qt.WindowDoesNotAcceptFocus | Qt.WindowTransparentForInput | Qt.BypassWindowManagerHint
+        location: PlasmaCore.Types.Floating
+        visible: false
+        mainItem: Rectangle {
+            id: tipBox
+            width: tipText.implicitWidth + 12
+            height: tipText.implicitHeight + 8
+            radius: 2
+            border.color: "#767676"
+            gradient: Gradient {
+                GradientStop { position: 0.0; color: "#ffffff" }
+                GradientStop { position: 1.0; color: "#e4e5f0" }
+            }
+            Text {
+                id: tipText
+                x: 6
+                y: 4
+                text: tipRoot.text.indexOf("<") >= 0 ? tipRoot.text.replace(/\n/g, "<br>") : tipRoot.text
+                textFormat: tipRoot.text.indexOf("<") >= 0 ? Text.StyledText : Text.PlainText
+                lineHeight: 1.1
+                color: "#575757"
+                font.family: "Segoe UI"
+                font.pixelSize: 12
+                renderType: Text.NativeRendering
+            }
+        }
+    }
+}
