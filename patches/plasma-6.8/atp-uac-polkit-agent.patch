+    // Windows 7's "Program name": the program pkexec runs, past env, its variables and a shell
+    // polkit hands over only the pid of the asking process (pkexec): its command line is in /proc
+    QStringList words;
+    {
+        // pkexec makes its parent the subject: the pkexec itself is the subject's child
+        const QString subject = details.lookup(QStringLiteral("polkit.subject-pid"));
+        QString pid = subject;
+        const QStringList procs = QDir(QStringLiteral("/proc")).entryList(QDir::Dirs | QDir::NoDotAndDotDot);
+        for (const QString &p : procs) {
+            bool num = false;
+            p.toInt(&num);
+            if (!num) {
+                continue;
+            }
+            QFile stat(QStringLiteral("/proc/%1/stat").arg(p));
+            if (!stat.open(QIODevice::ReadOnly)) {
+                continue;
+            }
+            const QByteArray st = stat.readAll();
+            const int close = st.lastIndexOf(')');
+            const QByteArray comm = st.mid(st.indexOf('(') + 1, close - st.indexOf('(') - 1);
+            const QList<QByteArray> rest = st.mid(close + 2).split(' ');
+            if (comm == "pkexec" && rest.size() > 1 && QString::fromLatin1(rest.at(1)) == subject) {
+                pid = p;
+            }
+        }
+        QFile f(QStringLiteral("/proc/%1/cmdline").arg(pid));
+        if (f.open(QIODevice::ReadOnly)) {
+            for (const QByteArray &w : f.readAll().split('\0')) {
+                if (!w.isEmpty()) {
+                    words << QString::fromLocal8Bit(w);
+                }
+            }
+        }
+    }
+    // the command pkexec runs: past pkexec, its options, env with its variables and sh -c
+    if (!words.isEmpty() && QFileInfo(words.first()).fileName() == QLatin1String("pkexec")) {
+        words.removeFirst();
+        while (!words.isEmpty() && words.first().startsWith(QLatin1String("--"))) {
+            const QString opt = words.takeFirst();
+            if (opt == QLatin1String("--user") && !words.isEmpty()) {
+                words.removeFirst();
+            }
+        }
+    }
+    const QString commandLine = words.join(QLatin1Char(' '));
+    QString program;
+    for (int i = 0; i < words.size(); ++i) {
+        const QString base = QFileInfo(words.at(i)).fileName();
+        if (base == QLatin1String("env") || words.at(i).contains(QLatin1Char('=')) || words.at(i).startsWith(QLatin1Char('-'))) {
+            continue;
+        }
+        program = words.at(i);
+        // "sh script.sh" names the script
+        if ((base == QLatin1String("sh") || base == QLatin1String("bash")) && i + 1 < words.size() && !words.at(i + 1).startsWith(QLatin1Char('-'))) {
+            program = words.at(i + 1);
+        }
+        break;
+    }
+    props.insert("commandLine", commandLine);
+    props.insert("programPath", program);
+    props.insert("programName", program.isEmpty() ? QString() : QFileInfo(program).fileName());
+
