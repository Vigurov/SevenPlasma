@@ -58,6 +58,61 @@ PlasmoidItem {
         // not defining a timezone keeps it up to date with the system timezone
     }
 
+    // ---- Windows 7: additional clocks and formats from "Date and Time" / "Region and Language"
+    readonly property var win7Clocks: {
+        try {
+            return JSON.parse(Plasmoid.configuration.win7ExtraClocks || "[]").filter(c => c.show && c.zone);
+        } catch (e) {
+            return [];
+        }
+    }
+    Clock {
+        id: win7Zone0
+        timeZone: root.win7Clocks.length > 0 ? root.win7Clocks[0].zone : "Local"
+        trackSeconds: true
+    }
+    Clock {
+        id: win7Zone1
+        timeZone: root.win7Clocks.length > 1 ? root.win7Clocks[1].zone : "Local"
+        trackSeconds: true
+    }
+    /** "UTC+05:30" -> seconds */
+    function win7OffsetSecs(text) {
+        const m = /([+-])(\d{1,2})(?::?(\d{2}))?/.exec(String(text));
+        if (!m)
+            return 0;
+        return (m[1] === "-" ? -1 : 1) * (parseInt(m[2]) * 3600 + (m[3] ? parseInt(m[3]) * 60 : 0));
+    }
+    /** the time of an additional clock, as a JS date whose local fields show that zone's time */
+    function win7ZoneDate(i) {
+        const c = i === 0 ? win7Zone0 : win7Zone1;
+        const now = systemClock.dateTime;
+        const local = -now.getTimezoneOffset() * 60;
+        return new Date(now.getTime() + (win7OffsetSecs(c.timeZoneOffset) - local) * 1000);
+    }
+    readonly property string win7LongDate: Plasmoid.configuration.win7LongDate || i18nd("sevenplasma", "MMMM d, yyyy")
+    readonly property string win7LongTime: Plasmoid.configuration.win7LongTime || "H:mm:ss"
+    readonly property string win7ShortTime: Plasmoid.configuration.win7ShortTime || "H:mm"
+    function win7Format(date, pattern, isTime) {
+        const p = pattern.replace(/tt/g, "AP");
+        let s = isTime ? Qt.locale("uk_UA").toString(date, p) : Qt.locale("uk_UA").toString(date, p);
+        if (isTime && pattern.indexOf("tt") >= 0) {
+            const am = Plasmoid.configuration.win7AmSymbol, pm = Plasmoid.configuration.win7PmSymbol;
+            if (am) s = s.replace(Qt.locale("uk_UA").amText, am);
+            if (pm) s = s.replace(Qt.locale("uk_UA").pmText, pm);
+        }
+        return s;
+    }
+    P5Support.DataSource {
+        id: win7Exec
+        engine: "executable"
+        connectedSources: []
+        onNewData: (source, data) => disconnectSource(source)
+        function exec(cmd) {
+            connectSource(cmd);
+        }
+    }
+
     preferredRepresentation: fullRepresentation
     compactRepresentation: null
     fullRepresentation: smallRepresentation
