+    const int size = iconSize();
+    bool found = false;
+    for (QAction *a : m_win7Size->actions()) {
+        if (a->data().toInt() == size) {
+            a->setChecked(true);
+            found = true;
+        }
+    }
+    if (!found && m_win7Size->checkedAction()) {
+        m_win7Size->checkedAction()->setChecked(false);
+    }
+    m_win7AutoArrange->setChecked(m_sortMode->checkedAction() && sortMode() != -1);
