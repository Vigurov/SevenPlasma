@@ -0,0 +1,214 @@
+/*
+    Windows 7 On-Screen Keyboard (osk.exe) on the lock screen, measured on the real one at 1920x1080:
+    window 827x233 at (101,102), keys 38 px on a 42 px grid, rows 40 px apart, genuine key images and
+    the Basic window frame of the logon screen (images/win7osk). Types straight into the password field.
+*/
+import QtQuick
+
+Item {
+    id: osk
+
+    property var target              // the password TextField
+    property string layout: "us"     // us / ua / ru (from the language indicator)
+    signal accepted()
+    signal closed()
+
+    width: 827
+    height: 233
+    x: 101
+    y: 102
+
+    property bool shift: false
+    property bool caps: false
+    property int hovered: -1
