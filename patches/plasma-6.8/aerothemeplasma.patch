diff --git a/plasma/shells/io.gitgud.wackyideas.desktop/contents/lockscreen/Win7EaseDialog.qml b/plasma/shells/io.gitgud.wackyideas.desktop/contents/lockscreen/Win7EaseDialog.qml
new file mode 100644
index 0000000..4752672
--- /dev/null
+++ b/plasma/shells/io.gitgud.wackyideas.desktop/contents/lockscreen/Win7EaseDialog.qml
@@ -0,0 +1,138 @@
+/*
+    The "Ease of Access" window of the Windows 7 logon / lock screen (measured on the real one: 505x405 at
+    (101,102), Basic frame, six options with their icons, OK / Cancel / Apply). Only the On-Screen Keyboard
+    option does something here; the others are remembered like ticked boxes.
+*/
+import QtQuick
+
+Item {
+    id: dlg
+
+    property bool keyboardOn: false
+    signal apply(bool keyboard)
+    signal closed()
+
+    width: 505
+    height: 405
+    x: 101
+    y: 102
+
+    property var checks: [false, false, false, keyboardOn, false, false]
+    property bool dirty: false
+    onVisibleChanged: if (visible) { checks = [false, false, false, keyboardOn, false, false]; dirty = false; }
+
+    readonly property var labels: [
+        i18nd("sevenplasma", "Read the text on the screen aloud (Narrator)"),
+        i18nd("sevenplasma", "Make items on the screen larger (Magnifier)"),
+        i18nd("sevenplasma", "Make colors easier to see (High Contrast)"),
+        i18nd("sevenplasma", "Type without the keyboard (On-Screen Keyboard)"),
+        i18nd("sevenplasma", "Press keyboard shortcuts one key at a time (Sticky Keys)"),
+        i18nd("sevenplasma", "Ignore repeated keystrokes (Filter Keys)")
+    ]
+
+    BorderImage {
+        anchors.fill: parent
+        source: "../images/win7osk/frame-dialog.png"
+        border { left: 28; right: 48; top: 30; bottom: 9 }
+    }
+    Text {
+        x: 29; y: 8
+        text: i18nd("sevenplasma", "Ease of Access")
+        font.family: "Segoe UI"; font.pixelSize: 12
+        color: "#1e395b"
+    }
+    MouseArea {
+        x: 0; y: 0; width: parent.width - 48; height: 28
+        property point grab
+        onPressed: (m) => grab = Qt.point(m.x, m.y)
+        onPositionChanged: (m) => { dlg.x += m.x - grab.x; dlg.y += m.y - grab.y; }
+    }
+    MouseArea {
+        x: parent.width - 42; y: 3; width: 32; height: 20
+        onClicked: dlg.closed()
+    }
+
+    // white page and the grey button bar, like the real dialog
+    Rectangle { x: 8; y: 30; width: parent.width - 16; height: 323; color: "white" }
+    Rectangle { x: 8; y: 353; width: parent.width - 16; height: 1; color: "#dfdfdf" }
+    Rectangle { x: 8; y: 354; width: parent.width - 16; height: 42; color: "#f0f0f0" }
+
+    Text {
+        x: 30; y: 40
+        text: i18nd("sevenplasma", "Make your computer easier to use")
+        font.family: "Segoe UI"; font.pixelSize: 15
+        color: "#003399"
+    }
+    Text {
+        x: 30; y: 64
+        text: i18nd("sevenplasma", "Press the SPACEBAR to select the highlighted option.")
+        font.family: "Segoe UI"; font.pixelSize: 11
+        color: "#7f1e1e"
+    }
+
+    Repeater {
+        model: 6
+        delegate: Item {
+            x: 25; y: 88 + index * 45
+            width: 470; height: 30
+            Image { x: 0; y: 0; source: "../images/win7osk/ease-icon" + index + ".png" }
+            Image { x: 30; y: 6; source: dlg.checks[index] ? "../images/win7osk/check-on.png" : "../images/win7osk/check-off.png" }
+            Text {
+                x: 47; y: 3
+                text: dlg.labels[index]
+                font.family: "Segoe UI"; font.pixelSize: 15
+                color: "black"
+            }
+            MouseArea {
+                anchors.fill: parent
+                onClicked: {
+                    var c = dlg.checks.slice();
+                    c[index] = !c[index];
+                    dlg.checks = c;
+                    dlg.dirty = true;
+                }
+            }
+        }
+    }
+
+    component DlgButton: Item {
+        id: btn
+        property string label
+        property bool enabledButton: true
+        property bool isDefault: false     // blue frame that pulses (1 s to light blue, 1 s back), as in Windows 7
+        signal clicked()
+        width: 74; height: 22
+        readonly property bool showDefault: isDefault && enabledButton && dlg.visible
+        BorderImage {
+            anchors.fill: parent
+            source: "../images/win7osk/button.png"
+            border { left: 3; right: 3; top: 3; bottom: 3 }
+            opacity: parent.enabledButton ? 1 : 0.55
+            visible: !btn.showDefault
+        }
+        Image { visible: btn.showDefault; source: "../images/win7osk/button-default.png" }
+        Image {
+            id: pulse
+            visible: btn.showDefault
+            source: "../images/win7osk/button-defaultanim.png"
+            opacity: 0
+            SequentialAnimation on opacity {
+                running: btn.showDefault
+                loops: Animation.Infinite
+                NumberAnimation { from: 0; to: 1; duration: 1000 }
+                NumberAnimation { from: 1; to: 0; duration: 1000 }
+            }
+        }
+        Text {
+            anchors.centerIn: parent
+            text: parent.label
+            font.family: "Segoe UI"; font.pixelSize: 12
+            color: parent.enabledButton ? "black" : "#838383"
+        }
+        MouseArea { anchors.fill: parent; enabled: parent.enabledButton; onClicked: parent.clicked() }
+    }
+
+    DlgButton { x: 250; y: 365; label: "OK"; isDefault: true; onClicked: { dlg.apply(dlg.checks[3]); dlg.closed(); } }
+    DlgButton { x: 331; y: 365; label: i18nd("sevenplasma", "Cancel"); onClicked: dlg.closed() }
+    DlgButton { x: 412; y: 365; label: i18nd("sevenplasma", "Apply"); enabledButton: dlg.dirty; onClicked: { dlg.apply(dlg.checks[3]); dlg.dirty = false; } }
+}
