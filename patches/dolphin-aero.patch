+/**
+ * Windows 7 leaves the address typing mode when anything else in the window is clicked
+ */
+/**
+ * Windows 7 style paths in the address bar: the disk Linux runs from is "C:", the other disks
+ * get the letters of the Computer page; /home is shown as C:\Users (like Windows 7 shows the profiles)
+ */
+namespace Win7Paths
+{
+/** (letter like "C:", mount point) of the mounted disks, in letter order */
+static QList<QPair<QString, QString>> driveRoots()
+{
+    QList<QPair<QString, QString>> roots;
+    KFilePlacesModel *places = DolphinPlacesModelSingleton::instance().placesModel();
+    QStringList order;
+    const QHash<QString, QString> names = Win7ComputerPage::driveNames(places, &order);
+    static const QRegularExpression letterRe(QStringLiteral("\\(([A-Z]):\\)"));
+    for (const QString &udi : std::as_const(order)) {
+        const QRegularExpressionMatch m = letterRe.match(names.value(udi));
+        const Solid::Device device(udi);
+        const auto *access = device.as<Solid::StorageAccess>();
+        if (m.hasMatch() && access && access->isAccessible() && !access->filePath().isEmpty()) {
+            roots.append({m.captured(1) + QLatin1Char(':'), access->filePath()});
+        }
+    }
+    if (std::none_of(roots.cbegin(), roots.cend(), [](const auto &r) {
+            return r.second == QLatin1String("/");
+        })) {
+        roots.prepend({QStringLiteral("C:"), QStringLiteral("/")});
+    }
+    return roots;
+}
+
+/** "/home/user/Documents" -> "C:\Users\user\Documents"; anything else (URLs, ...) unchanged */
+static QString toWindows(const QString &path)
+{
+    if (!path.startsWith(QLatin1Char('/'))) {
+        return path;
+    }
+    QString best, bestLetter;
+    for (const auto &[letter, root] : driveRoots()) {
+        const bool inside = root == QLatin1String("/") || path == root || path.startsWith(root + QLatin1Char('/'));
+        if (inside && root.length() >= best.length()) {
+            best = root;
+            bestLetter = letter;
+        }
+    }
+    if (bestLetter.isEmpty()) {
+        return path;
+    }
+    QString rest = best == QLatin1String("/") ? path : path.mid(best.length());
+    if (best == QLatin1String("/") && (rest == QLatin1String("/home") || rest.startsWith(QLatin1String("/home/")))) {
+        rest = QStringLiteral("/Users") + rest.mid(5);
+    }
+    if (rest.length() > 1 && rest.endsWith(QLatin1Char('/'))) {
+        rest.chop(1);
+    }
+    if (rest.isEmpty()) {
+        rest = QStringLiteral("/");
+    }
+    return bestLetter + rest.replace(QLatin1Char('/'), QLatin1Char('\\'));
+}
+
+/** "C:\Users\user" (or "c:/users/user") -> "/home/user"; an empty string if it is not such a path */
+static QString fromWindows(const QString &text)
+{
+    static const QRegularExpression re(QStringLiteral("^\\s*([A-Za-z]):([\\\\/].*)?\\s*$"));
+    const QRegularExpressionMatch m = re.match(text);
+    if (!m.hasMatch()) {
+        return QString();
+    }
+    const QString letter = m.captured(1).toUpper() + QLatin1Char(':');
+    QString rest = m.captured(2);
+    rest.replace(QLatin1Char('\\'), QLatin1Char('/'));
+    for (const auto &[l, root] : driveRoots()) {
+        if (l != letter) {
+            continue;
+        }
+        if (root == QLatin1String("/") && (rest.compare(QLatin1String("/Users"), Qt::CaseInsensitive) == 0 || rest.startsWith(QLatin1String("/Users/"), Qt::CaseInsensitive))) {
+            rest = QStringLiteral("/home") + rest.mid(6);
+        }
+        if (rest.isEmpty()) {
+            rest = QStringLiteral("/");
+        }
+        return root == QLatin1String("/") ? rest : root + (rest == QLatin1String("/") ? QString() : rest);
+    }
+    return QString();
+}
+}
