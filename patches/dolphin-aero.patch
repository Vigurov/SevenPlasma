@@ -0,0 +1,226 @@
+/*
+ * Windows 7 Explorer style details pane.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "win7detailspane.h"
+
+#include "views/dolphinview.h"
+
+#include <KFileItem>
+#include <KIO/Global>
+#include <KLocalizedString>
+
+#include <QDir>
+#include <QFile>
+#include <QSysInfo>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QLocale>
+#include <QPainter>
+#include <QTimer>
+#include <QVBoxLayout>
+
+Win7DetailsPane::Win7DetailsPane(QWidget *parent)
+    : QWidget(parent)
+    , m_icon(new QLabel(this))
+    , m_title(new QLabel(this))
+    , m_details(new QLabel(this))
+{
+    setFixedHeight(64);
+
+    m_icon->setFixedSize(48, 48);
+    m_icon->setAlignment(Qt::AlignCenter);
+
+    m_title->setTextFormat(Qt::PlainText);
+    m_details->setTextFormat(Qt::PlainText);
+    m_title->setStyleSheet(QStringLiteral("color: #1e1e1e;"));
+    m_details->setStyleSheet(QStringLiteral("color: #5a677c;"));
+
+    auto *text = new QVBoxLayout();
+    text->setContentsMargins(0, 0, 0, 0);
+    text->setSpacing(1);
+    text->addWidget(m_title);
+    text->addWidget(m_details);
+    text->addStretch();
+
+    auto *layout = new QHBoxLayout(this);
+    layout->setContentsMargins(26, 5, 12, 6);
+    layout->setSpacing(22);
+    layout->addWidget(m_icon, 0, Qt::AlignVCenter);
+    layout->addLayout(text, 1);
+}
+
+void Win7DetailsPane::setView(DolphinView *view)
+{
+    for (const auto &c : std::as_const(m_connections)) {
+        disconnect(c);
+    }
+    m_connections.clear();
+    m_view = view;
+
+    if (view) {
+        m_connections << connect(view, &DolphinView::selectionChanged, this, &Win7DetailsPane::scheduleUpdate);
+        m_connections << connect(view, &DolphinView::itemCountChanged, this, &Win7DetailsPane::scheduleUpdate);
+        m_connections << connect(view, &DolphinView::directoryLoadingCompleted, this, &Win7DetailsPane::scheduleUpdate);
+        m_connections << connect(view, &DolphinView::urlChanged, this, &Win7DetailsPane::scheduleUpdate);
+        m_connections << connect(view, &DolphinView::fileItemsChanged, this, &Win7DetailsPane::scheduleUpdate);
+    }
+    scheduleUpdate();
+}
+
+void Win7DetailsPane::setComputerMode(bool enabled)
+{
+    if (m_computerMode != enabled) {
+        m_computerMode = enabled;
+        scheduleUpdate();
+    }
+}
+
+namespace
+{
+QString readFileValue(const QString &path, const QString &key)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return {};
+    }
+    // Files in /proc report size 0, so read everything instead of checking atEnd()
+    const QStringList lines = QString::fromUtf8(file.readAll()).split(QLatin1Char('\n'));
+    for (const QString &line : lines) {
+        const int sep = line.indexOf(QLatin1Char(line.contains(QLatin1Char(':')) ? ':' : '='));
+        if (sep > 0 && line.left(sep).trimmed().compare(key, Qt::CaseInsensitive) == 0) {
+            return line.mid(sep + 1).trimmed();
+        }
+    }
+    return {};
+}
+}
+
+void Win7DetailsPane::scheduleUpdate()
+{
+    // Coalesce bursts of signals (e.g. while a folder is loading)
+    if (m_updatePending) {
+        return;
+    }
+    m_updatePending = true;
+    QTimer::singleShot(0, this, [this]() {
+        m_updatePending = false;
+        updateContents();
+    });
+}
+
+void Win7DetailsPane::updateContents()
+{
+    if (!m_view) {
+        m_icon->clear();
+        m_title->clear();
+        m_details->clear();
+        return;
+    }
+
+    if (m_computerMode) {
+        // Like Windows 7: computer name, workgroup, processor and memory
+        m_icon->setPixmap(QIcon::fromTheme(QStringLiteral("computer")).pixmap(48, 48));
+
+        QString workgroup = readFileValue(QStringLiteral("/etc/samba/smb.conf"), QStringLiteral("workgroup"));
+        if (workgroup.isEmpty()) {
+            workgroup = QStringLiteral("WORKGROUP");
+        }
+        const QString cpu = readFileValue(QStringLiteral("/proc/cpuinfo"), QStringLiteral("model name"));
+        const QString memKb = readFileValue(QStringLiteral("/proc/meminfo"), QStringLiteral("MemTotal")).section(QLatin1Char(' '), 0, 0);
+        const double memGb = memKb.toDouble() / (1024.0 * 1024.0);
+
+        // Windows 7 layout:  NAME   Workgroup: WORKGROUP        Memory: 31,19 GB
+        //                          Processor: AMD Ryzen ...
+        const QString grey = QStringLiteral("color:#5a677c;");
+        const QString black = QStringLiteral("color:#1e1e1e;");
+        const QString memory = i18nc("@info Windows 7 details pane, %1 is an amount of RAM", "%1 GB", QLocale::system().toString(memGb, 'f', 2));
+        QString html = QStringLiteral("<table cellspacing='0' cellpadding='0'>");
+        html += QStringLiteral("<tr><td style='%1 padding-right:14px;'>%2</td>"
+                               "<td align='right' style='%3 padding-right:5px;'>%4</td><td style='%1 padding-right:40px;'>%5</td>"
+                               "<td style='%3 padding-right:5px;'>%6</td><td style='%1'>%7</td></tr>")
+        // Windows 7 shows the computer name in capitals
+                    .arg(black, QSysInfo::machineHostName().toUpper().toHtmlEscaped(), grey, i18nc("@info Windows 7 details pane", "Workgroup:").toHtmlEscaped(),
+                         workgroup.toHtmlEscaped(), i18nc("@info Windows 7 details pane", "Memory:").toHtmlEscaped(), memory.toHtmlEscaped());
+        if (!cpu.isEmpty()) {
+            html += QStringLiteral("<tr><td></td><td align='right' style='%1 padding-right:5px;'>%2</td><td colspan='3' style='%3'>%4</td></tr>")
+                        .arg(grey, i18nc("@info Windows 7 details pane", "Processor:").toHtmlEscaped(), black, cpu.toHtmlEscaped());
+        }
+        html += QStringLiteral("</table>");
+        m_title->hide();
+        m_details->setTextFormat(Qt::RichText);
+        m_details->setText(html);
+        return;
+    }
+
+    m_title->show();
+    m_details->setTextFormat(Qt::PlainText);
+    const KFileItemList selection = m_view->selectedItems();
+    const QLocale locale;
+
+    if (selection.isEmpty()) {
+        // Nothing selected: icon of the place we are in and the number of items
+        const QUrl url = m_view->url();
+        QString iconName = KIO::iconNameForUrl(url);
+        if (url.isLocalFile() && QDir(url.toLocalFile()) == QDir::home()) {
+            // "Libraries" in the navigation pane points to the home folder
+            iconName = QStringLiteral("system-file-manager");
+        }
+        m_icon->setPixmap(QIcon::fromTheme(iconName, QIcon::fromTheme(QStringLiteral("folder"))).pixmap(48, 48));
+        m_title->setText(i18nc("@info Windows 7 details pane", "Items: %1", m_view->itemsCount()));
+        m_details->clear();
+        return;
+    }
+
+    if (selection.count() == 1) {
+        const KFileItem item = selection.first();
+        m_icon->setPixmap(QIcon::fromTheme(item.iconName(), QIcon::fromTheme(QStringLiteral("unknown"))).pixmap(48, 48));
+
+        m_title->setText(item.text());
+
+        QStringList lines;
+        lines << item.mimeComment();
+        const QDateTime modified = item.time(KFileItem::ModificationTime);
+        QString second;
+        if (modified.isValid()) {
+            second = i18nc("@info Windows 7 details pane", "Date modified: %1", locale.toString(modified, QLocale::ShortFormat));
+        }
+        if (!item.isDir()) {
+            const QString size = i18nc("@info Windows 7 details pane", "Size: %1", KIO::convertSize(item.size()));
+            second = second.isEmpty() ? size : second + QStringLiteral("    ") + size;
+        }
+        if (!second.isEmpty()) {
+            lines << second;
+        }
+        m_details->setText(lines.join(QLatin1Char('\n')));
+        return;
+    }
+
+    // Several items selected
+    KIO::filesize_t total = 0;
+    bool onlyDirs = true;
+    for (const KFileItem &item : selection) {
+        if (!item.isDir()) {
+            total += item.size();
+            onlyDirs = false;
+        }
+    }
+    m_icon->setPixmap(QIcon::fromTheme(selection.first().iconName(), QIcon::fromTheme(QStringLiteral("unknown"))).pixmap(48, 48));
+    m_title->setText(i18nc("@info Windows 7 details pane", "%1 items selected", selection.count()));
+    m_details->setText(onlyDirs ? QString() : i18nc("@info Windows 7 details pane", "Size: %1", KIO::convertSize(total)));
+}
+
+void Win7DetailsPane::paintEvent(QPaintEvent *)
+{
+    // Light blue background with a thin line on top, as in Windows 7
+    QPainter p(this);
+    p.fillRect(rect(), QColor(0xf1, 0xf5, 0xfb));
+    p.setPen(QColor(0xe2, 0xe4, 0xec));
+    p.drawLine(0, 0, width(), 0);
+    p.setPen(QColor(0xf8, 0xfa, 0xfd));
+    p.drawLine(0, 1, width(), 1);
+}
+
+#include "moc_win7detailspane.cpp"
