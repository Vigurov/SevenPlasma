+/** Windows 7 "Start Navigation" click: Explorer played it whenever a folder was opened (scheme sound,
+ *  ~/.config/seven-soundsrc [Explorer] Navigation= overrides it, an empty value turns it off) */
+static void playNavigationSound()
+{
+    static QElapsedTimer last;
+    if (last.isValid() && last.elapsed() < 250) {
+        return;
+    }
+    last.start();
+    QSettings own(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QStringLiteral("/seven-soundsrc"), QSettings::IniFormat);
+    QString file;
+    if (own.contains(QStringLiteral("Explorer/Navigation"))) {
+        file = own.value(QStringLiteral("Explorer/Navigation")).toString();
+    } else {
+        const QString theme = KConfigGroup(KSharedConfig::openConfig(QStringLiteral("kdeglobals")), QStringLiteral("Sounds")).readEntry("Theme", QString());
+        if (!theme.isEmpty()) {
+            for (const QString &dir : QStandardPaths::locateAll(QStandardPaths::GenericDataLocation, QStringLiteral("sounds/") + theme, QStandardPaths::LocateDirectory)) {
+                const QString f = dir + QStringLiteral("/og/Windows Navigation Start.wav");
+                if (QFile::exists(f)) {
+                    file = f;
+                    break;
+                }
+            }
+        }
+    }
+    if (!file.isEmpty() && QFile::exists(file)) {
+        QProcess::startDetached(QStringLiteral("paplay"), {QStringLiteral("--property=media.role=event"), file});
+    }
+}
