+// Windows 7 names the folders of the user profile in Explorer's own words (desktop.ini), the same
+// names as the address bar (KIO's Win7KnownFolders); an empty string for other folders
+static QString win7KnownFolderName(const QUrl &url)
+{
+    if (!url.isLocalFile()) {
+        return {};
+    }
+    const QString path = QDir::cleanPath(url.toLocalFile());
+    const QString home = QDir::cleanPath(QDir::homePath());
+    if (path == home) {
+        const KUser user;
+        const QString full = user.property(KUser::FullName).toString();
+        return full.isEmpty() ? user.loginName() : full;
+    }
+    static const struct {
+        QStandardPaths::StandardLocation location;
+        const char *name;
+    } known[] = {
+        {QStandardPaths::DesktopLocation, "Desktop"},
+        {QStandardPaths::DownloadLocation, "Downloads"},
+        {QStandardPaths::DocumentsLocation, "Documents"},
+        {QStandardPaths::MusicLocation, "Music"},
+        {QStandardPaths::PicturesLocation, "Pictures"},
+        {QStandardPaths::MoviesLocation, "Videos"},
+    };
+    for (const auto &k : known) {
+        const QString dir = QStandardPaths::writableLocation(k.location);
+        if (!dir.isEmpty() && QDir::cleanPath(dir) == path && path != home) {
+            return i18nd("sevenplasma", k.name);
+        }
+    }
+    return {};
+}
