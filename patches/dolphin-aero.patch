+/*
+ * Windows 7 Explorer style details pane (bottom of the window):
+ * big icon of the current folder / selection and "Items: N".
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef WIN7DETAILSPANE_H
+#define WIN7DETAILSPANE_H
+
+#include <QPointer>
+#include <QWidget>
+
+class DolphinView;
+class QLabel;
+
+class Win7DetailsPane : public QWidget
+{
+    Q_OBJECT
+
+public:
+    explicit Win7DetailsPane(QWidget *parent = nullptr);
+
+    void setView(DolphinView *view);
+    /** Show information about this computer (Windows 7 "Computer" page) */
+    void setComputerMode(bool enabled);
