+#include <Solid/Device>
+#include <Solid/StorageVolume>
+#include <KIO/UDSEntry>
+
+#include <QCollator>
+#include <QDir>
+#include <functional>
+#include <memory>
+#include <QHeaderView>
+#include <QMenu>
+#include <QApplication>
+#include <QClipboard>
+#include <QInputDialog>
+#include <QMimeData>
+#include <QMouseEvent>
+#include <QPainter>
+#include <QStandardItemModel>
+#include <QStandardPaths>
+
+namespace
+{
+enum Roles {
+    UrlRole = Qt::UserRole + 1,
+    UdiRole,
+    LazyRole, // children (subfolders) are listed when the item is expanded
+    LoadedRole,
+    FavoriteRole, // a link under Favorites (can be removed or renamed)
+};
+
+QUrl localUrl(QStandardPaths::StandardLocation location)
+{
+    return QUrl::fromLocalFile(QStandardPaths::writableLocation(location));
+}
+
+QUrl normalized(const QUrl &url)
+{
+    return url.adjusted(QUrl::StripTrailingSlash | QUrl::NormalizePathSegments);
+}
+
+struct Favorite {
+    QString name;
+    QString icon;
+    QUrl url;
+};
+
+// same order as Windows 7: Desktop, Downloads, Recent Places
+QList<Favorite> defaultFavorites()
+{
+    return {{i18nd("sevenplasma", "Desktop"), QStringLiteral("desktop"), localUrl(QStandardPaths::DesktopLocation)},
+            {i18nd("sevenplasma", "Downloads"), QStringLiteral("folder-downloads"), localUrl(QStandardPaths::DownloadLocation)},
+            {i18nd("sevenplasma", "Recent Places"), QStringLiteral("folder-recent"), QUrl(QStringLiteral("recentlyused:/locations/"))}};
+}
+
+QList<Favorite> loadFavorites()
+{
+    const KConfigGroup g(KSharedConfig::openConfig(QStringLiteral("dolphinrc")), QStringLiteral("Win7Favorites"));
+    if (!g.hasKey("Items")) {
+        return defaultFavorites();
+    }
+    QList<Favorite> out;
+    for (const QString &line : g.readEntry("Items", QStringList())) {
+        const QStringList f = line.split(QLatin1Char('\t'));
+        if (f.size() == 3) {
+            out.append({f.at(0), f.at(1), QUrl(f.at(2))});
+        }
+    }
+    return out;
+}
+
+}
+
+/** Windows 7 places the icon 8 px into the row and the name 19 px after it (21 for the top level) */
+class Win7NavDelegate : public QStyledItemDelegate
+{
+public:
+    using QStyledItemDelegate::QStyledItemDelegate;
+    void paint(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        const QIcon icon = index.data(Qt::DecorationRole).value<QIcon>();
+        const QString text = index.data(Qt::DisplayRole).toString();
+        if (text.isEmpty() && icon.isNull()) {
+            return;
+        }
+        const QRect r = option.rect;
+        const int ix = r.left() + 6;
+        const int iy = r.top() + (r.height() - 16) / 2;
+        const bool enabled = index.flags() & Qt::ItemIsEnabled;
+        if (!icon.isNull()) {
+            painter->drawPixmap(ix, iy, icon.pixmap(QSize(16, 16), enabled ? QIcon::Normal : QIcon::Disabled));
+        }
+        const int tx = ix + (index.parent().isValid() ? 19 : 21);
+        QFont f = option.font;
+        const QVariant fv = index.data(Qt::FontRole);
+        if (fv.isValid()) {
+            f = fv.value<QFont>();
+        }
+        painter->save();
+        painter->setFont(f);
+        painter->setPen(enabled ? QColor(Qt::black) : QColor(0x6d, 0x6d, 0x6d));
+        const QRect tr(tx, r.top(), r.right() - tx - 2, r.height());
+        painter->drawText(tr, Qt::AlignVCenter | Qt::AlignLeft, QFontMetrics(f).elidedText(text, Qt::ElideRight, tr.width()));
+        painter->restore();
+    }
+};
+
+Win7NavigationPane::Win7NavigationPane(QWidget *parent)
+    : QTreeView(parent)
+    , m_model(new QStandardItemModel(this))
+    , m_places(new KFilePlacesModel(this))
+{
+    setModel(m_model);
+    setHeaderHidden(true);
+    setFrameShape(QFrame::NoFrame);
+    setIndentation(12); // measured on Windows 7: children 12 px further right
+    setIconSize(QSize(16, 16));
+    setUniformRowHeights(false);
+    setAnimated(false); // Windows 7 expands/collapses instantly
+    setMouseTracking(true);
+    setEditTriggers(QAbstractItemView::NoEditTriggers);
+    setSelectionMode(QAbstractItemView::SingleSelection);
+    setExpandsOnDoubleClick(false);
+    setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    setContextMenuPolicy(Qt::CustomContextMenu);
+    setMinimumWidth(120);
+    setItemDelegate(new Win7NavDelegate(this));
+
+    auto *favorites = addGroup(i18nc("@item Windows 7 navigation pane", "Favorites"), QStringLiteral("favorites"), localUrl(QStandardPaths::DesktopLocation));
+    m_favorites = favorites;
+    rebuildFavorites();
+    addSpacer();
+
+    auto *libraries = addGroup(i18nc("@item Windows 7 navigation pane", "Libraries"), QStringLiteral("folder-library"), QUrl::fromLocalFile(QDir::homePath()));
+    makeLazy(addChild(libraries, i18nc("@item Windows 7 navigation pane", "Videos"), QStringLiteral("library-video"), localUrl(QStandardPaths::MoviesLocation)));
+    makeLazy(addChild(libraries, i18nc("@item Windows 7 navigation pane", "Documents"), QStringLiteral("library-txt"), localUrl(QStandardPaths::DocumentsLocation)));
+    makeLazy(addChild(libraries, i18nc("@item Windows 7 navigation pane", "Pictures"), QStringLiteral("library-images"), localUrl(QStandardPaths::PicturesLocation)));
+    makeLazy(addChild(libraries, i18nc("@item Windows 7 navigation pane", "Music"), QStringLiteral("library-music"), localUrl(QStandardPaths::MusicLocation)));
+    addSpacer();
+
+    makeLazy(addGroup(i18nc("@item Windows 7 navigation pane", "Homegroup"), QStringLiteral("seven-homegroup"), QUrl(QStringLiteral("smb:/"))));
+    addSpacer();
+
+    m_computer = addGroup(i18nc("@item Windows 7 navigation pane", "Computer"), QStringLiteral("computer"), Win7ComputerPage::computerUrl());
+    addSpacer();
+
+    makeLazy(addGroup(i18nc("@item Windows 7 navigation pane", "Network"), QStringLiteral("gnome-fs-network"), QUrl(QStringLiteral("remote:/"))));
+
+    rebuildDevices();
+    connect(m_places, &QAbstractItemModel::rowsInserted, this, &Win7NavigationPane::rebuildDevices);
+    connect(m_places, &QAbstractItemModel::rowsRemoved, this, &Win7NavigationPane::rebuildDevices);
+    connect(m_places, &QAbstractItemModel::dataChanged, this, &Win7NavigationPane::rebuildDevices);
+    connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceAdded, this, &Win7NavigationPane::rebuildDevices);
+    connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceRemoved, this, &Win7NavigationPane::rebuildDevices);
+    connect(m_places, &KFilePlacesModel::errorMessage, this, &Win7NavigationPane::errorMessage);
+    connect(this, &QTreeView::expanded, this, &Win7NavigationPane::loadChildren);
+
+    // Favorites and Libraries are expanded by default, like in Windows 7
+    expand(favorites->index());
+    expand(libraries->index());
+
+    connect(this, &QWidget::customContextMenuRequested, this, &Win7NavigationPane::showContextMenu);
+
+    updateStyleSheet(false);
+}
