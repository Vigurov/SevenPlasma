+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "win7previewpane.h"
+
+#include <KIO/PreviewJob>
+#include <KLocalizedString>
+
+#include <QFile>
+#include <QImageReader>
+#include <QLabel>
+#include <QMimeDatabase>
+#include <QPainter>
+#include <QPlainTextEdit>
+#include <QStackedWidget>
+#include <QVBoxLayout>
+
+Win7PreviewPane::Win7PreviewPane(QWidget *parent)
+    : QWidget(parent)
+    , m_stack(new QStackedWidget(this))
+    , m_message(new QLabel(this))
+    , m_picture(new QLabel(this))
+    , m_text(new QPlainTextEdit(this))
+{
+    setMinimumWidth(120);
+    auto *layout = new QVBoxLayout(this);
+    // room for the light line on the left (painted)
+    layout->setContentsMargins(1, 0, 0, 0);
+    layout->addWidget(m_stack);
+
+    // Windows 7: grey text in the middle of a white pane
+    m_message->setAlignment(Qt::AlignCenter);
+    m_message->setWordWrap(true);
+    m_message->setStyleSheet(QStringLiteral("QLabel { color: #6d6d6d; background: transparent; padding: 8px; }"));
+    m_picture->setAlignment(Qt::AlignCenter);
+    m_picture->setStyleSheet(QStringLiteral("QLabel { background: transparent; }"));
+    m_text->setReadOnly(true);
+    m_text->setFrameShape(QFrame::NoFrame);
+    m_text->setStyleSheet(QStringLiteral("QPlainTextEdit { background: white; color: black; border: none; }"));
+    m_stack->addWidget(m_message);
+    m_stack->addWidget(m_picture);
+    m_stack->addWidget(m_text);
+
+    QPalette pal = palette();
+    pal.setColor(QPalette::Window, Qt::white);
+    setPalette(pal);
+    setAutoFillBackground(true);
+
+    showMessage(i18nc("@info Windows 7 preview pane", "Select a file to preview."));
+}
+
+void Win7PreviewPane::setUrl(const QUrl &url)
+{
+    Q_UNUSED(url)
+    setSelection({});
+}
+
+void Win7PreviewPane::setSelection(const KFileItemList &selection)
+{
+    if (selection.count() != 1) {
+        m_item = KFileItem();
+        if (m_job) {
+            m_job->kill();
+        }
+        showMessage(i18nc("@info Windows 7 preview pane", "Select a file to preview."));
+        return;
+    }
+    if (selection.first() == m_item && !m_item.isNull()) {
+        return;
+    }
+    m_item = selection.first();
+    showItem(m_item);
+}
+
+void Win7PreviewPane::showMessage(const QString &text)
+{
+    m_image = QImage();
+    m_message->setText(text);
+    m_stack->setCurrentWidget(m_message);
+}
+
+void Win7PreviewPane::showItem(const KFileItem &item)
+{
+    if (m_job) {
+        m_job->kill();
+    }
+    const QString noPreview = i18nc("@info Windows 7 preview pane", "No preview available.");
+    if (item.isDir()) {
+        showMessage(noPreview);
+        return;
+    }
+    const QMimeType mime = QMimeDatabase().mimeTypeForName(item.mimetype());
+    // Pictures: the picture itself
+    if (item.isLocalFile() && mime.name().startsWith(QLatin1String("image/"))) {
+        QImageReader reader(item.localPath());
+        reader.setAutoTransform(true);
+        const QImage image = reader.read();
+        if (!image.isNull()) {
+            showImage(image);
+            return;
+        }
+    }
+    // Plain text: the text
+    if (item.isLocalFile() && (mime.inherits(QStringLiteral("text/plain")) || mime.name().startsWith(QLatin1String("text/")))) {
+        QFile file(item.localPath());
+        if (file.open(QIODevice::ReadOnly)) {
+            m_text->setPlainText(QString::fromUtf8(file.read(256 * 1024)));
+            m_text->moveCursor(QTextCursor::Start);
+            m_image = QImage();
+            m_stack->setCurrentWidget(m_text);
+            return;
+        }
+    }
+    // Everything else: a preview if there is a previewer for it (videos, documents ...)
+    showMessage(QString());
+    const KFileItem wanted = item;
+    m_job = KIO::filePreview(KFileItemList{item}, QSize(512, 512));
+    m_job->setScaleType(KIO::PreviewJob::Unscaled);
+    connect(m_job, &KIO::PreviewJob::gotPreview, this, [this, wanted](const KFileItem &got, const QPixmap &pixmap) {
+        if (got == wanted && wanted == m_item) {
+            showImage(pixmap.toImage());
+        }
+    });
+    connect(m_job, &KIO::PreviewJob::failed, this, [this, wanted, noPreview](const KFileItem &got) {
+        if (got == wanted && wanted == m_item) {
+            showMessage(noPreview);
+        }
+    });
+}
+
+void Win7PreviewPane::showImage(const QImage &image)
+{
+    m_image = image;
+    m_stack->setCurrentWidget(m_picture);
+    updatePixmap();
+}
+
+void Win7PreviewPane::updatePixmap()
+{
+    if (m_image.isNull()) {
+        return;
+    }
+    // fit into the pane with a small margin, never enlarged
+    const QSize room = m_stack->size() - QSize(16, 16);
+    QImage scaled = m_image;
+    if (m_image.width() > room.width() || m_image.height() > room.height()) {
+        scaled = m_image.scaled(room * devicePixelRatioF(), Qt::KeepAspectRatio, Qt::SmoothTransformation);
+        scaled.setDevicePixelRatio(devicePixelRatioF());
+    }
+    m_picture->setPixmap(QPixmap::fromImage(scaled));
+}
+
+void Win7PreviewPane::paintEvent(QPaintEvent *event)
+{
+    QWidget::paintEvent(event);
+    // Windows 7: a light blue line between the file list and the pane
+    QPainter p(this);
+    p.fillRect(QRect(0, 0, 1, height()), QColor(0xd6, 0xe5, 0xf5));
+}
+
+void Win7PreviewPane::resizeEvent(QResizeEvent *event)
+{
+    QWidget::resizeEvent(event);
+    updatePixmap();
+}
+
+#include "moc_win7previewpane.cpp"
