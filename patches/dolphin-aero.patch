+class Win7AddressEditExit : public QObject
+{
+public:
+    explicit Win7AddressEditExit(KUrlNavigator *navigator)
+        : QObject(navigator)
+        , m_navigator(navigator)
+    {
+        qApp->installEventFilter(this);
+    }
+
+protected:
+    bool eventFilter(QObject *obj, QEvent *event) override
+    {
+        if ((event->type() == QEvent::KeyPress || event->type() == QEvent::ShortcutOverride) && m_navigator->isUrlEditable()) {
+            const int key = static_cast<QKeyEvent *>(event)->key();
+            QLineEdit *edit = m_navigator->editor() ? m_navigator->editor()->lineEdit() : nullptr;
+            if (edit && (obj == edit || obj == m_navigator->editor()) && (key == Qt::Key_Return || key == Qt::Key_Enter)) {
+                // a Windows path ("C:\Users\...") goes back to the real one before the navigator reads it
+                const QString local = Win7Paths::fromWindows(edit->text());
+                if (!local.isEmpty()) {
+                    edit->setText(local);
+                }
+            }
+        }
+        if (event->type() == QEvent::MouseButtonPress && m_navigator->isUrlEditable()) {
+            auto *w = qobject_cast<QWidget *>(obj);
+            if (w && w->window() == m_navigator->window() && w != m_navigator && !m_navigator->isAncestorOf(w)) {
+                QTimer::singleShot(0, m_navigator, [nav = m_navigator]() {
+                    nav->setUrlEditable(false);
+                });
+            }
+        }
+        return false;
+    }
+
+private:
+    KUrlNavigator *m_navigator;
+};
