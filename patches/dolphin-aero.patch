@@ -0,0 +1,1014 @@
+/*
+ * Windows 7 Explorer style "Computer" page.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "win7computerpage.h"
+
+#include <KFilePlacesModel>
+#include <KIO/Global>
+#include <KLocalizedString>
+#include <Solid/Device>
+#include <Solid/DeviceNotifier>
+#include <Solid/OpticalDrive>
+#include <Solid/StorageAccess>
+#include <Solid/StorageDrive>
+#include <Solid/StorageVolume>
+
+#include "win7viewmodemenu.h"
+
+#include <KPropertiesDialog>
+
+#include <QActionGroup>
+#include <QApplication>
+#include <QClipboard>
+#include <QContextMenuEvent>
+#include <QDir>
+#include <QMenu>
+#include <QMimeData>
+#include <QMouseEvent>
+#include <QProcess>
+#include <QStandardPaths>
+#include <QPainter>
+#include <QPainterPath>
+#include <QStorageInfo>
+#include <QUrlQuery>
+
+namespace
+{
+enum Group {
+    HardDisks = 0,
+    Removable,
+    Portable,
+    GroupCount,
+};
+
+struct Drive {
+    QString name;
+    QString iconName;
+    QUrl url; // empty when not mounted
+    qint64 total = 0;
+    qint64 free = -1; // -1 = unknown (not mounted)
+    bool isProtected = false; // internal / NTFS drive that must not be mounted from here
+    bool emptyOptical = false; // a CD/DVD drive without a disc
+    int group = HardDisks;
+    QString udi;
+    QRect rect;
+};
+
+/** Windows 7 names an optical drive after what it can do: "CD-дисковод", "Дисковод DVD RW", "Дисковод BD-RE" */
+QString opticalDriveName(const Solid::Device &driveDevice, const QString &letter)
+{
+    const auto *od = driveDevice.as<Solid::OpticalDrive>();
+    const auto m = od ? od->supportedMedia() : Solid::OpticalDrive::MediumTypes();
+    if (m & (Solid::OpticalDrive::Bdre | Solid::OpticalDrive::Bdr)) {
+        return i18nd("sevenplasma", "BD-RE Drive (%1)").arg(letter);
+    }
+    if (m & Solid::OpticalDrive::Bd) {
+        return i18nd("sevenplasma", "BD-ROM Drive (%1)").arg(letter);
+    }
+    if (m & (Solid::OpticalDrive::Dvdrw | Solid::OpticalDrive::Dvdplusrw | Solid::OpticalDrive::Dvdr | Solid::OpticalDrive::Dvdplusr)) {
+        return i18nd("sevenplasma", "DVD RW Drive (%1)").arg(letter);
+    }
+    if (m & Solid::OpticalDrive::Dvd) {
+        return i18nd("sevenplasma", "DVD Drive (%1)").arg(letter);
+    }
+    return i18nc("@item Windows 7 drive name, %1 is a drive letter like E:", "CD Drive (%1)", letter);
+}
+
+}
+
+/** optical drives that have no disc (no volume in the places model) */
+QList<Solid::Device> Win7ComputerPage::emptyOpticalDrives(KFilePlacesModel *places)
+{
+    QSet<QString> withMedia;
+    for (int row = 0; row < places->rowCount(); ++row) {
+        const QModelIndex idx = places->index(row, 0);
+        if (!places->isDevice(idx)) {
+            continue;
+        }
+        for (Solid::Device p = places->deviceForIndex(idx); p.isValid(); p = p.parent()) {
+            if (p.is<Solid::OpticalDrive>()) {
+                withMedia.insert(p.udi());
+                break;
+            }
+        }
+    }
+    QList<Solid::Device> out;
+    for (const Solid::Device &d : Solid::Device::listFromType(Solid::DeviceInterface::OpticalDrive)) {
+        if (!withMedia.contains(d.udi())) {
+            out << d;
+        }
+    }
+    return out;
+}
+
+namespace
+{
+constexpr int kTileWidth = 270;
+constexpr int kTileHeight = 58;
+constexpr int kHeaderHeight = 30;
+constexpr int kMarginLeft = 12;
+}
+
+class Win7ComputerCanvas : public QWidget
+{
+public:
+    explicit Win7ComputerCanvas(Win7ComputerPage *page)
+        : QWidget(page)
+        , m_page(page)
+        , m_places(new KFilePlacesModel(this))
+    {
+        setMouseTracking(true);
+        setFocusPolicy(Qt::StrongFocus);
+        QObject::connect(m_places, &QAbstractItemModel::rowsInserted, this, [this]() {
+            reload();
+        });
+        QObject::connect(m_places, &QAbstractItemModel::rowsRemoved, this, [this]() {
+            reload();
+        });
+        QObject::connect(m_places, &QAbstractItemModel::dataChanged, this, [this]() {
+            reload();
+        });
+        // an external CD/DVD drive plugged in or out (empty drives are not in the places model)
+        QObject::connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceAdded, this, [this]() {
+            reload();
+        });
+        QObject::connect(Solid::DeviceNotifier::instance(), &Solid::DeviceNotifier::deviceRemoved, this, [this]() {
+            reload();
+        });
+        for (bool &c : m_collapsed) {
+            c = false;
+        }
+    }
+
+    void reload()
+    {
+        m_drives.clear();
+        QStringList order;
+        const QHash<QString, QString> names = Win7ComputerPage::driveNames(m_places, &order);
+        for (int row = 0; row < m_places->rowCount(); ++row) {
+            const QModelIndex idx = m_places->index(row, 0);
+            if (!m_places->isDevice(idx) || m_places->isHidden(idx)) {
+                continue;
+            }
+            const Solid::Device device = m_places->deviceForIndex(idx);
+            Drive d;
+            d.name = names.value(device.udi(), m_places->text(idx));
+            d.udi = device.udi();
+            d.url = m_places->url(idx);
+
+            const auto *access = device.as<Solid::StorageAccess>();
+            const auto *volume = device.as<Solid::StorageVolume>();
+            if (!access) {
+                // Phones, cameras, media players (MTP, ...)
+                d.group = Portable;
+                d.iconName = device.icon().isEmpty() ? QStringLiteral("multimedia-player") : device.icon();
+            } else {
+                Solid::StorageDrive *drive = nullptr;
+                for (Solid::Device p = device.parent(); p.isValid(); p = p.parent()) {
+                    if (p.is<Solid::StorageDrive>()) {
+                        drive = p.as<Solid::StorageDrive>();
+                        break;
+                    }
+                }
+                const bool isSystemDrive = access->isAccessible() && access->filePath() == QLatin1String("/");
+                const bool removableMedia = drive && (drive->isRemovable() || drive->driveType() != Solid::StorageDrive::HardDisk);
+                // The drive Linux runs from is always shown as a hard disk (like "C:" in Windows 7)
+                d.group = (removableMedia && !isSystemDrive) ? Removable : HardDisks;
+
+                const bool ntfs = volume && volume->fsType().startsWith(QLatin1String("ntfs"));
+                d.isProtected = ntfs || (d.group == HardDisks && !isSystemDrive && !(drive && drive->isHotpluggable()));
+
+                if (access->isAccessible() && !access->filePath().isEmpty()) {
+                    d.url = QUrl::fromLocalFile(access->filePath());
+                    const QStorageInfo info(access->filePath());
+                    d.total = info.bytesTotal();
+                    d.free = info.bytesAvailable();
+                    if (access->filePath() == QLatin1String("/")) {
+                        d.iconName = QStringLiteral("drive-harddisk-system");
+                    }
+                } else {
+                    d.url = QUrl();
+                    d.total = volume ? qint64(volume->size()) : 0;
+                }
+                if (d.iconName.isEmpty()) {
+                    d.iconName = d.group == Removable ? QStringLiteral("drive-removable-media") : QStringLiteral("drive-harddisk");
+                    if (!device.icon().isEmpty() && d.group == Removable) {
+                        d.iconName = device.icon();
+                    }
+                }
+            }
+            m_drives.append(d);
+        }
+        // empty CD/DVD drives are listed too, like in Windows 7
+        for (const Solid::Device &od : Win7ComputerPage::emptyOpticalDrives(m_places)) {
+            Drive d;
+            d.udi = od.udi();
+            d.name = names.value(od.udi(), od.description());
+            d.group = Removable;
+            d.emptyOptical = true;
+            d.iconName = QIcon::hasThemeIcon(QStringLiteral("seven-bk-dvd")) ? QStringLiteral("seven-bk-dvd") : QStringLiteral("drive-optical");
+            m_drives.append(d);
+        }
+        // Same order as the drive letters (C: first)
+        std::stable_sort(m_drives.begin(), m_drives.end(), [&order](const Drive &a, const Drive &b) {
+            return order.indexOf(a.udi) < order.indexOf(b.udi);
+        });
+        if (m_selected >= m_drives.count()) {
+            m_selected = -1;
+        }
+        relayout();
+        update();
+    }
+
+    QSize sizeHint() const override
+    {
+        return QSize(600, m_contentHeight);
+    }
+
+    int viewRow() const
+    {
+        return m_view;
+    }
+
+    void setViewRow(int row)
+    {
+        m_view = qBound(0, row, int(Win7ViewModeMenu::RowCount) - 1);
+        relayout();
+        update();
+    }
+
+protected:
+    void resizeEvent(QResizeEvent *event) override
+    {
+        QWidget::resizeEvent(event);
+        relayout();
+    }
+
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.fillRect(rect(), Qt::white);
+
+        if (m_view == Win7ViewModeMenu::Details) {
+            paintColumnHeader(p);
+        }
+        for (int g = 0; g < GroupCount; ++g) {
+            if (!m_headerRects[g].isValid()) {
+                continue;
+            }
+            paintHeader(p, g);
+        }
+        for (int i = 0; i < m_drives.count(); ++i) {
+            const Drive &d = m_drives.at(i);
+            if (!d.rect.isValid() || isCollapsed(d)) {
+                continue;
+            }
+            paintItem(p, d, i == m_hovered, i == m_selected);
+        }
+    }
+
+    void mouseMoveEvent(QMouseEvent *event) override
+    {
+        const int hit = driveAt(event->pos());
+        int header = -1;
+        for (int g = 0; g < GroupCount; ++g) {
+            if (m_headerRects[g].contains(event->pos())) {
+                header = g;
+            }
+        }
+        if (hit != m_hovered || header != m_hoveredHeader) {
+            m_hovered = hit;
+            m_hoveredHeader = header;
+            update();
+        }
+    }
+
+    void leaveEvent(QEvent *) override
+    {
+        m_hovered = -1;
+        m_hoveredHeader = -1;
+        update();
+    }
+
+    void mousePressEvent(QMouseEvent *event) override
+    {
+        setFocus();
+        for (int g = 0; g < GroupCount; ++g) {
+            if (m_headerRects[g].contains(event->pos())) {
+                m_collapsed[g] = !m_collapsed[g];
+                relayout();
+                update();
+                return;
+            }
+        }
+        m_selected = driveAt(event->pos());
+        update();
+        if (m_selected >= 0 && event->button() == Qt::MiddleButton) {
+            open(m_selected, true);
+        }
+    }
+
+    void mouseDoubleClickEvent(QMouseEvent *event) override
+    {
+        const int hit = driveAt(event->pos());
+        if (hit >= 0 && event->button() == Qt::LeftButton) {
+            open(hit, false);
+        }
+    }
+
+    void keyPressEvent(QKeyEvent *event) override
+    {
+        if ((event->key() == Qt::Key_Return || event->key() == Qt::Key_Enter) && m_selected >= 0) {
+            open(m_selected, false);
+            return;
+        }
+        QWidget::keyPressEvent(event);
+    }
+
+private:
+    void open(int index, bool newTab)
+    {
+        const Drive &d = m_drives.at(index);
+        if (d.url.isValid() && !d.url.isEmpty()) {
+            if (newTab) {
+                Q_EMIT m_page->openUrlInNewTabRequested(d.url);
+            } else {
+                Q_EMIT m_page->openUrlRequested(d.url);
+            }
+            return;
+        }
+        if (d.emptyOptical) {
+            Q_EMIT m_page->errorMessage(i18nd("sevenplasma", "Please insert a disc into drive \"%1\".").arg(d.name));
+            return;
+        }
+        if (d.isProtected) {
+            Q_EMIT m_page->errorMessage(
+                i18nc("@info", "The drive \"%1\" is not connected to Linux. It is not mounted automatically to keep its data safe.", d.name));
+            return;
+        }
+        // Unmounted removable drive: mount it, then open it
+        for (int row = 0; row < m_places->rowCount(); ++row) {
+            const QModelIndex idx = m_places->index(row, 0);
+            if (m_places->isDevice(idx) && m_places->deviceForIndex(idx).udi() == d.udi && m_places->setupNeeded(idx)) {
+                auto conn = std::make_shared<QMetaObject::Connection>();
+                *conn = QObject::connect(m_places, &KFilePlacesModel::setupDone, this, [this, conn, newTab](const QModelIndex &done, bool success) {
+                    QObject::disconnect(*conn);
+                    if (success) {
+                        if (newTab) {
+                            Q_EMIT m_page->openUrlInNewTabRequested(m_places->url(done));
+                        } else {
+                            Q_EMIT m_page->openUrlRequested(m_places->url(done));
+                        }
+                    }
+                });
+                m_places->requestSetup(idx);
+                return;
+            }
+        }
+    }
+
+    int driveAt(const QPoint &pos) const
+    {
+        for (int i = 0; i < m_drives.count(); ++i) {
+            if (!isCollapsed(m_drives.at(i)) && m_drives.at(i).rect.isValid() && m_drives.at(i).rect.contains(pos)) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    QString groupTitle(int group, int count) const
+    {
+        switch (group) {
+        case HardDisks:
+            return i18nc("@title Windows 7 computer page, %1 is a number", "Hard Disk Drives (%1)", count);
+        case Removable:
+            return i18nc("@title Windows 7 computer page, %1 is a number", "Devices with Removable Storage (%1)", count);
+        default:
+            return i18nc("@title Windows 7 computer page, %1 is a number", "Portable Devices (%1)", count);
+        }
+    }
+
+    bool isCollapsed(const Drive &d) const
+    {
+        return m_grouped && m_collapsed[d.group];
+    }
+
+    /** Cell size of one item in the current view */
+    QSize cellSize() const
+    {
+        switch (m_view) {
+        case Win7ViewModeMenu::ExtraLargeIcons:
+            return QSize(180, 128 + 40);
+        case Win7ViewModeMenu::LargeIcons:
+            return QSize(130, 96 + 40);
+        case Win7ViewModeMenu::MediumIcons:
+            return QSize(96, 48 + 40);
+        case Win7ViewModeMenu::SmallIcons:
+        case Win7ViewModeMenu::List:
+            return QSize(230, 22);
+        case Win7ViewModeMenu::Details:
+            return QSize(qMax(300, width() - kMarginLeft * 2 - 8), 22);
+        default: // Tiles, Content
+            return QSize(kTileWidth - 10, kTileHeight);
+        }
+    }
+
+    QList<int> sortedMembers(int group) const
+    {
+        QList<int> members;
+        for (int i = 0; i < m_drives.count(); ++i) {
+            if (group < 0 || m_drives.at(i).group == group) {
+                members.append(i);
+            }
+        }
+        if (m_sortKey >= 0) {
+            std::stable_sort(members.begin(), members.end(), [this](int a, int b) {
+                const Drive &x = m_drives.at(a);
+                const Drive &y = m_drives.at(b);
+                bool less = false;
+                switch (m_sortKey) {
+                case 0:
+                    less = QString::localeAwareCompare(x.name, y.name) < 0;
+                    break;
+                case 1:
+                    less = x.group < y.group;
+                    break;
+                case 2:
+                    less = x.total < y.total;
+                    break;
+                default:
+                    less = x.free < y.free;
+                    break;
+                }
+                return less;
+            });
+            if (m_desc) {
+                std::reverse(members.begin(), members.end());
+            }
+        }
+        return members;
+    }
+
+    void relayout()
+    {
+        for (Drive &d : m_drives) {
+            d.rect = QRect();
+        }
+        const QSize cell = cellSize();
+        const int gap = (m_view == Win7ViewModeMenu::Details || m_view == Win7ViewModeMenu::List || m_view == Win7ViewModeMenu::SmallIcons) ? 0 : 4;
+        const int columns = qMax(1, (width() - kMarginLeft * 2) / (cell.width() + gap));
+        int y = 4;
+        if (m_view == Win7ViewModeMenu::Details) {
+            m_columnHeader = QRect(kMarginLeft + 8, y, cell.width(), 24);
+            y += 26;
+        }
+        auto place = [&](const QList<int> &members) {
+            for (int k = 0; k < members.count(); ++k) {
+                const int col = k % columns;
+                const int row = k / columns;
+                m_drives[members.at(k)].rect = QRect(kMarginLeft + 8 + col * (cell.width() + gap), y + row * (cell.height() + gap), cell.width(), cell.height());
+            }
+            y += ((members.count() + columns - 1) / columns) * (cell.height() + gap) + 6;
+        };
+        for (QRect &r : m_headerRects) {
+            r = QRect();
+        }
+        if (!m_grouped) {
+            place(sortedMembers(-1));
+        } else {
+            for (int g = 0; g < GroupCount; ++g) {
+                const QList<int> members = sortedMembers(g);
+                if (members.isEmpty()) {
+                    continue;
+                }
+                m_headerCounts[g] = members.count();
+                m_headerRects[g] = QRect(kMarginLeft - 6, y, width() - kMarginLeft * 2 + 6, kHeaderHeight);
+                y += kHeaderHeight - 2; // measured on Windows 7: the first tile closer under the title
+                if (!m_collapsed[g]) {
+                    place(members);
+                }
+            }
+        }
+        m_contentHeight = y + 8;
+        setMinimumHeight(m_contentHeight);
+    }
+
+    // Columns of the Details view: Name, Type, Total size, Free space
+    QList<int> columnWidths() const
+    {
+        const int w = m_columnHeader.width();
+        return {int(w * 0.40), int(w * 0.24), int(w * 0.18), w - int(w * 0.40) - int(w * 0.24) - int(w * 0.18)};
+    }
+
+    void paintColumnHeader(QPainter &p)
+    {
+        const QStringList titles{i18nc("@title:column Windows 7 computer page", "Name"), i18nc("@title:column Windows 7 computer page", "Type"),
+                                 i18nc("@title:column Windows 7 computer page", "Total Size"), i18nc("@title:column Windows 7 computer page", "Free Space")};
+        int x = m_columnHeader.left();
+        const QList<int> widths = columnWidths();
+        p.save();
+        for (int c = 0; c < 4; ++c) {
+            const QRect r(x, m_columnHeader.top(), widths[c], m_columnHeader.height());
+            p.setPen(QColor(0x4c, 0x60, 0x7a));
+            p.drawText(r.adjusted(6, 0, -4, 0), Qt::AlignVCenter | (c >= 2 ? Qt::AlignRight : Qt::AlignLeft), titles[c]);
+            p.setPen(QColor(0xe5, 0xe5, 0xe5));
+            p.drawLine(r.right(), r.top() + 3, r.right(), r.bottom() - 3);
+            x += widths[c];
+        }
+        p.restore();
+    }
+
+    QString typeText(const Drive &d) const
+    {
+        switch (d.group) {
+        case HardDisks:
+            return i18nc("@item Windows 7 drive type", "Local Disk");
+        case Removable:
+            return i18nc("@item Windows 7 drive type", "Removable Disk");
+        default:
+            return i18nc("@item Windows 7 drive type", "Portable Device");
+        }
+    }
+
+    void paintSelection(QPainter &p, const QRect &r, bool hovered, bool selected)
+    {
+        if (!hovered && !selected) {
+            return;
+        }
+        QColor top(0xfa, 0xfb, 0xfd), bottom(0xe8, 0xf1, 0xfc), border(0xb8, 0xd6, 0xfb);
+        if (selected) {
+            top = QColor(0xdc, 0xeb, 0xfc);
+            bottom = QColor(0xc1, 0xdb, 0xfc);
+            border = hovered ? QColor(0x7d, 0xa2, 0xce) : QColor(0x84, 0xac, 0xdd);
+        }
+        QLinearGradient grad(r.topLeft(), r.bottomLeft());
+        grad.setColorAt(0, top);
+        grad.setColorAt(1, bottom);
+        p.setPen(border);
+        p.setBrush(grad);
+        p.drawRoundedRect(QRectF(r).adjusted(0.5, 0.5, -0.5, -0.5), 3, 3);
+    }
+
+    void paintItem(QPainter &p, const Drive &d, bool hovered, bool selected)
+    {
+        const QRect r = d.rect;
+        const QIcon icon = QIcon::fromTheme(d.iconName, QIcon::fromTheme(QStringLiteral("drive-harddisk")));
+        switch (m_view) {
+        case Win7ViewModeMenu::ExtraLargeIcons:
+        case Win7ViewModeMenu::LargeIcons:
+        case Win7ViewModeMenu::MediumIcons: {
+            p.save();
+            p.setRenderHint(QPainter::Antialiasing);
+            paintSelection(p, r, hovered, selected);
+            const int size = m_view == Win7ViewModeMenu::ExtraLargeIcons ? 128 : m_view == Win7ViewModeMenu::LargeIcons ? 96 : 48;
+            p.drawPixmap(r.left() + (r.width() - size) / 2, r.top() + 4, icon.pixmap(size, size));
+            p.setPen(QColor(0x1e, 0x1e, 0x1e));
+            p.drawText(QRect(r.left() + 3, r.top() + size + 6, r.width() - 6, 32), Qt::AlignHCenter | Qt::AlignTop | Qt::TextWordWrap, d.name);
+            p.restore();
+            return;
+        }
+        case Win7ViewModeMenu::SmallIcons:
+        case Win7ViewModeMenu::List:
+        case Win7ViewModeMenu::Details: {
+            p.save();
+            p.setRenderHint(QPainter::Antialiasing);
+            paintSelection(p, r, hovered, selected);
+            p.drawPixmap(r.left() + 4, r.top() + (r.height() - 16) / 2, icon.pixmap(16, 16));
+            p.setPen(QColor(0x1e, 0x1e, 0x1e));
+            if (m_view != Win7ViewModeMenu::Details) {
+                p.drawText(QRect(r.left() + 26, r.top(), r.width() - 30, r.height()), Qt::AlignVCenter | Qt::AlignLeft,
+                           QFontMetrics(font()).elidedText(d.name, Qt::ElideRight, r.width() - 30));
+                p.restore();
+                return;
+            }
+            const QList<int> widths = columnWidths();
+            const QStringList cells{d.name, typeText(d), d.total > 0 ? KIO::convertSize(d.total) : QString(), d.free >= 0 ? KIO::convertSize(d.free) : QString()};
+            int x = r.left();
+            for (int c = 0; c < 4; ++c) {
+                QRect cr(x, r.top(), widths[c], r.height());
+                if (c == 0) {
+                    cr.setLeft(cr.left() + 22);
+                }
+                p.setPen(c == 0 ? QColor(0x1e, 0x1e, 0x1e) : QColor(0x6d, 0x6d, 0x6d));
+                p.drawText(cr.adjusted(6, 0, -6, 0), Qt::AlignVCenter | (c >= 2 ? Qt::AlignRight : Qt::AlignLeft),
+                           QFontMetrics(font()).elidedText(cells[c], Qt::ElideRight, cr.width() - 12));
+                x += widths[c];
+            }
+            p.restore();
+            return;
+        }
+        default:
+            paintDrive(p, d, hovered, selected);
+        }
+    }
+
+    /* ---------------- right-click menus (Windows 7) ---------------- */
+
+    void contextMenuEvent(QContextMenuEvent *event) override
+    {
+        const int hit = driveAt(event->pos());
+        QMenu menu(this);
+        if (hit >= 0) {
+            m_selected = hit;
+            update();
+            const Drive d = m_drives.at(hit);
+            QAction *open = menu.addAction(i18nc("@action:inmenu Windows 7 context menu", "Open"), this, [this, hit]() {
+                this->open(hit, false);
+            });
+            QFont bold = open->font();
+            bold.setBold(true);
+            open->setFont(bold);
+            menu.addAction(i18nc("@action:inmenu Windows 7 context menu", "Open in new tab"), this, [this, hit]() {
+                this->open(hit, true);
+            });
+            menu.addSeparator();
+            QAction *props = menu.addAction(i18nc("@action:inmenu Windows 7 context menu", "Properties"), this, [this, d]() {
+                KPropertiesDialog::showDialog(d.url, this);
+            });
+            props->setEnabled(d.url.isValid() && !d.url.isEmpty());
+            menu.exec(event->globalPos());
+            return;
+        }
+
+        // Empty space: View / Sort by / Group by / Refresh / Paste / ... / Properties
+        QMenu *view = Win7ViewModeMenu::createSubmenu(
+            [this]() {
+                return m_view;
+            },
+            [this](int row) {
+                setViewRow(row);
+            },
+            &menu);
+        view->addSeparator();
+        QAction *expand = view->addAction(i18nc("@action:inmenu Windows 7 context menu", "Expand all groups"), this, [this]() {
+            for (bool &c : m_collapsed) {
+                c = false;
+            }
+            relayout();
+            update();
+        });
+        QAction *collapse = view->addAction(i18nc("@action:inmenu Windows 7 context menu", "Collapse all groups"), this, [this]() {
+            for (bool &c : m_collapsed) {
+                c = true;
+            }
+            relayout();
+            update();
+        });
+        expand->setEnabled(m_grouped);
+        collapse->setEnabled(m_grouped);
+        menu.addMenu(view);
+
+        QMenu *sort = menu.addMenu(i18nc("@title:menu Windows 7 context menu", "Sort by"));
+        auto *sortGroup = new QActionGroup(sort);
+        const QStringList sortNames{i18nc("@action:inmenu Windows 7 sort", "Name"), i18nc("@action:inmenu Windows 7 sort", "Type"),
+                                    i18nc("@action:inmenu Windows 7 sort", "Total Size"), i18nc("@action:inmenu Windows 7 sort", "Free Space")};
+        for (int k = 0; k < sortNames.size(); ++k) {
+            QAction *a = sort->addAction(sortNames[k], this, [this, k]() {
+                m_sortKey = k;
+                relayout();
+                update();
+            });
+            a->setCheckable(true);
+            a->setChecked(m_sortKey == k);
+            sortGroup->addAction(a);
+        }
+        sort->addSeparator();
+        auto *orderGroup = new QActionGroup(sort);
+        QAction *asc = sort->addAction(i18nc("@action:inmenu Windows 7 sort", "Ascending"), this, [this]() {
+            m_desc = false;
+            relayout();
+            update();
+        });
+        QAction *desc = sort->addAction(i18nc("@action:inmenu Windows 7 sort", "Descending"), this, [this]() {
+            m_desc = true;
+            relayout();
+            update();
+        });
+        for (QAction *a : {asc, desc}) {
+            a->setCheckable(true);
+            orderGroup->addAction(a);
+        }
+        asc->setChecked(!m_desc);
+        desc->setChecked(m_desc);
+
+        QMenu *groupMenu = menu.addMenu(i18nc("@title:menu Windows 7 context menu", "Group by"));
+        auto *groupGroup = new QActionGroup(groupMenu);
+        QAction *byType = groupMenu->addAction(i18nc("@action:inmenu Windows 7 group", "Type"), this, [this]() {
+            m_grouped = true;
+            relayout();
+            update();
+        });
+        QAction *none = groupMenu->addAction(i18nc("@action:inmenu Windows 7 group", "(None)"), this, [this]() {
+            m_grouped = false;
+            relayout();
+            update();
+        });
+        for (QAction *a : {byType, none}) {
+            a->setCheckable(true);
+            groupGroup->addAction(a);
+        }
+        byType->setChecked(m_grouped);
+        none->setChecked(!m_grouped);
+
+        menu.addAction(i18nc("@action:inmenu Windows 7 context menu", "Refresh"), this, [this]() {
+            reload();
+        });
+        menu.addSeparator();
+        // Nothing can be pasted into "Computer" (disabled, like in Windows 7)
+        menu.addAction(i18nc("@action:inmenu Windows 7 context menu", "Paste"))->setEnabled(false);
+        menu.addAction(i18nc("@action:inmenu Windows 7 context menu", "Paste shortcut"))->setEnabled(false);
+        menu.addSeparator();
+        menu.addAction(i18nc("@action:inmenu Windows 7 context menu", "Add a network location"), this, [this]() {
+            Q_EMIT m_page->openUrlRequested(QUrl(QStringLiteral("remote:/")));
+        });
+        menu.addSeparator();
+        menu.addAction(i18nc("@action:inmenu Windows 7 context menu", "Properties"), this, []() {
+            // Windows 7 "System" window, KInfoCenter as a fallback
+            QString exe = QStandardPaths::findExecutable(QStringLiteral("seven-system"));
+            if (exe.isEmpty()) {
+                exe = QStandardPaths::findExecutable(QStringLiteral("seven-system"), {QDir::homePath() + QStringLiteral("/.local/bin")});
+            }
+            QProcess::startDetached(exe.isEmpty() ? QStringLiteral("kinfocenter") : exe, {});
+        });
+        menu.exec(event->globalPos());
+    }
+
+    void paintHeader(QPainter &p, int g)
+    {
+        const QRect r = m_headerRects[g];
+        p.save();
+        p.setRenderHint(QPainter::Antialiasing);
+
+        if (g == m_hoveredHeader) {
+            QLinearGradient grad(r.topLeft(), r.bottomLeft());
+            grad.setColorAt(0, QColor(0xfa, 0xfb, 0xfd));
+            grad.setColorAt(1, QColor(0xe8, 0xf1, 0xfc));
+            p.setPen(QColor(0xb8, 0xd6, 0xfb));
+            p.setBrush(grad);
+            p.drawRoundedRect(QRectF(r).adjusted(0.5, 2.5, -0.5, -2.5), 3, 3);
+        }
+
+        // Expand / collapse arrow
+        const QPointF c(r.left() + 10, r.center().y() + 1);
+        if (m_collapsed[g]) {
+            p.setPen(QColor(0xa6, 0xa6, 0xa6));
+            p.setBrush(Qt::white);
+            p.drawPolygon(QPolygonF({QPointF(c.x() - 2, c.y() - 4), QPointF(c.x() + 2, c.y()), QPointF(c.x() - 2, c.y() + 4)}));
+        } else {
+            p.setPen(QColor(0x26, 0x26, 0x26));
+            p.setBrush(QColor(0x59, 0x59, 0x59));
+            p.drawPolygon(QPolygonF({QPointF(c.x() + 3, c.y() - 3), QPointF(c.x() + 3, c.y() + 3), QPointF(c.x() - 3, c.y() + 3)}));
+        }
+
+        // Title in Windows 7 dark blue, slightly larger
+        QFont f = font();
+        f.setPointSizeF(f.pointSizeF() * 1.25);
+        p.setFont(f);
+        p.setPen(QColor(0x1e, 0x39, 0x87));
+        const QString title = groupTitle(g, m_headerCounts[g]);
+        const int textX = r.left() + 22;
+        p.drawText(QRect(textX, r.top(), r.width() - 22, r.height()), Qt::AlignVCenter | Qt::AlignLeft, title);
+
+        // Thin line to the right of the title
+        const int lineX = textX + QFontMetrics(f).horizontalAdvance(title) + 8;
+        QLinearGradient line(lineX, 0, r.right(), 0);
+        line.setColorAt(0, QColor(0xe2, 0xe6, 0xee));
+        line.setColorAt(1, QColor(0xf4, 0xf6, 0xfa));
+        p.setPen(QPen(QBrush(line), 1));
+        p.drawLine(QPointF(lineX, r.center().y() + 1.5), QPointF(r.right() - 2, r.center().y() + 1.5));
+        p.restore();
+    }
+
+    void paintDrive(QPainter &p, const Drive &d, bool hovered, bool selected)
+    {
+        const QRect r = d.rect;
+        p.save();
+        p.setRenderHint(QPainter::Antialiasing);
+
+        if (hovered || selected) {
+            QColor top(0xfa, 0xfb, 0xfd), bottom(0xe8, 0xf1, 0xfc), border(0xb8, 0xd6, 0xfb);
+            if (selected) {
+                top = QColor(0xdc, 0xeb, 0xfc);
+                bottom = QColor(0xc1, 0xdb, 0xfc);
+                border = hovered ? QColor(0x7d, 0xa2, 0xce) : QColor(0x84, 0xac, 0xdd);
+            }
+            QLinearGradient grad(r.topLeft(), r.bottomLeft());
+            grad.setColorAt(0, top);
+            grad.setColorAt(1, bottom);
+            p.setPen(border);
+            p.setBrush(grad);
+            p.drawRoundedRect(QRectF(r).adjusted(0.5, 0.5, -0.5, -0.5), 3, 3);
+        }
+
+        const QIcon icon = QIcon::fromTheme(d.iconName, QIcon::fromTheme(QStringLiteral("drive-harddisk")));
+        p.drawPixmap(r.left() + 2, r.top() + (r.height() - 48) / 2, icon.pixmap(48, 48));
+
+        const int textX = r.left() + 55;
+        const int textW = r.width() - 61;
+        p.setPen(QColor(0x1e, 0x1e, 0x1e));
+        const bool hasBar = d.group != Portable && d.total > 0;
+        if (!hasBar) {
+            p.drawText(QRect(textX, r.top(), textW, r.height()), Qt::AlignVCenter | Qt::AlignLeft,
+                       QFontMetrics(font()).elidedText(d.name, Qt::ElideRight, textW));
+            p.restore();
+            return;
+        }
+
+        p.drawText(QRect(textX, r.top() + 3, textW, 17), Qt::AlignVCenter | Qt::AlignLeft, QFontMetrics(font()).elidedText(d.name, Qt::ElideRight, textW));
+
+        // Usage bar
+        const QRectF bar(textX - 0.5, r.top() + 21.5, qMin(textW, 188), 13);
+        QLinearGradient trough(bar.topLeft(), bar.bottomLeft());
+        trough.setColorAt(0, QColor(0xe6, 0xe6, 0xe6));
+        trough.setColorAt(1, QColor(0xf6, 0xf6, 0xf6));
+        p.setPen(QColor(0xa0, 0xa0, 0xa0));
+        p.setBrush(trough);
+        p.drawRect(bar);
+        if (d.free >= 0) {
+            const double used = d.total > 0 ? double(d.total - d.free) / double(d.total) : 0.0;
+            const QRectF fill(bar.left() + 1, bar.top() + 1, (bar.width() - 1) * qBound(0.0, used, 1.0), bar.height() - 1);
+            const bool almostFull = used > 0.9;
+            QLinearGradient g(fill.topLeft(), fill.bottomLeft());
+            if (almostFull) {
+                g.setColorAt(0, QColor(0xf6, 0x9a, 0x9a));
+                g.setColorAt(0.45, QColor(0xda, 0x26, 0x26));
+                g.setColorAt(1, QColor(0xe6, 0x5c, 0x5c));
+            } else {
+                g.setColorAt(0, QColor(0x8b, 0xcf, 0xf5));
+                g.setColorAt(0.45, QColor(0x26, 0xa0, 0xda));
+                g.setColorAt(1, QColor(0x5c, 0xbd, 0xec));
+            }
+            p.setPen(Qt::NoPen);
+            p.setBrush(g);
+            p.drawRect(fill);
+        }
+
+        // "X free of Y"
+        p.setPen(QColor(0x6d, 0x6d, 0x6d));
+        QString info;
+        if (d.free >= 0) {
+            info = i18nc("@info Windows 7 computer page", "%1 free of %2", KIO::convertSize(d.free), KIO::convertSize(d.total));
+        } else {
+            info = i18nc("@info Windows 7 computer page, drive is not mounted", "%1 (not connected)", KIO::convertSize(d.total));
+        }
+        p.drawText(QRect(textX, r.top() + 35, textW, 17), Qt::AlignVCenter | Qt::AlignLeft, QFontMetrics(font()).elidedText(info, Qt::ElideRight, textW));
+        p.restore();
+    }
+
+    Win7ComputerPage *m_page;
+    KFilePlacesModel *m_places;
+    QList<Drive> m_drives;
+    QRect m_headerRects[GroupCount];
+    int m_headerCounts[GroupCount] = {0, 0, 0};
+    bool m_collapsed[GroupCount];
+    int m_hovered = -1;
+    int m_hoveredHeader = -1;
+    int m_selected = -1;
+    int m_contentHeight = 100;
+    int m_view = Win7ViewModeMenu::Tiles; // Windows 7 shows "Computer" as tiles
+    int m_sortKey = -1; // -1 = drive letter order
+    bool m_desc = false;
+    bool m_grouped = true;
+    QRect m_columnHeader;
+};
+
+Win7ComputerPage::Win7ComputerPage(QWidget *parent)
+    : QScrollArea(parent)
+    , m_canvas(new Win7ComputerCanvas(this))
+{
+    setFrameShape(QFrame::NoFrame);
+    setWidgetResizable(true);
+    setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    setWidget(m_canvas);
+    setStyleSheet(QStringLiteral("QScrollArea { background: white; border: none; }"));
+    m_canvas->reload();
+}
+
+QHash<QString, QString> Win7ComputerPage::driveNames(KFilePlacesModel *places, QStringList *order)
+{
+    struct Entry {
+        QString udi;
+        int kind; // 0 = system disk, 1 = other hard disk, 2 = removable, 3 = optical, 4 = portable
+        QString name;
+    };
+    QList<Entry> entries;
+    for (int row = 0; row < places->rowCount(); ++row) {
+        const QModelIndex idx = places->index(row, 0);
+        if (!places->isDevice(idx) || places->isHidden(idx)) {
+            continue;
+        }
+        const Solid::Device device = places->deviceForIndex(idx);
+        Entry e{device.udi(), 1, places->text(idx)};
+        const auto *access = device.as<Solid::StorageAccess>();
+        if (!access) {
+            e.kind = 4;
+        } else {
+            Solid::StorageDrive *drive = nullptr;
+            for (Solid::Device p = device.parent(); p.isValid(); p = p.parent()) {
+                if (p.is<Solid::StorageDrive>()) {
+                    drive = p.as<Solid::StorageDrive>();
+                    break;
+                }
+            }
+            if (access->isAccessible() && access->filePath() == QLatin1String("/")) {
+                e.kind = 0;
+            } else if (drive && drive->driveType() == Solid::StorageDrive::CdromDrive) {
+                e.kind = 3;
+            } else if (drive && (drive->isRemovable() || drive->driveType() != Solid::StorageDrive::HardDisk)) {
+                e.kind = 2;
+            }
+        }
+        entries.append(e);
+    }
+    QHash<QString, Solid::Device> opticalOf; // entry udi -> its optical drive device
+    for (const Entry &e : std::as_const(entries)) {
+        if (e.kind == 3) {
+            for (Solid::Device p(e.udi); p.isValid(); p = p.parent()) {
+                if (p.is<Solid::OpticalDrive>()) {
+                    opticalOf.insert(e.udi, p);
+                    break;
+                }
+            }
+        }
+    }
+    for (const Solid::Device &od : Win7ComputerPage::emptyOpticalDrives(places)) {
+        entries.append(Entry{od.udi(), 3, od.description()});
+        opticalOf.insert(od.udi(), od);
+    }
+    std::stable_sort(entries.begin(), entries.end(), [](const Entry &a, const Entry &b) {
+        return a.kind < b.kind;
+    });
+
+    QHash<QString, QString> names;
+    char letter = 'C';
+    for (const Entry &e : std::as_const(entries)) {
+        if (order) {
+            order->append(e.udi);
+        }
+        if (e.kind == 4 || letter > 'Z') {
+            names.insert(e.udi, e.name);
+            continue;
+        }
+        const QString drive = QStringLiteral("%1:").arg(QLatin1Char(letter++));
+        switch (e.kind) {
+        case 2:
+            names.insert(e.udi, i18nc("@item Windows 7 drive name, %1 is a drive letter like E:", "Removable Disk (%1)", drive));
+            break;
+        case 3: {
+            // with a disc in it: "Дисковод DVD RW (E:) <label>"
+            const QString base = opticalDriveName(opticalOf.value(e.udi), drive);
+            const Solid::Device dev(e.udi);
+            const auto *vol = dev.as<Solid::StorageVolume>();
+            names.insert(e.udi, vol && !vol->label().isEmpty() ? base + QLatin1Char(' ') + vol->label() : base);
+            break;
+        }
+        default:
+            names.insert(e.udi, i18nc("@item Windows 7 drive name, %1 is a drive letter like C:", "Local Disk (%1)", drive));
+            break;
+        }
+    }
+    return names;
+}
+
+QUrl Win7ComputerPage::computerUrl()
+{
+    // "title" is shown by the address bar and the window title
+    QUrl url(QStringLiteral("computer:/"));
+    QUrlQuery query;
+    query.addQueryItem(QStringLiteral("title"), i18nc("@title Windows 7 computer page", "Computer"));
+    url.setQuery(query);
+    return url;
+}
+
+bool Win7ComputerPage::isComputerUrl(const QUrl &url)
+{
+    return url.scheme() == QLatin1String("computer");
+}
+
+int Win7ComputerPage::viewRow() const
+{
+    return m_canvas->viewRow();
+}
+
+void Win7ComputerPage::setViewRow(int row)
+{
+    m_canvas->setViewRow(row);
+}
+
+void Win7ComputerPage::reload()
+{
+    m_canvas->reload();
+}
+
+void Win7ComputerPage::showEvent(QShowEvent *event)
+{
+    // Refresh free space every time the page is shown
+    m_canvas->reload();
+    QScrollArea::showEvent(event);
+}
+
+#include "moc_win7computerpage.cpp"
