+// The hovered / pressed frame of a Windows 7 command bar button (measured on the preview pane button)
+static void win7CommandHover(QPainter &p, const QRect &r, bool down)
+{
+    const int mid = r.top() + r.height() / 2;
+    QLinearGradient upper(0, r.top() + 1, 0, mid), lower(0, mid, 0, r.bottom() - 1);
+    upper.setColorAt(0, down ? QColor(0xe5, 0xec, 0xf5) : QColor(0xfa, 0xfc, 0xfe));
+    upper.setColorAt(1, down ? QColor(0xd9, 0xe3, 0xf0) : QColor(0xed, 0xf2, 0xfa));
+    lower.setColorAt(0, down ? QColor(0xc6, 0xd5, 0xe9) : QColor(0xd7, 0xe4, 0xf4));
+    lower.setColorAt(1, down ? QColor(0xb4, 0xc7, 0xe0) : QColor(0xc1, 0xd2, 0xe8));
+    QPainterPath outline;
+    outline.addRoundedRect(QRectF(r).adjusted(0.5, 0.5, -0.5, -0.5), 2.5, 2.5);
+    p.save();
+    p.setRenderHint(QPainter::Antialiasing);
+    p.save();
+    p.setClipPath(outline);
+    p.fillRect(QRect(r.left(), r.top(), r.width(), mid - r.top()), upper);
+    p.fillRect(QRect(r.left(), mid, r.width(), r.bottom() - mid + 1), lower);
+    p.restore();
+    p.setRenderHint(QPainter::Antialiasing, false);
+    p.setPen(QColor(0xff, 0xff, 0xff, 210));
+    p.drawRect(r.adjusted(1, 1, -1, -1));
+    p.setRenderHint(QPainter::Antialiasing);
+    QLinearGradient border(0, r.top(), 0, r.bottom());
+    border.setColorAt(0, down ? QColor(0x95, 0xab, 0xc6) : QColor(0xbb, 0xca, 0xdb));
+    border.setColorAt(1, down ? QColor(0x80, 0x98, 0xb8) : QColor(0xaa, 0xbc, 0xd5));
+    p.setPen(QPen(QBrush(border), 1));
+    p.setBrush(Qt::NoBrush);
+    p.drawPath(outline);
+    p.restore();
+}
