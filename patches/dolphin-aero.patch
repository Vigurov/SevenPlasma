+void Win7NavigationPane::rebuildDevices()
+{
+    if (!m_computer) {
+        return;
+    }
+    // Only rebuild when the set of devices really changed (dataChanged fires often)
+    QStringList signature;
+    for (int row = 0; row < m_places->rowCount(); ++row) {
+        const QModelIndex idx = m_places->index(row, 0);
+        if (m_places->isDevice(idx)) {
+            signature << m_places->text(idx) + QLatin1Char('|') + m_places->url(idx).toString() + QLatin1Char('|')
+                    + QString::number(m_places->isHidden(idx));
+        }
+    }
+    for (const Solid::Device &od : Win7ComputerPage::emptyOpticalDrives(m_places)) {
+        signature << od.udi();
+    }
+    if (signature == m_deviceSignature) {
+        return;
+    }
+    m_deviceSignature = signature;
+
+    const bool wasExpanded = isExpanded(m_computer->index());
+    m_computer->removeRows(0, m_computer->rowCount());
+
+    QStringList order;
+    const QHash<QString, QString> names = Win7ComputerPage::driveNames(m_places, &order);
+    QList<QStandardItem *> deviceItems;
+
+    for (int row = 0; row < m_places->rowCount(); ++row) {
+        const QModelIndex idx = m_places->index(row, 0);
+        const auto type = m_places->groupType(idx);
+        if (!m_places->isDevice(idx) || m_places->isHidden(idx)
+            || (type != KFilePlacesModel::DevicesType && type != KFilePlacesModel::RemovableDevicesType)) {
+            continue;
+        }
+        auto *item = new QStandardItem(m_places->icon(idx), names.value(m_places->deviceForIndex(idx).udi(), m_places->text(idx)));
+        item->setData(m_places->url(idx), UrlRole);
+        item->setData(m_places->deviceForIndex(idx).udi(), UdiRole);
+        item->setSizeHint(QSize(-1, 21));
+        item->setFlags(Qt::ItemIsEnabled | Qt::ItemIsSelectable);
+        if (m_places->url(idx).isValid() && !m_places->url(idx).isEmpty()) {
+            makeLazy(item);
+        }
+        deviceItems.append(item);
+    }
+    for (const Solid::Device &od : Win7ComputerPage::emptyOpticalDrives(m_places)) {
+        auto *item = new QStandardItem(QIcon::fromTheme(QStringLiteral("seven-bk-dvd"), QIcon::fromTheme(QStringLiteral("drive-optical"))), names.value(od.udi(), od.description()));
+        item->setData(od.udi(), UdiRole);
+        item->setData(true, Qt::UserRole + 50); // empty optical drive
+        item->setSizeHint(QSize(-1, 21));
+        item->setFlags(Qt::ItemIsEnabled | Qt::ItemIsSelectable);
+        deviceItems.append(item);
+    }
+    // Same order as the drive letters (C: first)
+    std::stable_sort(deviceItems.begin(), deviceItems.end(), [&order](QStandardItem *a, QStandardItem *b) {
+        return order.indexOf(a->data(UdiRole).toString()) < order.indexOf(b->data(UdiRole).toString());
+    });
+    for (QStandardItem *item : std::as_const(deviceItems)) {
+        m_computer->appendRow(item);
+    }
+
+    if (wasExpanded) {
+        expand(m_computer->index());
+    }
+    setUrl(m_url);
+}
+
+QStandardItem *Win7NavigationPane::makeLazy(QStandardItem *item)
+{
+    item->setData(true, LazyRole);
+    auto *placeholder = new QStandardItem();
+    placeholder->setFlags(Qt::NoItemFlags);
+    item->appendRow(placeholder);
+    return item;
+}
+
+void Win7NavigationPane::loadChildren(const QModelIndex &index)
+{
+    QStandardItem *item = m_model->itemFromIndex(index);
+    if (!item || !item->data(LazyRole).toBool() || item->data(LoadedRole).toBool()) {
+        return;
+    }
+    item->setData(true, LoadedRole);
+
+    const QUrl url = item->data(UrlRole).toUrl();
+    auto *job = KIO::listDir(url, KIO::HideProgressInfo, KIO::ListJob::ListFlags());
+    auto dirs = std::make_shared<QList<QPair<QString, QUrl>>>();
+    auto icons = std::make_shared<QHash<QUrl, QString>>();
+
+    connect(job, &KIO::ListJob::entries, this, [url, dirs, icons](KIO::Job *, const KIO::UDSEntryList &list) {
+        for (const KIO::UDSEntry &entry : list) {
+            const QString name = entry.stringValue(KIO::UDSEntry::UDS_NAME);
+            if (!entry.isDir() || name == QLatin1String(".") || name == QLatin1String("..") || name.startsWith(QLatin1Char('.'))) {
+                continue;
+            }
+            QString label = entry.stringValue(KIO::UDSEntry::UDS_DISPLAY_NAME);
+            if (label.isEmpty()) {
+                label = name;
+            }
+            QUrl child(entry.stringValue(KIO::UDSEntry::UDS_URL));
+            if (child.isEmpty()) {
+                child = url;
+                child.setPath(child.path() + (child.path().endsWith(QLatin1Char('/')) ? QString() : QStringLiteral("/")) + name);
+            }
+            dirs->append({label, child});
+            const QString icon = entry.stringValue(KIO::UDSEntry::UDS_ICON_NAME);
+            if (!icon.isEmpty()) {
+                icons->insert(child, icon);
+            }
+        }
+    });
+
+    const QPersistentModelIndex persistent(index);
+    connect(job, &KJob::result, this, [this, persistent, dirs, icons](KJob *) {
+        QStandardItem *parent = persistent.isValid() ? m_model->itemFromIndex(persistent) : nullptr;
+        if (!parent) {
+            return;
+        }
+        QCollator collator;
+        collator.setNumericMode(true);
+        collator.setCaseSensitivity(Qt::CaseInsensitive);
+        std::sort(dirs->begin(), dirs->end(), [&collator](const auto &a, const auto &b) {
+            return collator.compare(a.first, b.first) < 0;
+        });
+
+        // Replace the placeholder with the real subfolders; no subfolders -> no arrow
+        parent->removeRows(0, parent->rowCount());
+        for (const auto &[label, childUrl] : std::as_const(*dirs)) {
+            auto *child = new QStandardItem(QIcon::fromTheme(icons->value(childUrl, QStringLiteral("folder"))), label);
+            child->setData(childUrl, UrlRole);
+            child->setSizeHint(QSize(-1, 21));
+            child->setFlags(Qt::ItemIsEnabled | Qt::ItemIsSelectable);
+            makeLazy(child);
+            parent->appendRow(child);
+        }
+        setUrl(m_url);
+    });
+}
+
+void Win7NavigationPane::setUrl(const QUrl &url)
+{
+    m_url = url;
+    const QUrl wanted = normalized(url);
+
+    std::function<QModelIndex(const QModelIndex &)> find = [&](const QModelIndex &parent) -> QModelIndex {
+        for (int row = 0; row < m_model->rowCount(parent); ++row) {
+            const QModelIndex idx = m_model->index(row, 0, parent);
+            // Prefer the deepest match: "Desktop" under Favorites rather than Favorites itself
+            const QModelIndex found = find(idx);
+            if (found.isValid()) {
+                return found;
+            }
+            const QUrl itemUrl = idx.data(UrlRole).toUrl();
+            if (itemUrl.isValid() && !itemUrl.isEmpty() && normalized(itemUrl) == wanted) {
+                return idx;
+            }
+        }
+        return {};
+    };
+
+    const QModelIndex match = find(QModelIndex());
+    // Folder Options > "Automatically expand to current folder": open the tree down to the folder shown
+    // read fresh every time: the Folder Options dialog of seven-control changes it from another process
+    KConfig dolphinrc(QStringLiteral("dolphinrc"), KConfig::SimpleConfig);
+    const bool autoExpand = dolphinrc.group(QStringLiteral("Win7NavigationPane")).readEntry("AutoExpandToCurrentFolder", false);
+    if (autoExpand && !match.isValid() && wanted.isLocalFile()) {
+        // the deepest folder in the tree that contains the wanted one; expanding it lists its subfolders and
+        // calls setUrl() again, which goes one level deeper
+        const QString wantedPath = wanted.toLocalFile();
+        QModelIndex best;
+        int bestLength = -1;
+        std::function<void(const QModelIndex &)> walk = [&](const QModelIndex &parent) {
+            for (int row = 0; row < m_model->rowCount(parent); ++row) {
+                const QModelIndex idx = m_model->index(row, 0, parent);
+                const QUrl itemUrl = normalized(idx.data(UrlRole).toUrl());
+                if (itemUrl.isLocalFile()) {
+                    QString path = itemUrl.toLocalFile();
+                    if (!path.endsWith(QLatin1Char('/'))) {
+                        path += QLatin1Char('/');
+                    }
+                    if (wantedPath.startsWith(path) && path.size() > bestLength) {
+                        best = idx;
+                        bestLength = int(path.size());
+                    }
+                }
+                if (isExpanded(idx)) {
+                    walk(idx);
+                }
+            }
+        };
+        walk(QModelIndex());
+        if (best.isValid() && !isExpanded(best) && m_model->hasChildren(best)) {
+            expand(best);
+        }
+    }
+    if (match.isValid()) {
+        if (autoExpand) {
+            for (QModelIndex up = match.parent(); up.isValid(); up = up.parent()) {
+                expand(up);
+            }
+            scrollTo(match);
+        }
+        setCurrentIndex(match);
+    } else {
+        clearSelection();
+        setCurrentIndex(QModelIndex());
+    }
+}
+
+void Win7NavigationPane::mousePressEvent(QMouseEvent *event)
+{
+    const QModelIndex index = indexAt(event->pos());
+    if (!index.isValid() || !(index.flags() & Qt::ItemIsEnabled)) {
+        QTreeView::mousePressEvent(event);
+        return;
+    }
+
+    // A click left of the item (on the branch arrow) just expands/collapses it
+    const QRect itemRect = visualRect(index);
+    if (event->pos().x() < itemRect.left()) {
+        QTreeView::mousePressEvent(event);
+        return;
+    }
+
+    if (event->button() == Qt::LeftButton || event->button() == Qt::MiddleButton) {
+        if (event->button() == Qt::LeftButton) {
+            QTreeView::mousePressEvent(event);
+        }
+        activate(index, event->button());
+        return;
+    }
+    QTreeView::mousePressEvent(event);
+}
+
+void Win7NavigationPane::activate(const QModelIndex &index, int button)
+{
+    const QUrl url = index.data(UrlRole).toUrl();
+    const QString udi = index.data(UdiRole).toString();
+
+    auto open = [this, button](const QUrl &target) {
+        if (button == Qt::MiddleButton) {
+            Q_EMIT tabRequested(target);
+        } else {
+            Q_EMIT placeActivated(target);
+        }
+    };
+
+    if (!udi.isEmpty()) {
+        for (const Solid::Device &od : Win7ComputerPage::emptyOpticalDrives(m_places)) {
+            if (od.udi() == udi) {
+                Q_EMIT errorMessage(i18nd("sevenplasma", "Please insert a disc into drive \"%1\".").arg(Win7ComputerPage::driveNames(m_places).value(udi)));
+                return;
+            }
+        }
+        for (int row = 0; row < m_places->rowCount(); ++row) {
+            const QModelIndex idx = m_places->index(row, 0);
+            if (m_places->isDevice(idx) && m_places->deviceForIndex(idx).udi() == udi) {
+                if (m_places->setupNeeded(idx)) {
+                    // Safety: only removable drives (USB sticks...) are mounted on click.
+                    // Internal disks and NTFS partitions (e.g. Windows) are never mounted from here.
+                    const Solid::Device device = m_places->deviceForIndex(idx);
+                    const auto *volume = device.as<Solid::StorageVolume>();
+                    const bool ntfs = volume && volume->fsType().startsWith(QLatin1String("ntfs"));
+                    if (m_places->groupType(idx) != KFilePlacesModel::RemovableDevicesType || ntfs) {
+                        Q_EMIT errorMessage(i18nc("@info", "The drive \"%1\" is not connected to Linux. It is not mounted automatically to keep its data safe.",
+                                                  m_places->text(idx)));
+                        return;
+                    }
+                    // Mount the device first, then open it
+                    auto conn = std::make_shared<QMetaObject::Connection>();
+                    *conn = connect(m_places, &KFilePlacesModel::setupDone, this, [this, conn, open](const QModelIndex &done, bool success) {
+                        QObject::disconnect(*conn);
+                        if (success) {
+                            open(m_places->url(done));
+                        }
+                    });
+                    m_places->requestSetup(idx);
+                } else {
+                    open(m_places->url(idx));
+                }
+                return;
+            }
+        }
+    }
+
+    if (url.isValid()) {
+        open(url);
+    }
+}
+
+void Win7NavigationPane::rebuildFavorites()
+{
+    m_favorites->removeRows(0, m_favorites->rowCount());
+    for (const Favorite &f : loadFavorites()) {
+        QStandardItem *item = addChild(m_favorites, f.name, f.icon, f.url);
+        item->setData(true, FavoriteRole);
+        item->setData(f.icon, Qt::UserRole + 10);
+    }
+}
+
+void Win7NavigationPane::saveFavorites()
+{
+    QStringList items;
+    for (int i = 0; i < m_favorites->rowCount(); ++i) {
+        const QStandardItem *c = m_favorites->child(i);
+        items << c->text() + QLatin1Char('\t') + c->data(Qt::UserRole + 10).toString() + QLatin1Char('\t') + c->data(UrlRole).toUrl().toString();
+    }
+    KConfigGroup g(KSharedConfig::openConfig(QStringLiteral("dolphinrc")), QStringLiteral("Win7Favorites"));
+    g.writeEntry("Items", items);
+    g.sync();
+}
