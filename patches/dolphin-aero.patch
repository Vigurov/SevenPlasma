+/*
+ * Windows 7 Explorer style "Computer" page:
+ * drives grouped into "Hard Disk Drives" / "Devices with Removable Storage",
+ * each with a usage bar and "X free of Y".
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef WIN7COMPUTERPAGE_H
+#define WIN7COMPUTERPAGE_H
+
+#include <QHash>
+#include <Solid/Device>
+#include <QScrollArea>
+#include <QUrl>
+
+class KFilePlacesModel;
+class Win7ComputerCanvas;
+
+class Win7ComputerPage : public QScrollArea
+{
+    Q_OBJECT
+
+public:
+    explicit Win7ComputerPage(QWidget *parent = nullptr);
+
+    static QUrl computerUrl();
+    static bool isComputerUrl(const QUrl &url);
+
+    /**
+     * Windows 7 style names for the devices of @p places, keyed by Solid UDI:
+     * "Local Disk (C:)" for the drive Linux runs from, then D:, E:... for the other disks,
+     * "Removable Disk (X:)", "CD Drive (X:)". Portable devices keep their own name.
+     * Also returns the order in which the drives should be listed.
+     */
+    static QHash<QString, QString> driveNames(KFilePlacesModel *places, QStringList *order = nullptr);
+
+    /** CD/DVD drives without a disc: not in the places model, but listed by Windows 7 */
+    static QList<Solid::Device> emptyOpticalDrives(KFilePlacesModel *places);
+
+    void reload();
+
+    /** Windows 7 view mode of the page (Win7ViewModeMenu::Row), tiles by default */
+    int viewRow() const;
+    void setViewRow(int row);
+
+Q_SIGNALS:
+    void openUrlRequested(const QUrl &url);
+    void openUrlInNewTabRequested(const QUrl &url);
+    void errorMessage(const QString &message);
+
+protected:
+    void showEvent(QShowEvent *event) override;
+
+private:
+    Win7ComputerCanvas *m_canvas;
+};
+
+#endif // WIN7COMPUTERPAGE_H
