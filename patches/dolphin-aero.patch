+/* the context menus of the Windows 7 navigation pane */
+void Win7NavigationPane::showContextMenu(const QPoint &pos)
+{
+    const QModelIndex index = indexAt(pos);
+    const QUrl url = index.data(UrlRole).toUrl();
+    if (!index.isValid() || !url.isValid()) {
+        return;
+    }
+    QStandardItem *item = m_model->itemFromIndex(index);
+    QMenu menu(this);
+    const bool expandable = m_model->hasChildren(index) || index.data(LazyRole).toBool();
+    auto addToggle = [&]() {
+        QAction *a = menu.addAction(isExpanded(index) ? i18nd("sevenplasma", "Collapse") : i18nd("sevenplasma", "Expand"), this, [this, index]() {
+            setExpanded(index, !isExpanded(index));
+        });
+        menu.setDefaultAction(a);
+    };
+    auto addOpen = [&]() {
+        QAction *a = menu.addAction(i18nd("sevenplasma", "Open"), this, [this, url]() {
+            Q_EMIT placeActivated(url);
+        });
+        menu.setDefaultAction(a);
+    };
+    auto addNewWindow = [&]() {
+        menu.addAction(i18nd("sevenplasma", "Open in new window"), this, [this, url]() {
+            Q_EMIT newWindowRequested(url);
+        });
+    };
+
+    if (item == m_favorites) {
+        addToggle();
+        menu.addAction(i18nd("sevenplasma", "Sort by name"), this, [this]() {
+            m_favorites->sortChildren(0);
+            saveFavorites();
+        });
+        menu.addAction(i18nd("sevenplasma", "Restore favorites links"), this, [this]() {
+            KConfigGroup g(KSharedConfig::openConfig(QStringLiteral("dolphinrc")), QStringLiteral("Win7Favorites"));
+            g.deleteEntry("Items");
+            g.sync();
+            rebuildFavorites();
+        });
+        menu.addSeparator();
+        addNewWindow();
+        menu.addSeparator();
+        QAction *add = menu.addAction(i18nd("sevenplasma", "Add current location to Favorites"), this, [this]() {
+            const QUrl u = m_url;
+            QString name = u.fileName();
+            if (name.isEmpty()) {
+                name = u.toDisplayString(QUrl::PreferLocalFile);
+            }
+            QStandardItem *c = addChild(m_favorites, name, QStringLiteral("folder"), u);
+            c->setData(true, FavoriteRole);
+            c->setData(QStringLiteral("folder"), Qt::UserRole + 10);
+            saveFavorites();
+        });
+        bool already = false;
+        for (int i = 0; i < m_favorites->rowCount(); ++i) {
+            already = already || normalized(m_favorites->child(i)->data(UrlRole).toUrl()) == normalized(m_url);
+        }
+        add->setEnabled(m_url.isValid() && !already);
+    } else if (index.data(FavoriteRole).toBool()) {
+        addOpen();
+        addNewWindow();
+        menu.addSeparator();
+        menu.addAction(i18nd("sevenplasma", "Delete"), this, [this, item]() {
+            m_favorites->removeRow(item->row());
+            saveFavorites();
+        });
+        menu.addAction(i18nd("sevenplasma", "Rename"), this, [this, item]() {
+            bool ok = false;
+            const QString name = QInputDialog::getText(this, i18nd("sevenplasma", "Rename"), i18nd("sevenplasma", "New name:"), QLineEdit::Normal, item->text(), &ok).trimmed();
+            if (ok && !name.isEmpty()) {
+                item->setText(name);
+                saveFavorites();
+            }
+        });
+    } else {
+        if (expandable) {
+            addToggle();
+        } else {
+            addOpen();
+        }
+        addNewWindow();
+        if (url.isLocalFile()) {
+            menu.addSeparator();
+            menu.addAction(i18nd("sevenplasma", "Copy"), this, [url]() {
+                auto *mime = new QMimeData;
+                mime->setUrls({url});
+                QApplication::clipboard()->setMimeData(mime);
+            });
+        }
+        if (url.isLocalFile() || url.scheme() == QLatin1String("trash")) {
+            menu.addSeparator();
+            menu.addAction(i18nd("sevenplasma", "Properties"), this, [this, url]() {
+                KPropertiesDialog::showDialog(url, this);
+            });
+        }
+    }
+    menu.exec(viewport()->mapToGlobal(pos));
+}
