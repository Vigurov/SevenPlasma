+                "QToolButton:pressed { border-image: none; border: 1px solid #2c628b; border-radius: 0px; background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e5f4fc, stop:0.49 #c4e5f6, stop:0.5 #98d1ef, stop:1 #68b3db); }"));
