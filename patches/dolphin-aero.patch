+    Q_UNUSED(widget)
+    // Windows 7 Explorer's column header (ItemsView::Header in aero.msstyles): the item pictures for normal / hot /
+    // pressed (and the sorted variants), the sort arrow at the top centre
+    painter->save();
+    const QRect r = rect.toRect();
