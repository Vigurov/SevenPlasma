+/*
+ * Windows 7 Explorer "Change your view" drop-down: a slider on the left and
+ * Extra large / Large / Medium / Small icons, List, Details, Tiles, Content.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef WIN7VIEWMODEMENU_H
+#define WIN7VIEWMODEMENU_H
+
+#include <QWidget>
+
+#include <functional>
+
+class DolphinView;
+class QMenu;
+
+class Win7ViewModeMenu : public QWidget
+{
+    Q_OBJECT
+
+public:
+    enum Row {
+        ExtraLargeIcons = 0,
+        LargeIcons,
+        MediumIcons,
+        SmallIcons,
+        List,
+        Details,
+        Tiles,
+        Content,
+        RowCount,
+    };
+
+    explicit Win7ViewModeMenu(QWidget *parent = nullptr);
+
+    /** Current state: an icons zoom level (0..16) while in icons view, or one of the rows */
+    void setIconsZoomLevel(int level);
+    void setRow(Row row);
+
+    static QString rowText(Row row);
+    static QString rowIconName(Row row);
+
+    /** Which Windows 7 view row matches the current state of a Dolphin view, and how to apply one */
+    static int currentRow(DolphinView *view);
+    static void applyRow(DolphinView *view, int row);
+
+    /** Plain "View" submenu for context menus: the 8 rows with a dot on the current one */
+    static QMenu *createSubmenu(const std::function<int()> &current, const std::function<void(int)> &apply, QWidget *parent);
+
+    QSize sizeHint() const override;
+
+Q_SIGNALS:
+    void rowRequested(int row);
+    void iconsZoomLevelRequested(int level);
+
+protected:
+    void paintEvent(QPaintEvent *event) override;
+    void mousePressEvent(QMouseEvent *event) override;
+    void mouseMoveEvent(QMouseEvent *event) override;
+    void mouseReleaseEvent(QMouseEvent *event) override;
+    void leaveEvent(QEvent *event) override;
+
+private:
+    int rowY(int row) const;
+    int rowAt(int y) const;
+    void dragTo(int y);
+    void closeMenu();
+
+    qreal m_thumbY = 0;
+    int m_hoverRow = -1;
+    bool m_dragging = false;
+};
+
+#endif // WIN7VIEWMODEMENU_H
