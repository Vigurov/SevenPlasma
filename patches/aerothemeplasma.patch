+
+void Positioner::reservePlace(const QString &fileName, int index)
+{
+    m_reservedName = fileName;
+    m_reservedIndex = index;
+    applyReservedPlace(); // in case it is already there
+}
+
+void Positioner::applyReservedPlace()
+{
+    if (m_reservedName.isEmpty() || !m_enabled || !m_folderModel || m_deferApplyPositions) {
+        return;
+    }
+    for (int i = 0; i < m_folderModel->rowCount(); ++i) {
+        if (m_folderModel->data(m_folderModel->index(i, 0), FolderModel::FileNameRole).toString() != m_reservedName) {
+            continue;
+        }
+        const int from = m_sourceToProxy.value(i, -1);
+        if (from < 0) {
+            return; // not placed yet
+        }
+        const int to = m_reservedIndex;
+        m_reservedName.clear();
+        m_reservedIndex = -1;
+        if (to >= 0 && from != to) {
+            move({from, to}, true);
+        }
+        return;
+    }
+}
+
+void Positioner::applyPendingRename()
+{
+    // a renamed item that came back as a new one (removed + added): put it where it was
+    if (!m_pendingRenamed.has_value()) {
+        return;
+    }
+    auto positionsIt = m_positions.find(m_pendingRenamed->first);
+    if (positionsIt == m_positions.end()) {
+        return;
+    }
+    const GridPosition old = m_pendingRenamed->second;
+    m_pendingRenamed.reset();
+    const bool taken = std::ranges::any_of(m_positions.asKeyValueRange(), [&](auto &&kv) {
+        return kv.first != positionsIt.key() && kv.second == old;
+    });
+    if (!taken) {
+        positionsIt.value() = old;
+        convertFolderModelData();
+        savePositionsConfig();
     }
 }
 
