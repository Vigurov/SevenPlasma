+    // Windows 7: an account without a password has no password box, a click on its picture logs on.
+    // SDDM's NeedsPasswordRole is always true with shadow passwords, so ask AccountsService (PasswordMode 2)
+    // through /usr/local/libexec/seven-nopass-users.
+    property var m_noPassword: []
+    function passwordNeeded(username, role)
+    {
+        return role && m_noPassword.indexOf(username) < 0
+    }
+
+    Plasma5Support.DataSource {
+        id: noPasswordSource
+        engine: "executable"
+        connectedSources: []
+        onNewData: (sourceName, data) => {
+            disconnectSource(sourceName)
+            root.m_noPassword = (data["stdout"] || "").split("\n").map(s => s.trim()).filter(s => s.length > 0)
+            // the only account has no password: show its picture to click instead of the password box
+            if (pages.currentIndex == Main.LoginPage.Login && userModel.count < 2 && password.text === "")
+            {
+                let username = userModel.data(userModel.index(0, 0), Main.UserRoles.NameRole)
+                if (username != null && root.m_noPassword.indexOf(username) >= 0)
+                {
+                    pages.currentIndex = Main.LoginPage.SelectUser
+                }
+            }
+        }
+        Component.onCompleted: connectSource("/usr/local/libexec/seven-nopass-users")
+    }
+
