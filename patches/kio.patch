+void KFileWidgetPrivate::initWin7Header()
+{
+    m_win7Header = new QWidget(q);
+    m_win7Header->setObjectName(QStringLiteral("KFileWidget::win7header"));
+    auto *layout = new QHBoxLayout(m_win7Header);
+    // measured on Windows 7: the address bar right under the title, 22 px high
+    layout->setContentsMargins(4, 0, 6, 1);
+    layout->setAlignment(Qt::AlignTop); // the header may be taller than its row: keep the row at the top
+    // the header keeps its own height (with the folders hidden it must not take the window's spare room)
+    m_win7Header->setSizePolicy(QSizePolicy::Preferred, QSizePolicy::Fixed);
+    layout->setSpacing(4);
+
+    // Round back / forward buttons
+    auto *navs = new Aero::NavButtons(m_win7Header);
+    QAction *back = m_ops->action(KDirOperator::Back);
+    QAction *forward = m_ops->action(KDirOperator::Forward);
+    navs->back()->setEnabled(back->isEnabled());
+    navs->forward()->setEnabled(forward->isEnabled());
+    QObject::connect(back, &QAction::enabledChanged, navs->back(), &QWidget::setEnabled);
+    QObject::connect(forward, &QAction::enabledChanged, navs->forward(), &QWidget::setEnabled);
+    QObject::connect(navs->back(), &QAbstractButton::clicked, back, &QAction::trigger);
+    QObject::connect(navs->forward(), &QAbstractButton::clicked, forward, &QAction::trigger);
+    // Windows 7: a small "▾" after the round buttons lists the recent pages (the current one checked)
+    {
+        auto *recent = new QMenu(navs);
+        QObject::connect(recent, &QMenu::aboutToShow, recent, [this, recent]() {
+            recent->clear();
+            const int current = m_urlNavigator->historyIndex();
+            for (int i = m_urlNavigator->historySize() - 1; i >= 0; --i) {
+                const QUrl url = m_urlNavigator->locationUrl(i);
+                QString name;
+                const QModelIndex place = m_model->closestItem(url);
+                if (place.isValid() && m_model->url(place).matches(url, QUrl::StripTrailingSlash)) {
+                    name = m_model->text(place);
+                }
+                if (name.isEmpty()) {
+                    name = url.adjusted(QUrl::StripTrailingSlash).fileName();
+                }
+                if (name.isEmpty()) {
+                    name = url.toDisplayString(QUrl::PreferLocalFile);
+                }
+                QAction *a = recent->addAction(name);
+                a->setCheckable(true);
+                a->setChecked(i == current);
+                if (i == current) {
+                    QFont f = a->font();
+                    f.setBold(true);
+                    a->setFont(f);
+                }
+                QObject::connect(a, &QAction::triggered, m_urlNavigator, [this, i]() {
+                    // walk the history (index 0 is the newest page), like Windows 7 does
+                    while (m_urlNavigator->historyIndex() < i && m_urlNavigator->goBack()) { }
+                    while (m_urlNavigator->historyIndex() > i && m_urlNavigator->goForward()) { }
+                });
+            }
+        });
+        navs->setMenu(recent);
+        auto updateMenuButton = [this, navs]() {
+            navs->menuButton()->setEnabled(m_urlNavigator->historySize() > 1);
+        };
+        QObject::connect(m_urlNavigator, &KUrlNavigator::historyChanged, navs, updateMenuButton);
+        updateMenuButton();
+    }
+    layout->addWidget(navs);
+
+    // Address bar
+    m_urlNavigator->setParent(m_win7Header);
+    m_urlNavigator->setFixedHeight(24);
+    KFileWin7::decorateUrlNavigator(m_urlNavigator, [this]() {
+        m_ops->action(KDirOperator::Reload)->trigger();
+    });
+    layout->addWidget(m_urlNavigator, 1, Qt::AlignTop);
+
+    // Search box ("Search: <folder>") filters the current folder by name
+    m_win7Search = new QLineEdit(m_win7Header);
+    m_win7Search->setMinimumWidth(200);
+    m_win7Search->setMaximumWidth(260);
+    m_win7Search->setFixedHeight(24);
+    QAction *searchIcon = new QAction(QIcon::fromTheme(QStringLiteral("seven-explorer-search"), QIcon::fromTheme(QStringLiteral("gtk-search"))),
+                                      i18ndc("kio6-win7", "@action", "Search"), m_win7Search);
+    m_win7Search->addAction(searchIcon, QLineEdit::TrailingPosition);
+    QObject::connect(m_win7Search, &QLineEdit::textChanged, q, [this](const QString &text) {
+        QFont f = m_win7Search->font();
+        f.setItalic(text.isEmpty());
+        m_win7Search->setFont(f);
+        if (m_quickFilterEdit) {
+            m_quickFilterEdit->setText(text);
+        }
+    });
+    QObject::connect(m_urlNavigator, &KUrlNavigator::urlChanged, m_win7Search, [this](const QUrl &url) {
+        // Same name as shown in the address bar (place names like "Desktop" are translated)
+        QString name;
+        const QModelIndex place = m_model->closestItem(url);
+        if (place.isValid() && m_model->url(place).matches(url, QUrl::StripTrailingSlash)) {
+            name = m_model->text(place);
+        }
+        if (name.isEmpty()) {
+            name = url.adjusted(QUrl::StripTrailingSlash).fileName();
+        }
+        if (name.isEmpty()) {
+            name = url.isLocalFile() ? QStringLiteral("/") : url.toDisplayString();
+        }
+        m_win7Search->setPlaceholderText(i18ndc("kio6-win7", "@info:placeholder %1 is the folder name", "Search: %1", name));
+        // Windows 7: the hint is in italics (and disappears while typing)
+        QFont f = m_win7Search->font();
+        f.setItalic(m_win7Search->text().isEmpty());
+        m_win7Search->setFont(f);
+    });
+    layout->addWidget(m_win7Search, 0, Qt::AlignTop);
+}
+
+void KFileWidgetPrivate::initWin7CommandBar()
+{
+    m_win7CommandBar = new QToolBar(q);
+    m_win7CommandBar->setObjectName(QStringLiteral("KFileWidget::win7commandbar"));
+    m_win7CommandBar->setMovable(false);
+    m_win7CommandBar->setToolButtonStyle(Qt::ToolButtonTextOnly);
+    m_win7CommandBar->setIconSize(QSize(16, 16));
+    m_win7CommandBar->setFixedHeight(31); // Windows 7: 31 px
+
+    // "Organize" menu
+    auto *organize = new KActionMenu(i18ndc("kio6-win7", "@action Windows 7 command bar", "Organize"), q);
+    organize->setPopupMode(QToolButton::InstantPopup);
+    QMenu *menu = organize->menu();
+    // Windows 7's Organize menu (same items, same order, the genuine pictures, no shortcuts shown):
+    // Cut Copy Paste Undo Redo | Select all | Layout >, Folder and search options | Delete Rename
+    // Remove properties Properties | Close
+    {
+        auto pic = [](const char *name) {
+            const QString f = QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("seven-aero/menu/%1.png").arg(QLatin1String(name)));
+            return f.isEmpty() ? QIcon() : QIcon(QPixmap(f));
+        };
+        auto tr = [](const char *text) {
+            return i18ndc("kio6-win7", "@action Windows 7 organize menu", text);
+        };
+        auto selectedUrls = [this]() {
+            QList<QUrl> urls;
+            const KFileItemList items = m_ops->selectedItems();
+            for (const KFileItem &item : items) {
+                urls << item.url();
+            }
+            return urls;
+        };
+        QAction *cut = menu->addAction(pic("cut"), tr("Cut"));
+        QAction *copy = menu->addAction(pic("copy"), tr("Copy"));
+        QAction *paste = menu->addAction(pic("paste"), tr("Paste"));
+        QAction *undo = menu->addAction(tr("Undo"));
+        QAction *redo = menu->addAction(tr("Redo"));
+        menu->addSeparator();
+        QAction *selectAll = menu->addAction(tr("Select all"));
