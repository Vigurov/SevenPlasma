+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "kfilewin7viewmenu.h"
+
+
+#include <QActionGroup>
+
+#include <KLocalizedString>
+
+#include <QIcon>
+#include <QMenu>
+#include <QMouseEvent>
+#include <QPainter>
+#include <QPainterPath>
+
+namespace
+{
+// Layout taken from the Windows 7 menu (100 % scale)
+constexpr int kWidth = 205;
+constexpr int kHeight = 268;
+constexpr int kGutter = 34;       // slider column
+constexpr int kTrackX = 17;
+constexpr int kTrackTop = 12;
+constexpr int kTrackBottom = 256;
+constexpr int kRowHeight = 24;
+constexpr int kRowCenters[KFileWin7ViewMenu::RowCount] = {19, 58, 86, 128, 158, 188, 217, 246};
+// Icons view zoom level for the four icon rows (Dolphin: 0 = 16 px ... 16 = 256 px)
+constexpr int kIconLevels[4] = {16, 6, 3, 0};
+}
+
+KFileWin7ViewMenu::KFileWin7ViewMenu(QWidget *parent)
+    : QWidget(parent)
+{
+    setMouseTracking(true);
+    setFixedSize(kWidth, kHeight);
+    m_thumbY = kRowCenters[LargeIcons];
+}
+
+QSize KFileWin7ViewMenu::sizeHint() const
+{
+    return QSize(kWidth, kHeight);
+}
+
+QString KFileWin7ViewMenu::rowText(Row row)
+{
+    switch (row) {
+    case ExtraLargeIcons:
+        return i18ndc("kio6-win7", "@item:inmenu Windows 7 view mode", "Extra large icons");
+    case LargeIcons:
+        return i18ndc("kio6-win7", "@item:inmenu Windows 7 view mode", "Large icons");
+    case MediumIcons:
+        return i18ndc("kio6-win7", "@item:inmenu Windows 7 view mode", "Medium icons");
+    case SmallIcons:
+        return i18ndc("kio6-win7", "@item:inmenu Windows 7 view mode", "Small icons");
+    case List:
+        return i18ndc("kio6-win7", "@item:inmenu Windows 7 view mode", "List");
+    case Details:
+        return i18ndc("kio6-win7", "@item:inmenu Windows 7 view mode", "Details");
+    case Tiles:
+        return i18ndc("kio6-win7", "@item:inmenu Windows 7 view mode", "Tiles");
+    case Content:
+        return i18ndc("kio6-win7", "@item:inmenu Windows 7 view mode", "Content");
+    default:
+        return {};
+    }
+}
+
+QString KFileWin7ViewMenu::rowIconName(Row row)
+{
+    static const char *names[RowCount] = {"seven-view-huge", "seven-view-large", "seven-view-medium", "seven-view-small",
+                                          "seven-view-list", "seven-view-details", "seven-view-tiles", "seven-view-content"};
+    return QString::fromLatin1(names[row]);
+}
+
+
+
+
+
+
+
+int KFileWin7ViewMenu::rowY(int row) const
+{
+    return kRowCenters[row];
+}
+
+int KFileWin7ViewMenu::rowAt(int y) const
+{
+    for (int r = 0; r < RowCount; ++r) {
+        if (qAbs(y - kRowCenters[r]) <= kRowHeight / 2) {
+            return r;
+        }
+    }
+    return -1;
+}
+
+void KFileWin7ViewMenu::setIconsZoomLevel(int level)
+{
+    // Piecewise linear between the icon rows, like the Windows 7 slider
+    level = qBound(0, level, 16);
+    for (int i = 0; i < 3; ++i) {
+        const int hi = kIconLevels[i];
+        const int lo = kIconLevels[i + 1];
+        if (level <= hi && level >= lo) {
+            const qreal t = hi == lo ? 0.0 : qreal(hi - level) / qreal(hi - lo);
+            m_thumbY = kRowCenters[i] + t * (kRowCenters[i + 1] - kRowCenters[i]);
+            break;
+        }
+    }
+    update();
+}
+
+void KFileWin7ViewMenu::setRow(Row row)
+{
+    m_thumbY = kRowCenters[row];
+    update();
+}
+
+void KFileWin7ViewMenu::paintEvent(QPaintEvent *)
+{
+    QPainter p(this);
+    p.setRenderHint(QPainter::Antialiasing);
+
+    // Background and the line between the slider column and the items
+    p.fillRect(rect(), QColor(0xf0, 0xf0, 0xf0));
+    p.setPen(QColor(0xe2, 0xe3, 0xe3));
+    p.drawLine(QPointF(kGutter + 0.5, 2), QPointF(kGutter + 0.5, height() - 2));
+    p.setPen(Qt::white);
+    p.drawLine(QPointF(kGutter + 1.5, 2), QPointF(kGutter + 1.5, height() - 2));
+
+    // Thin separators between the lower rows
+    for (int r = SmallIcons; r < Content; ++r) {
+        const qreal y = (kRowCenters[r] + kRowCenters[r + 1]) / 2.0 + 0.5;
+        p.setPen(QColor(0xe2, 0xe3, 0xe3));
+        p.drawLine(QPointF(kGutter + 3, y), QPointF(width() - 3, y));
+        p.setPen(Qt::white);
+        p.drawLine(QPointF(kGutter + 3, y + 1), QPointF(width() - 3, y + 1));
+    }
+
+    // Items
+    for (int r = 0; r < RowCount; ++r) {
+        const int cy = kRowCenters[r];
+        if (r == m_hoverRow) {
+            const QRectF box(kGutter + 3.5, cy - kRowHeight / 2.0 + 1.5, width() - kGutter - 7, kRowHeight - 3);
+            QLinearGradient g(box.topLeft(), box.bottomLeft());
+            g.setColorAt(0, QColor(0xfa, 0xfb, 0xfd));
+            g.setColorAt(1, QColor(0xe8, 0xf1, 0xfc));
+            p.setPen(QColor(0xb8, 0xd6, 0xfb));
+            p.setBrush(g);
+            p.drawRoundedRect(box, 3, 3);
+        }
+        const QIcon icon = QIcon::fromTheme(rowIconName(Row(r)));
+        p.drawPixmap(kGutter + 12, cy - 8, icon.pixmap(16, 16));
+        p.setPen(QColor(0x1e, 0x1e, 0x1e));
+        p.drawText(QRect(kGutter + 33, cy - kRowHeight / 2, width() - kGutter - 36, kRowHeight), Qt::AlignVCenter | Qt::AlignLeft, rowText(Row(r)));
+    }
+
+    // Slider track
+    p.setRenderHint(QPainter::Antialiasing, false);
+    p.setPen(QColor(0xa6, 0xa6, 0xa6));
+    p.drawLine(kTrackX, kTrackTop, kTrackX, kTrackBottom);
+    p.setPen(Qt::white);
+    p.drawLine(kTrackX + 1, kTrackTop, kTrackX + 1, kTrackBottom);
+    p.setRenderHint(QPainter::Antialiasing, true);
+
+    // Slider thumb: a small button pointing right
+    const qreal ty = qRound(m_thumbY) + 0.5;
+    QPainterPath thumb;
+    thumb.moveTo(kTrackX - 10, ty - 5);
+    thumb.lineTo(kTrackX + 6, ty - 5);
+    thumb.lineTo(kTrackX + 11, ty);
+    thumb.lineTo(kTrackX + 6, ty + 5);
+    thumb.lineTo(kTrackX - 10, ty + 5);
+    thumb.closeSubpath();
+    QLinearGradient tg(0, ty - 5, 0, ty + 5);
+    tg.setColorAt(0, QColor(0xfd, 0xfd, 0xfd));
+    tg.setColorAt(1, QColor(0xd8, 0xd8, 0xd8));
+    p.setPen(QColor(0x70, 0x70, 0x70));
+    p.setBrush(tg);
+    p.drawPath(thumb);
+}
+
+void KFileWin7ViewMenu::dragTo(int y)
+{
+    const int yy = qBound(kRowCenters[0], y, kRowCenters[Content]);
+    if (yy <= kRowCenters[SmallIcons]) {
+        // Continuous icon size between "Extra large" and "Small"
+        for (int i = 0; i < 3; ++i) {
+            if (yy >= kRowCenters[i] && yy <= kRowCenters[i + 1]) {
+                const qreal t = qreal(yy - kRowCenters[i]) / qreal(kRowCenters[i + 1] - kRowCenters[i]);
+                const int level = qRound(kIconLevels[i] + t * (kIconLevels[i + 1] - kIconLevels[i]));
+                m_thumbY = yy;
+                update();
+                Q_EMIT iconsZoomLevelRequested(level);
+                return;
+            }
+        }
+    }
+    // Below the icon rows the slider snaps to List / Details / Tiles / Content
+    int best = List;
+    for (int r = List; r <= Content; ++r) {
+        if (qAbs(yy - kRowCenters[r]) < qAbs(yy - kRowCenters[best])) {
+            best = r;
+        }
+    }
+    m_thumbY = kRowCenters[best];
+    update();
+    Q_EMIT rowRequested(best);
+}
+
+void KFileWin7ViewMenu::mousePressEvent(QMouseEvent *event)
+{
+    const QPoint pos = event->position().toPoint();
+    if (pos.x() < kGutter) {
+        m_dragging = true;
+        dragTo(pos.y());
+        return;
+    }
+    const int row = rowAt(pos.y());
+    if (row >= 0) {
+        setRow(Row(row));
+        Q_EMIT rowRequested(row);
+        closeMenu();
+    }
+}
+
+void KFileWin7ViewMenu::mouseMoveEvent(QMouseEvent *event)
+{
+    const QPoint pos = event->position().toPoint();
+    if (m_dragging) {
+        dragTo(pos.y());
+        return;
+    }
+    const int row = pos.x() >= kGutter ? rowAt(pos.y()) : -1;
+    if (row != m_hoverRow) {
+        m_hoverRow = row;
+        update();
+    }
+}
+
+void KFileWin7ViewMenu::mouseReleaseEvent(QMouseEvent *)
+{
+    if (m_dragging) {
+        m_dragging = false;
+        closeMenu();
+    }
+}
+
+void KFileWin7ViewMenu::leaveEvent(QEvent *)
+{
+    m_hoverRow = -1;
+    update();
+}
+
+void KFileWin7ViewMenu::closeMenu()
+{
+    for (QWidget *w = parentWidget(); w; w = w->parentWidget()) {
+        if (auto *menu = qobject_cast<QMenu *>(w)) {
+            menu->close();
+            return;
+        }
+    }
+}
+
+#include "moc_kfilewin7viewmenu.cpp"
diff --git a/src/filewidgets/kfilewin7viewmenu.h b/src/filewidgets/kfilewin7viewmenu.h
new file mode 100644
index 0000000..e175760
--- /dev/null
+++ b/src/filewidgets/kfilewin7viewmenu.h
@@ -0,0 +1,68 @@
+/*
+ * Windows 7 Explorer "Change your view" drop-down: a slider on the left and
+ * Extra large / Large / Medium / Small icons, List, Details, Tiles, Content.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KFILEWIN7VIEWMENU_H
+#define KFILEWIN7VIEWMENU_H
+
+#include <QWidget>
+
+#include <functional>
+
+class QMenu;
+
+class KFileWin7ViewMenu : public QWidget
+{
+    Q_OBJECT
+
+public:
+    enum Row {
+        ExtraLargeIcons = 0,
+        LargeIcons,
+        MediumIcons,
+        SmallIcons,
+        List,
+        Details,
+        Tiles,
+        Content,
+        RowCount,
+    };
+
+    explicit KFileWin7ViewMenu(QWidget *parent = nullptr);
+
+    /** Current state: an icons zoom level (0..16) while in icons view, or one of the rows */
+    void setIconsZoomLevel(int level);
+    void setRow(Row row);
+
+    static QString rowText(Row row);
+    static QString rowIconName(Row row);
+
+
+    QSize sizeHint() const override;
+
+Q_SIGNALS:
+    void rowRequested(int row);
+    void iconsZoomLevelRequested(int level);
+
+protected:
+    void paintEvent(QPaintEvent *event) override;
+    void mousePressEvent(QMouseEvent *event) override;
+    void mouseMoveEvent(QMouseEvent *event) override;
+    void mouseReleaseEvent(QMouseEvent *event) override;
+    void leaveEvent(QEvent *event) override;
+
+private:
+    int rowY(int row) const;
+    int rowAt(int y) const;
+    void dragTo(int y);
+    void closeMenu();
+
+    qreal m_thumbY = 0;
+    int m_hoverRow = -1;
+    bool m_dragging = false;
+};
+
+#endif // KFILEWIN7VIEWMENU_H
diff --git a/src/filewidgets/win7knownfolders_p.h b/src/filewidgets/win7knownfolders_p.h
new file mode 100644
index 0000000..1bc2cfe
--- /dev/null
+++ b/src/filewidgets/win7knownfolders_p.h
@@ -0,0 +1,97 @@
+/*
+    Windows 7 look: how Explorer names the folders of the user profile in the address bar.
+    The path starts at the Desktop (no "▸" before it) or at the user's folder, and the known
+    folders show their localized names (desktop.ini LocalizedResourceName in Windows 7).
+*/
+
+#ifndef WIN7KNOWNFOLDERS_P_H
+#define WIN7KNOWNFOLDERS_P_H
+
+#include <KUser>
+
+#include <QDir>
+#include <QStandardPaths>
+#include <QString>
+#include <QUrl>
+
+namespace Win7KnownFolders
+{
+inline QString cleanPath(const QString &path)
+{
+    QString p = QDir::cleanPath(path);
+    while (p.size() > 1 && p.endsWith(QLatin1Char('/'))) {
+        p.chop(1);
+    }
+    return p;
+}
+
+/** the localized Windows 7 name of a folder of the user profile, or an empty string */
+inline QString displayName(const QString &localPath)
+{
+    const QString path = cleanPath(localPath);
+    if (path.isEmpty()) {
+        return {};
+    }
+    if (path == cleanPath(QDir::homePath())) {
+        const KUser user;
+        const QString full = user.property(KUser::FullName).toString();
+        return full.isEmpty() ? user.loginName() : full;
+    }
+    static const struct {
+        QStandardPaths::StandardLocation location;
+        const char *name;
+    } known[] = {
+        {QStandardPaths::DesktopLocation, "Робочий стіл"},
+        {QStandardPaths::DownloadLocation, "Завантаження"},
+        // the user folders that are libraries in Windows 7 show the library name in the address bar
+        {QStandardPaths::DocumentsLocation, "Документи"},
+        {QStandardPaths::MusicLocation, "Музика"},
+        {QStandardPaths::PicturesLocation, "Зображення"},
+        {QStandardPaths::MoviesLocation, "Відео"},
+    };
+    for (const auto &k : known) {
+        const QString dir = QStandardPaths::writableLocation(k.location);
+        if (!dir.isEmpty() && cleanPath(dir) == path && path != cleanPath(QDir::homePath())) {
+            return QString::fromUtf8(k.name);
+        }
+    }
+    return {};
+}
+
+/** true for the library folders (Documents, Music, Pictures, Videos) and anything under them */
+inline bool inLibrary(const QUrl &url)
+{
+    if (!url.isLocalFile()) {
+        return false;
+    }
+    const QString path = cleanPath(url.toLocalFile());
+    const QString home = cleanPath(QDir::homePath());
+    for (auto loc : {QStandardPaths::DocumentsLocation, QStandardPaths::MusicLocation, QStandardPaths::PicturesLocation, QStandardPaths::MoviesLocation}) {
+        const QString dir = cleanPath(QStandardPaths::writableLocation(loc));
+        if (!dir.isEmpty() && dir != home && (path == dir || path.startsWith(dir + QLatin1Char('/')))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/** the folder the address bar starts at: the Desktop, or the user's folder; invalid for other paths */
+inline QUrl rootUrl(const QUrl &url)
+{
+    if (!url.isLocalFile()) {
+        return {};
+    }
+    const QString path = cleanPath(url.toLocalFile());
+    const QString desktop = cleanPath(QStandardPaths::writableLocation(QStandardPaths::DesktopLocation));
+    const QString home = cleanPath(QDir::homePath());
+    if (desktop != home && (path == desktop || path.startsWith(desktop + QLatin1Char('/')))) {
+        return QUrl::fromLocalFile(desktop);
+    }
+    if (path == home || path.startsWith(home + QLatin1Char('/'))) {
+        return QUrl::fromLocalFile(home);
+    }
+    return {};
+}
+}
+
+#endif
