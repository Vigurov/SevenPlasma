+/**
+ * Paints KUrlNavigator's breadcrumb buttons like the Windows 7 address bar:
+ * regular (not bold) black text, small solid black "▸" arrows with even spacing,
+ * and a light blue box on hover.
+ */
+class BreadcrumbPainter : public QObject
+{
+public:
+    explicit BreadcrumbPainter(QWidget *navigator)
+        : QObject(navigator)
+        , m_navigator(navigator)
+    {
+        navigator->installEventFilter(this);
+        for (QWidget *w : navigator->findChildren<QWidget *>(Qt::FindDirectChildrenOnly)) {
+            watch(w);
+        }
+    }
+
+    static void drawArrow(QPainter &p, const QPointF &center, const QColor &color)
+    {
+        // Snap to whole pixels so every arrow gets exactly the same pixels
+        const qreal x = std::floor(center.x());
+        const qreal y = std::floor(center.y()) + 0.5;
+        p.save();
+        p.setRenderHint(QPainter::Antialiasing);
+        p.setPen(Qt::NoPen);
+        p.setBrush(color);
+        p.drawPolygon(QPolygonF({QPointF(x - 1.5, y - 3.5), QPointF(x + 2.5, y), QPointF(x - 1.5, y + 3.5)}));
+        p.restore();
+    }
+
+    /** Vertical center of the address bar, in @p w's coordinates, shared by all arrows */
+    qreal arrowCenterY(QWidget *w) const
+    {
+        return w->mapFrom(m_navigator, QPoint(0, m_navigator->height() / 2)).y();
+    }
+
+    /** Looks of a Windows 7 address bar cell (measured on Windows 7 screenshots) */
+    enum Cell {
+        Hot, // the crumb part under the mouse, and the rest of that crumb when its name is hovered
+        Pressed,
+        Neighbour, // the name part of a crumb while its "▸" is hovered: grey
+        BandHot, // the "▾" and refresh buttons at the right end of the bar
+        BandPressed,
+    };
+
+    /** The rows of the bar inside its border (the cells cover them completely), in @p w's coordinates */
+    static QPair<int, int> bandRows(QWidget *navigator, QWidget *w)
+    {
+        // KUrlNavigator draws its frame 1px inside: border rows 1 and height-2, white line rows 2 and height-3
+        const int top = w->mapFrom(navigator, QPoint(0, 2)).y();
+        const int bottom = w->mapFrom(navigator, QPoint(0, navigator->height() - 3)).y();
+        return {top, bottom};
+    }
+
+    /** A Windows 7 address bar cell from column @p x0 to @p x1 (inclusive) over the rows @p top..@p bottom:
+        light inner lines, a two-part glossy fill and dark side edges where @p leftEdge / @p rightEdge */
+    static void drawCell(QPainter &p, int x0, int x1, int top, int bottom, Cell cell, bool leftEdge, bool rightEdge)
+    {
+        if (x1 < x0 || bottom - top < 3) {
+            return;
+        }
+        QColor edge, lightTop, lightBottom, fill[4];
+        switch (cell) {
+        case Hot:
+            edge = QColor(0x3c, 0x7f, 0xb1);
+            lightTop = QColor(0xfa, 0xfd, 0xfe);
+            lightBottom = QColor(0xe8, 0xf5, 0xfc);
+            fill[0] = QColor(0xea, 0xf6, 0xfd), fill[1] = QColor(0xd7, 0xef, 0xfc), fill[2] = QColor(0xbd, 0xe6, 0xfd), fill[3] = QColor(0xa6, 0xd9, 0xf4);
+            break;
+        case Pressed:
+            edge = QColor(0x2c, 0x62, 0x8b);
+            lightTop = QColor(0xe5, 0xf4, 0xfc);
+            lightBottom = QColor(0x9e, 0xd2, 0xee);
+            fill[0] = QColor(0xe5, 0xf4, 0xfc), fill[1] = QColor(0xc4, 0xe5, 0xf6), fill[2] = QColor(0x98, 0xd1, 0xef), fill[3] = QColor(0x68, 0xb3, 0xdb);
+            break;
+        case Neighbour:
+            edge = QColor(0x8e, 0x8f, 0x8f);
+            lightTop = QColor(0xfc, 0xfc, 0xfc);
+            lightBottom = QColor(0xf3, 0xf3, 0xf3);
+            fill[0] = QColor(0xf2, 0xf2, 0xf2), fill[1] = QColor(0xef, 0xef, 0xef), fill[2] = QColor(0xd5, 0xd5, 0xd5), fill[3] = QColor(0xcf, 0xcf, 0xcf);
+            break;
+        case BandHot:
+            edge = QColor(0x16, 0x58, 0x8b);
+            lightTop = QColor(0xfd, 0xfe, 0xff);
+            lightBottom = QColor(0xce, 0xeb, 0xfa);
+            fill[0] = QColor(0xd3, 0xed, 0xfb), fill[1] = QColor(0xc6, 0xe9, 0xfa), fill[2] = QColor(0x9c, 0xd8, 0xf7), fill[3] = QColor(0x89, 0xd0, 0xf5);
+            break;
+        case BandPressed:
+            edge = QColor(0x10, 0x46, 0x70);
+            lightTop = QColor(0xc4, 0xe5, 0xf6);
+            lightBottom = QColor(0x8c, 0xc8, 0xe8);
+            fill[0] = QColor(0xc4, 0xe5, 0xf6), fill[1] = QColor(0xa9, 0xda, 0xf2), fill[2] = QColor(0x7c, 0xc4, 0xea), fill[3] = QColor(0x5d, 0xae, 0xdc);
+            break;
+        }
+        p.save();
+        p.setRenderHint(QPainter::Antialiasing, false);
+        const int innerTop = top + 1, innerBottom = bottom - 1;
+        const int mid = innerTop + (innerBottom - innerTop + 1) / 2;
+        QLinearGradient upper(0, innerTop, 0, mid - 1), lower(0, mid, 0, innerBottom);
+        upper.setColorAt(0, fill[0]);
+        upper.setColorAt(1, fill[1]);
+        lower.setColorAt(0, fill[2]);
+        lower.setColorAt(1, fill[3]);
+        p.fillRect(QRect(QPoint(x0, innerTop), QPoint(x1, mid - 1)), upper);
+        p.fillRect(QRect(QPoint(x0, mid), QPoint(x1, innerBottom)), lower);
+        p.fillRect(QRect(QPoint(x0, top), QPoint(x1, top)), lightTop);
+        p.fillRect(QRect(QPoint(x0, bottom), QPoint(x1, bottom)), lightBottom);
+        // light inner lines along the sides (inside the edges, if any)
+        const int lx = leftEdge ? x0 + 1 : x0, rx = rightEdge ? x1 - 1 : x1;
+        for (int x : {lx, rx}) {
+            p.fillRect(QRect(QPoint(x, innerTop), QPoint(x, mid - 1)), lightTop);
+            p.fillRect(QRect(QPoint(x, mid), QPoint(x, innerBottom)), lightBottom.lighter(106));
+        }
+        if (leftEdge) {
+            p.fillRect(QRect(QPoint(x0, top), QPoint(x0, bottom)), edge);
+        }
+        if (rightEdge) {
+            p.fillRect(QRect(QPoint(x1, top), QPoint(x1, bottom)), edge);
+        }
+        p.restore();
+    }
+
+    /** The dark line between two cells: the color of the hot one */
+    static void drawDivider(QPainter &p, int x, int top, int bottom, Cell cell)
+    {
+        const QColor c = cell == Neighbour ? QColor(0x8e, 0x8f, 0x8f)
+            : cell == Pressed              ? QColor(0x2c, 0x62, 0x8b)
+            : cell == BandHot              ? QColor(0x16, 0x58, 0x8b)
+            : cell == BandPressed          ? QColor(0x10, 0x46, 0x70)
+                                           : QColor(0x3c, 0x7f, 0xb1);
+        p.fillRect(QRect(QPoint(x, top), QPoint(x, bottom)), c);
+    }
+
+protected:
+    bool eventFilter(QObject *obj, QEvent *event) override
+    {
+        if (obj == m_navigator) {
+            if (event->type() == QEvent::ChildAdded || event->type() == QEvent::ChildPolished) {
+                if (auto *w = qobject_cast<QWidget *>(static_cast<QChildEvent *>(event)->child())) {
+                    watch(w);
+                }
+            }
+            return false;
+        }
+        // Windows 7 highlights the name and the "▸" of a crumb separately: repaint while the mouse moves over it,
+        // and the last crumb together with our trailing "▸"
+        if (event->type() == QEvent::HoverMove || event->type() == QEvent::HoverEnter || event->type() == QEvent::HoverLeave
+            || event->type() == QEvent::MouseButtonPress || event->type() == QEvent::MouseButtonRelease) {
+            if (auto *w = qobject_cast<QWidget *>(obj)) {
+                w->update();
+                if (w == m_trailingArrow || isLastButton(w)) {
+                    if (m_trailingArrow) {
+                        m_trailingArrow->update();
+                    }
+                    if (QWidget *last = lastButton()) {
+                        last->update();
+                    }
+                }
+            }
+            return false;
+        }
+        if (event->type() != QEvent::Paint) {
+            return false;
+        }
+        auto *button = qobject_cast<QAbstractButton *>(obj);
+        if (!button) {
+            return false;
+        }
+        const QByteArray cls = button->metaObject()->className();
+        QPainter p(button);
+        const QRect r = button->rect();
+        const QColor arrowColor(0x1a, 0x1a, 0x1a);
+        const bool hovered = button->underMouse() && button->isEnabled();
+        const auto [top, bottom] = bandRows(m_navigator, button);
+
+        if (cls.endsWith("KUrlNavigatorDropDownButton")) {
+            // The "▸" right after the location icon
+            if (hovered) {
+                drawCell(p, 0, r.width() - 1, top, bottom, button->isDown() ? Pressed : Hot, true, true);
+            }
+            drawArrow(p, QPointF(r.center().x() + 0.5, arrowCenterY(button)), arrowColor);
+            return true;
+        }
+        if (button == m_trailingArrow) {
+            // The "▸" of the last crumb: hot with its name, or on its own (the name then grey)
+            QWidget *last = lastButton();
+            if (hovered || (last && last->underMouse())) {
+                drawCell(p, 0, r.width() - 1, top, bottom, button->isDown() ? Pressed : Hot, false, true);
+                drawDivider(p, 0, top, bottom, button->isDown() ? Pressed : Hot);
+            }
+            drawArrow(p, QPointF(r.width() / 2.0, arrowCenterY(button)), arrowColor);
+            return true;
+        }
+
+        // A folder button: "name ▸" (the last one has no arrow; ours is drawn separately after it)
+        const bool isLast = isLastButton(button);
+        const int arrowWidth = isLast ? 0 : qMax(4, r.height() / 2);
+        {
+            const QString name = KLocalizedString::removeAcceleratorMarker(button->text());
+            QFont nf = button->font();
+            nf.setBold(false);
+            const int nameWidth = qMin(QFontMetrics(nf).horizontalAdvance(name), r.width() - arrowWidth - 6);
+            // The last crumb's cell ends where our trailing "▸" begins
+            const int divider = isLast ? 4 + nameWidth + 3 : r.width() - arrowWidth - 2;
+            const bool arrowHot = isLast ? (m_trailingArrow && m_trailingArrow->underMouse()) : (hovered && button->mapFromGlobal(QCursor::pos()).x() > divider);
+            const bool down = button->isDown();
+            if (hovered && !arrowHot) {
+                // the name is hovered: name and "▸" both hot
+                drawCell(p, 0, divider - 1, top, bottom, down ? Pressed : Hot, true, false);
+                drawDivider(p, divider, top, bottom, down ? Pressed : Hot);
+                if (!isLast) {
+                    drawCell(p, divider + 1, r.width() - 1, top, bottom, down ? Pressed : Hot, false, true);
+                }
+            } else if (arrowHot) {
+                // the "▸" is hovered: the name is grey
+                drawCell(p, 0, divider - 1, top, bottom, Neighbour, true, false);
+                if (!isLast) {
+                    drawDivider(p, divider, top, bottom, down ? Pressed : Hot);
+                    drawCell(p, divider + 1, r.width() - 1, top, bottom, down ? Pressed : Hot, false, true);
+                }
+            }
+        }
+        // KDE adds "&" accelerator markers to button texts; don't paint them
+        const QString text = KLocalizedString::removeAcceleratorMarker(button->text());
+        QFont f = button->font();
+        f.setBold(false);
+        p.setFont(f);
+        p.setPen(QColor(0x00, 0x00, 0x00));
+        const QRect textRect(4, 0, r.width() - arrowWidth - 6, r.height());
+        p.drawText(textRect, Qt::AlignVCenter | Qt::AlignLeft, QFontMetrics(f).elidedText(text, Qt::ElideRight, textRect.width()));
+        if (isLast && m_trailingArrow) {
+            // Put the trailing "▸" right after the (non-bold) name of the last folder
+            const int textWidth = qMin(QFontMetrics(f).horizontalAdvance(text), textRect.width());
+            QPoint pos = button->mapTo(m_navigator, QPoint(4 + textWidth + 3, 0));
+            // full height of the bar, so its cell lines up with the crumb's
+            pos.setY(0);
+            const int h = m_navigator->height();
+            if (m_trailingArrow->pos() != pos || m_trailingArrow->height() != h) {
+                QMetaObject::invokeMethod(m_trailingArrow, [arrow = m_trailingArrow, pos, h]() {
+                    arrow->setFixedHeight(h);
+                    arrow->move(pos);
+                    arrow->raise();
+                }, Qt::QueuedConnection);
+            }
+        }
+        if (!isLast) {
+            drawArrow(p, QPointF(r.right() - arrowWidth / 2.0 + 0.5, arrowCenterY(button)), arrowColor);
+        }
+        return true;
+    }
+
+public:
+    void setTrailingArrow(QWidget *arrow)
+    {
+        m_trailingArrow = arrow;
+        arrow->installEventFilter(this); // painted with the same arrow as the others
+        arrow->setAttribute(Qt::WA_Hover);
+    }
+
+private:
+    void watch(QWidget *w)
+    {
+        const QByteArray cls = w->metaObject()->className();
+        if ((cls.endsWith("KUrlNavigatorButton") || cls.endsWith("KUrlNavigatorDropDownButton")) && !m_watched.contains(w)) {
+            m_watched.insert(w);
+            w->installEventFilter(this);
+            w->setAttribute(Qt::WA_Hover);
+            // Full height, so the arrow is not clipped and lines up with the others
+            w->setSizePolicy(w->sizePolicy().horizontalPolicy(), QSizePolicy::Expanding);
+            connect(w, &QObject::destroyed, this, [this, w]() {
+                m_watched.remove(w);
+            });
+        }
+    }
+
+    bool isLastButton(QWidget *button) const
+    {
+        return button && lastButton() == button;
+    }
+
+    QWidget *lastButton() const
+    {
+        int maxX = -1;
+        QWidget *last = nullptr;
+        for (QWidget *w : std::as_const(m_watched)) {
+            if (w->isVisible() && QByteArray(w->metaObject()->className()).endsWith("KUrlNavigatorButton") && w->x() > maxX) {
+                maxX = w->x();
+                last = w;
+            }
+        }
+        return last;
+    }
+
+    QWidget *m_navigator;
+    QSet<QWidget *> m_watched;
+    QPointer<QWidget> m_trailingArrow;
+};
+
+
+
+} // namespace
+
+
+
+/** Paints the address bar's frame: the Aero text box picture, lighter while the mouse is over the bar
+    (KUrlNavigator would draw a flat line edit that disappears on the light header) */
+class AddressFrame : public QObject
+{
+public:
+    explicit AddressFrame(QWidget *nav)
+        : QObject(nav)
+    {
+        QObject::connect(qApp, &QApplication::focusChanged, nav, [nav]() {
+            nav->update();
+        });
+    }
+    bool eventFilter(QObject *o, QEvent *e) override
+    {
+        auto *w = static_cast<QWidget *>(o);
+        if (e->type() == QEvent::HoverEnter || e->type() == QEvent::HoverLeave || e->type() == QEvent::FocusIn || e->type() == QEvent::FocusOut) {
+            w->update();
+        } else if (e->type() == QEvent::Paint) {
+            QPainter p(w);
+            // the genuine Windows 7 address band on glass: see-through when idle, lighter under the mouse,
+            // white while typing
+            const bool editing = w->hasFocus() || w->isAncestorOf(QApplication::focusWidget());
+            const QString focusPicture = QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("seven-aero/entry-focus.png"));
+            const QPixmap pm(editing && !focusPicture.isEmpty() ? focusPicture
+                                 : w->underMouse()            ? QStringLiteral(":/AeroQt/transpbg/entry/hover.png")
+                                                              : QStringLiteral(":/AeroQt/transpbg/entry/normal.png"));
+            if (!pm.isNull()) {
+                qDrawBorderPixmap(&p, w->rect(), QMargins(4, 4, 4, 4), pm);
+            } else {
+                p.fillRect(w->rect(), Qt::white);
+                p.setPen(QColor(0x8e, 0x8f, 0x8f));
+                p.drawRect(w->rect().adjusted(1, 1, -2, -2));
+            }
+            return true;
+        }
+        return false;
+    }
+};
+
+/** Swallows the paint and tooltip events of KUrlNavigator's edit toggle (Windows 7 has no pencil there) */
+class SwallowPaint : public QObject
+{
+public:
+    using QObject::QObject;
+    bool eventFilter(QObject *, QEvent *e) override
+    {
+        return e->type() == QEvent::Paint || e->type() == QEvent::ToolTip;
+    }
+};
+
+/** Paints the "▾" (previous locations) and refresh buttons at the end of the address bar like Windows 7 */
+class BandPainter : public QObject
+{
+public:
+    BandPainter(QWidget *nav, QToolButton *history, QToolButton *refresh)
+        : QObject(nav)
+        , m_nav(nav)
+        , m_history(history)
+        , m_refresh(refresh)
+    {
+        for (QToolButton *b : {history, refresh}) {
+            b->setAttribute(Qt::WA_Hover);
+            b->setFixedHeight(nav->height());
+            b->installEventFilter(this);
+        }
+        nav->installEventFilter(this);
+    }
+    bool eventFilter(QObject *o, QEvent *e) override
+    {
+        if (o == m_nav) {
+            if (e->type() == QEvent::Resize) {
+                m_history->setFixedHeight(m_nav->height());
+                m_refresh->setFixedHeight(m_nav->height());
+            }
+            return false;
+        }
+        auto *b = static_cast<QToolButton *>(o);
+        switch (e->type()) {
+        case QEvent::Enter:
+        case QEvent::Leave:
+        case QEvent::MouseButtonPress:
+        case QEvent::MouseButtonRelease:
+            m_history->update();
+            m_refresh->update();
+            return false;
+        case QEvent::Paint: {
+            QPainter p(b);
+            const auto [top, bottom] = BreadcrumbPainter::bandRows(m_nav, b);
+            const bool down = b->isDown();
+            const bool hot = (b->underMouse() && b->isEnabled()) || down;
+            const int x0 = b == m_refresh ? 1 : 0;
+            if (hot) {
+                const auto cell = down ? BreadcrumbPainter::BandPressed : BreadcrumbPainter::BandHot;
+                BreadcrumbPainter::drawCell(p, x0, b->width() - 1, top, bottom, cell, x0 == 0, false);
+                BreadcrumbPainter::drawDivider(p, 0, top, bottom, cell);
+            }
+            if (b == m_refresh && !hot) {
+                const bool historyHot = m_history->underMouse() || m_history->isDown();
+                p.fillRect(QRect(QPoint(0, top - 1), QPoint(0, bottom + 1)), historyHot ? QColor(0x6a, 0x6b, 0x6c) : QColor(0x6a, 0x6b, 0x6c, 150));
+            }
+            const QPixmap px = b->icon().pixmap(b->iconSize(), b->isEnabled() ? QIcon::Normal : QIcon::Disabled);
+            const QSize ps = px.deviceIndependentSize().toSize();
+            int y = (top + bottom + 1 - ps.height()) / 2;
+            int x = x0 + (b->width() - x0 - ps.width()) / 2;
+            if (b == m_history && ps.height() == 16) {
+                const int innerTop = top + 1, innerBottom = bottom - 1;
+                y = innerTop + (innerBottom - innerTop + 1) / 2 - 6;
+                x = (b->width() + 1 - 9) / 2;
+            }
+            p.drawPixmap(x, y, px);
+            return true;
+        }
+        default:
+            return false;
+        }
+    }
+
+private:
+    QWidget *m_nav;
+    QToolButton *m_history, *m_refresh;
+};
+
+void decorateUrlNavigator(KUrlNavigator *nav, const std::function<void()> &reload)
+    {
+
+        auto *breadcrumbPainter = new BreadcrumbPainter(nav);
+        // the address bar is a white text box in Windows 7 (not the grey window colour), with the Aero text box frame
+        {
+            QPalette pal = nav->palette();
+            pal.setColor(QPalette::Window, Qt::white);
+            pal.setColor(QPalette::Button, Qt::white);
+            nav->setPalette(pal);
+            nav->setAttribute(Qt::WA_Hover);
+            nav->installEventFilter(new AddressFrame(nav));
+        }
+
+        auto *locationIcon = new QLabel(nav);
+        locationIcon->setFixedWidth(16); // Windows 7: the first name 7 px after the picture
+        locationIcon->setAlignment(Qt::AlignRight | Qt::AlignVCenter);
+        locationIcon->setContentsMargins(0, 0, 0, 0);
+        // Windows 7 shows the icon of the current folder, and no "▸" before the path when it starts at the
+        // Desktop (the top of the namespace)
+        auto updateLocationIcon = [nav, locationIcon]() {
+            const QString desktop = QStandardPaths::writableLocation(QStandardPaths::DesktopLocation);
+            const QString home = QDir::homePath();
+            const QString path = nav->locationUrl().toLocalFile();
+            const bool onDesktop = !path.isEmpty() && (path == desktop || path.startsWith(desktop + QLatin1Char('/')));
+            const bool inHome = !path.isEmpty() && path.startsWith(home + QLatin1Char('/'));
+            Q_UNUSED(inHome)
+            // the picture of the current folder (the Desktop itself has the monitor)
+            const QString icon = path == desktop ? QStringLiteral("desktop") : KIO::iconNameForUrl(nav->locationUrl());
+            locationIcon->setPixmap(QIcon::fromTheme(icon).pixmap(16, 16));
+            for (QAbstractButton *b : nav->findChildren<QAbstractButton *>(Qt::FindDirectChildrenOnly)) {
+                if (QByteArray(b->metaObject()->className()).endsWith("KUrlNavigatorDropDownButton")) {
+                    b->setMaximumWidth(onDesktop ? 0 : QWIDGETSIZE_MAX);
+                    b->setVisible(!onDesktop);
+                }
+            }
+        };
+        QObject::connect(nav, &KUrlNavigator::urlChanged, locationIcon, [updateLocationIcon, locationIcon]() {
+            updateLocationIcon();
+            QTimer::singleShot(0, locationIcon, updateLocationIcon); // after KUrlNavigator laid out its buttons
+        });
+        updateLocationIcon();
+
+        // One container at the very end: KUrlNavigator inserts its buttons relative to the end of its layout
+        auto *tail = new QWidget(nav);
+        auto *tailLayout = new QHBoxLayout(tail);
+        tailLayout->setContentsMargins(0, 0, 0, 0);
+        tailLayout->setSpacing(0);
+
+        auto *historyButton = new QToolButton(tail);
+        historyButton->setAutoRaise(true);
+        historyButton->setFixedWidth(17);
+        historyButton->setIcon(QIcon::fromTheme(QStringLiteral("seven-address-dropdown"), QIcon(QPixmap(arrowDownImagePath()))));
+        historyButton->setIconSize(QIcon::hasThemeIcon(QStringLiteral("seven-address-dropdown")) ? QSize(16, 16) : QSize(7, 4));
+        historyButton->setToolTip(i18ndc("kio6-win7", "@info:tooltip", "Previous Locations"));
+        auto *historyMenu = new QMenu(historyButton);
+        QObject::connect(historyMenu, &QMenu::aboutToShow, historyMenu, [nav, historyMenu]() {
+            historyMenu->clear();
+            QList<QUrl> seen;
+            for (int i = 0; i < nav->historySize(); ++i) {
+                const QUrl url = nav->locationUrl(i);
+                if (seen.contains(url)) {
+                    continue;
+                }
+                seen.append(url);
+                QAction *a = historyMenu->addAction(QIcon::fromTheme(KIO::iconNameForUrl(url)),
+                                                    url.isLocalFile() ? url.toLocalFile() : url.toDisplayString());
+                QObject::connect(a, &QAction::triggered, nav, [nav, url]() {
+                    nav->setLocationUrl(url);
+                });
+            }
+        });
+        QObject::connect(historyButton, &QToolButton::clicked, historyButton, [historyButton, historyMenu]() {
+            historyMenu->exec(historyButton->mapToGlobal(QPoint(0, historyButton->height())));
+        });
+
+        auto *refreshButton = new QToolButton(tail);
+        refreshButton->setAutoRaise(true);
+        refreshButton->setFixedWidth(25); // its first column is the line between "▾" and refresh
+        refreshButton->setIconSize(QSize(16, 16));
+        refreshButton->setIcon(QIcon::fromTheme(QStringLiteral("seven-address-refresh"), QIcon::fromTheme(QStringLiteral("view-refresh"))));
+        refreshButton->setToolTip(i18ndc("kio6-win7", "@info:tooltip", "Refresh"));
+        QObject::connect(refreshButton, &QToolButton::clicked, nav, [reload]() {
+            reload();
+        });
+        // Windows 7 (same as our Explorer): flat cells over the whole height of the bar, a grey line between
+        // "▾" and refresh; hovered a dark blue left edge and a glossy blue fill
+        new BandPainter(nav, historyButton, refreshButton);
+        tailLayout->addWidget(historyButton);
+        tailLayout->addWidget(refreshButton);
+
+        if (auto *navLayout = qobject_cast<QBoxLayout *>(nav->layout())) {
+            navLayout->insertWidget(0, locationIcon);
+            navLayout->setSpacing(0); // Windows 7: the first name 7 px after the picture, crumbs side by side
+            navLayout->addWidget(tail);
+            // Windows 7: the refresh cell reaches the frame (its last column replaces the white inner line)
+            auto fitTail = [nav, tail]() {
+                if (!tail->isVisible()) {
+                    return;
+                }
+                const int gap = (nav->width() - 3) - tail->geometry().right();
+                if (gap != 0) {
+                    QMargins margins = nav->contentsMargins();
+                    margins.setRight(qMax(0, margins.right() - gap));
+                    nav->setContentsMargins(margins);
+                }
+            };
+            struct Fit : QObject {
+                std::function<void()> fn;
+                Fit(QObject *parent, std::function<void()> f)
+                    : QObject(parent)
+                    , fn(std::move(f))
+                {
+                }
+                bool eventFilter(QObject *, QEvent *e) override
+                {
+                    if (e->type() == QEvent::Resize || e->type() == QEvent::Show || e->type() == QEvent::LayoutRequest) {
+                        QTimer::singleShot(0, this, [this]() {
+                            fn();
+                        });
+                    }
+                    return false;
+                }
+            };
+            nav->installEventFilter(new Fit(nav, fitTail));
+        }
+
+        // Windows 7: a "▸" after the last folder lists its subfolders (or the drives on the Computer page).
+        // It lives on top of KUrlNavigator's empty clickable area (the edit-mode toggle), right after the last button.
+        QAbstractButton *toggle = nullptr;
+        for (QAbstractButton *b : nav->findChildren<QAbstractButton *>(Qt::FindDirectChildrenOnly)) {
+            if (QByteArray(b->metaObject()->className()).endsWith("KUrlNavigatorToggleButton")) {
+                toggle = b;
+            }
+        }
+        if (toggle) {
+            toggle->setToolTip(QString());
+            toggle->installEventFilter(new SwallowPaint(toggle));
+            auto *crumbArrow = new QToolButton(nav);
+            crumbArrow->setCursor(Qt::ArrowCursor);
+            crumbArrow->setFixedSize(14, 20);
+            crumbArrow->setStyleSheet(QStringLiteral("QToolButton { border: none; border-image: none; background: transparent; padding: 0px; }"));
+            // Placed right after the last folder name by BreadcrumbPainter; until then after the toggle's left edge
+            crumbArrow->move(toggle->x() + 2, qMax(0, (nav->height() - crumbArrow->height()) / 2));
+            breadcrumbPainter->setTrailingArrow(crumbArrow);
+            auto updateArrowVisibility = [nav, crumbArrow]() {
+                crumbArrow->setVisible(!nav->isUrlEditable());
+            };
+            QObject::connect(nav, &KUrlNavigator::editableStateChanged, crumbArrow, updateArrowVisibility);
+            updateArrowVisibility();
+
+            QObject::connect(crumbArrow, &QToolButton::clicked, crumbArrow, [nav, crumbArrow]() {
+                const QUrl url = nav->locationUrl();
+                auto *menu = new QMenu(crumbArrow);
+                menu->setAttribute(Qt::WA_DeleteOnClose);
+                auto show = [menu, crumbArrow]() {
+                    if (menu->isEmpty()) {
+                        menu->addAction(i18ndc("kio6-win7", "@item:inmenu Windows 7 address bar", "(Empty)"))->setEnabled(false);
+                    }
+                    menu->popup(crumbArrow->mapToGlobal(QPoint(0, crumbArrow->height())));
+                };
+                auto addEntry = [menu, nav](const QIcon &icon, const QString &text, const QUrl &target) {
+                    QAction *a = menu->addAction(icon, text);
+                    QObject::connect(a, &QAction::triggered, nav, [nav, target]() {
+                        nav->setLocationUrl(target);
+                    });
+                };
+
+
+                // Subfolders of the current folder
+                auto *job = KIO::listDir(url, KIO::HideProgressInfo, KIO::ListJob::ListFlags());
+                auto dirs = std::make_shared<QList<QPair<QString, QUrl>>>();
+                QObject::connect(job, &KIO::ListJob::entries, menu, [url, dirs](KIO::Job *, const KIO::UDSEntryList &list) {
+                    for (const KIO::UDSEntry &entry : list) {
+                        const QString name = entry.stringValue(KIO::UDSEntry::UDS_NAME);
+                        if (!entry.isDir() || name == QLatin1String(".") || name == QLatin1String("..") || name.startsWith(QLatin1Char('.'))) {
+                            continue;
+                        }
+                        QUrl child = url.adjusted(QUrl::StripTrailingSlash);
+                        child.setPath(child.path() + QLatin1Char('/') + name);
+                        dirs->append({name, child});
+                    }
+                });
+                QObject::connect(job, &KJob::result, menu, [dirs, addEntry, show]() {
+                    QCollator collator;
+                    collator.setNumericMode(true);
+                    collator.setCaseSensitivity(Qt::CaseInsensitive);
+                    std::sort(dirs->begin(), dirs->end(), [&collator](const auto &a, const auto &b) {
+                        return collator.compare(a.first, b.first) < 0;
+                    });
+                    for (const auto &[name, child] : std::as_const(*dirs)) {
+                        addEntry(QIcon::fromTheme(QStringLiteral("folder")), name, child);
+                    }
+                    show();
+                });
+            });
+        }
+    }
+
+
+QString arrowDownImagePath()
+{
+    // the Windows 7 command bar "▾": a crisp 7-5-3-1 triangle in #1e395b with faint edge pixels (9 x 5 picture)
+    const QString path = QStandardPaths::writableLocation(QStandardPaths::GenericCacheLocation) + QStringLiteral("/kio-win7/arrow-down-9x5.png");
+    if (!QFile::exists(path)) {
+        QDir().mkpath(QFileInfo(path).path());
+        QImage arrow(9, 5, QImage::Format_ARGB32);
+        arrow.fill(Qt::transparent);
+        const QRgb solid = qRgba(0x1e, 0x39, 0x5b, 255);
+        for (int row = 0; row < 4; ++row) {
+            for (int x = 1 + row; x <= 7 - row; ++x) {
+                arrow.setPixel(x, row, solid);
+            }
+            const int edge = row == 0 ? 30 : 64;
+            arrow.setPixel(row, row, qRgba(0x1e, 0x39, 0x5b, edge));
+            arrow.setPixel(8 - row, row, qRgba(0x1e, 0x39, 0x5b, edge));
+        }
+        arrow.setPixel(4, 4, qRgba(0x1e, 0x39, 0x5b, 30));
+        arrow.save(path);
+    }
+    return path;
+}
+
+void skipTaskbar(QWidget *window)
+{
+    // through Xlib loaded at run time (KIO does not link X11 itself)
+    using Display = void;
+    struct ClientMessage {
+        int type;
+        unsigned long serial;
+        int send_event;
+        Display *display;
+        unsigned long window;
+        unsigned long message_type;
+        int format;
+        long data[5];
+        long pad[12];
+    };
+    static void *lib = dlopen("libX11.so.6", RTLD_LAZY);
+    if (!lib || !window) {
+        return;
+    }
+    auto openDisplay = reinterpret_cast<Display *(*)(const char *)>(dlsym(lib, "XOpenDisplay"));
+    auto internAtom = reinterpret_cast<unsigned long (*)(Display *, const char *, int)>(dlsym(lib, "XInternAtom"));
+    auto rootWindow = reinterpret_cast<unsigned long (*)(Display *)>(dlsym(lib, "XDefaultRootWindow"));
+    auto sendEvent = reinterpret_cast<int (*)(Display *, unsigned long, int, long, void *)>(dlsym(lib, "XSendEvent"));
+    auto flush = reinterpret_cast<int (*)(Display *)>(dlsym(lib, "XFlush"));
+    auto closeDisplay = reinterpret_cast<int (*)(Display *)>(dlsym(lib, "XCloseDisplay"));
+    if (!openDisplay || !internAtom || !rootWindow || !sendEvent || !flush || !closeDisplay) {
+        return;
+    }
+    Display *d = openDisplay(nullptr);
+    if (!d) {
+        return;
+    }
+    ClientMessage ev{};
+    ev.type = 33; // ClientMessage
+    ev.send_event = 1;
+    ev.window = window->winId();
+    ev.message_type = internAtom(d, "_NET_WM_STATE", 0);
+    ev.format = 32;
+    ev.data[0] = 1; // add
+    ev.data[1] = long(internAtom(d, "_NET_WM_STATE_SKIP_TASKBAR", 0));
+    ev.data[2] = long(internAtom(d, "_NET_WM_STATE_SKIP_PAGER", 0));
+    ev.data[3] = 1;
+    sendEvent(d, rootWindow(d), 0, 0x180000L, &ev); // SubstructureRedirect | SubstructureNotify
+    flush(d);
+    closeDisplay(d);
+}
+}
+
+namespace KFileWin7
+{
+void closeButtonOnly(QWidget *window)
+{
+    static void *lib = dlopen("libX11.so.6", RTLD_LAZY);
+    if (!lib || !window || !window->windowHandle()) {
+        return;
+    }
+    using Display = void;
+    auto openDisplay = reinterpret_cast<Display *(*)(const char *)>(dlsym(lib, "XOpenDisplay"));
+    auto internAtom = reinterpret_cast<unsigned long (*)(Display *, const char *, int)>(dlsym(lib, "XInternAtom"));
+    auto changeProperty = reinterpret_cast<int (*)(Display *, unsigned long, unsigned long, unsigned long, int, int, const unsigned char *, int)>(dlsym(lib, "XChangeProperty"));
+    auto flush = reinterpret_cast<int (*)(Display *)>(dlsym(lib, "XFlush"));
+    auto closeDisplay = reinterpret_cast<int (*)(Display *)>(dlsym(lib, "XCloseDisplay"));
+    if (!openDisplay || !internAtom || !changeProperty || !flush || !closeDisplay) {
+        return;
+    }
+    Display *d = openDisplay(nullptr);
+    if (!d) {
+        return;
+    }
+    const unsigned long hints = internAtom(d, "_MOTIF_WM_HINTS", 0);
+    // flags = functions; functions = resize | move | close
+    const long data[5] = {1, 2 | 4 | 32, 0, 0, 0};
+    changeProperty(d, window->winId(), hints, hints, 32, 0, reinterpret_cast<const unsigned char *>(data), 5);
+    flush(d);
+    closeDisplay(d);
+}
+}
