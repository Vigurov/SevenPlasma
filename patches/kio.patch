+/*
+ * Windows 7 Explorer style navigation pane:
+ * Favorites, Libraries, Homegroup, Computer, Network as a tree.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KFILEWIN7NAVPANE_H
+#define KFILEWIN7NAVPANE_H
+
+#include <QPersistentModelIndex>
+#include <QHash>
+#include <QTreeView>
+#include <QUrl>
+
+class KFilePlacesModel;
+class QStandardItem;
+class QStandardItemModel;
+
+class KFileWin7NavPane : public QTreeView
+{
+    Q_OBJECT
+
+public:
+    explicit KFileWin7NavPane(QWidget *parent = nullptr);
+
+    /** Windows 7 style drive names ("Local Disk (C:)") keyed by Solid UDI, plus their order */
+    static QHash<QString, QString> driveNames(KFilePlacesModel *places, QStringList *order = nullptr);
+
+public Q_SLOTS:
+    void setUrl(const QUrl &url);
+
+Q_SIGNALS:
+    void placeActivated(const QUrl &url);
+    void tabRequested(const QUrl &url);
+    void newWindowRequested(const QUrl &url);
+    void errorMessage(const QString &message);
+
+protected:
+    void mousePressEvent(QMouseEvent *event) override;
+    void enterEvent(QEnterEvent *event) override;
+    void leaveEvent(QEvent *event) override;
+    void drawBranches(QPainter *painter, const QRect &rect, const QModelIndex &index) const override;
+    void drawRow(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const override;
+    void mouseMoveEvent(QMouseEvent *event) override;
+    QSize sizeHint() const override;
+
+private:
+    QStandardItem *addGroup(const QString &text, const QString &iconName, const QUrl &url);
+    QStandardItem *addChild(QStandardItem *group, const QString &text, const QString &iconName, const QUrl &url);
+    void addSpacer();
+    void rebuildDevices();
+    QStandardItem *makeLazy(QStandardItem *item);
+    void loadChildren(const QModelIndex &index);
+    void activate(const QModelIndex &index, int button);
+    void showContextMenu(const QPoint &pos);
+    void updateStyleSheet(bool hovered);
+    QRect arrowRect(const QModelIndex &index) const;
+
+    QStandardItemModel *m_model;
+    KFilePlacesModel *m_places;
+    QStandardItem *m_computer = nullptr;
+    QUrl m_url;
+    bool m_hovered = false;
+    QStringList m_deviceSignature;
+    QPersistentModelIndex m_hoverIndex;
+    bool m_arrowHot = false;
+};
+
+#endif // KFILEWIN7NAVPANE_H
