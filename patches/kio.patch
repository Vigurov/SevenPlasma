+    QString css = QStringLiteral(
+        "QTreeView { background: white; border: none; outline: 0; show-decoration-selected: 0; }"
+        "QTreeView::item { color: black; border: 1px solid transparent; background: transparent; padding-left: 1px; }"
+        "QTreeView::item:hover, QTreeView::item:selected { color: black; border: 1px solid transparent; background: transparent; }");
