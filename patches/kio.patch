+
+namespace
+{
+/* Windows 7 "Tiles" (measured on a real one): each tile 250 x 52 in a 254 x 56 grid, the first one 15 px in and
+   6 px down; the 48 px picture 4 px from the tile's left edge, the lines 56 px in, 16 px apart, the block of lines
+   centred (name black, type and size #6d6d6d); hover and selection like the other views */
+class Win7TileDelegate : public QStyledItemDelegate
+{
+public:
+    using QStyledItemDelegate::QStyledItemDelegate;
+    QSize sizeHint(const QStyleOptionViewItem &, const QModelIndex &) const override
+    {
+        return QSize(254, 56);
+    }
+    void paint(QPainter *p, const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        QStyleOptionViewItem o(option);
+        initStyleOption(&o, index);
+        const QWidget *w = o.widget;
+        QStyle *style = w ? w->style() : QApplication::style();
+        const QRect tile = option.rect.adjusted(2, 2, -2, -2);
+
+        QStyleOptionViewItem panel(o);
+        panel.rect = tile;
+        panel.text.clear();
+        panel.icon = QIcon();
+        panel.features &= ~QStyleOptionViewItem::HasDisplay;
+        panel.features &= ~QStyleOptionViewItem::HasDecoration;
+        style->drawPrimitive(QStyle::PE_PanelItemViewItem, &panel, p, w);
+
+        const QRect iconBox(tile.left() + 4, tile.top() + (tile.height() - 48) / 2, 48, 48);
+        const QVariant deco = index.data(Qt::DecorationRole);
+        QPixmap pm;
+        if (deco.canConvert<QIcon>()) {
+            pm = deco.value<QIcon>().pixmap(QSize(48, 48), w ? w->devicePixelRatioF() : 1.0);
+        } else if (deco.canConvert<QPixmap>()) {
+            pm = deco.value<QPixmap>();
+        }
+        if (!pm.isNull()) {
+            const QSize s = pm.deviceIndependentSize().toSize().scaled(48, 48, Qt::KeepAspectRatio);
+            const QRect r(iconBox.left() + (48 - s.width()) / 2, iconBox.top() + (48 - s.height()) / 2, s.width(), s.height());
+            p->drawPixmap(r, pm);
+        }
+
+        QStringList lines{index.data(Qt::DisplayRole).toString()};
+        const KFileItem item = index.data(KDirModel::FileItemRole).value<KFileItem>();
+        if (!item.isNull()) {
+            lines << item.mimeComment();
+            if (!item.isDir()) {
+                lines << KIO::convertSize(item.size());
+            }
+        }
+        const QFontMetrics fm(o.font);
+        const int x = tile.left() + 56;
+        const int width = tile.right() - 4 - x;
+        const int blockTop = tile.top() + (tile.height() - 16 * lines.size()) / 2;
+        p->save();
+        p->setFont(o.font);
+        for (int i = 0; i < lines.size(); ++i) {
+            p->setPen(i == 0 ? o.palette.color(QPalette::Text) : QColor(0x6d, 0x6d, 0x6d));
+            // the capitals start 4 px into each 16 px line
+            const int baseline = blockTop + 16 * i + 4 + fm.capHeight();
+            p->drawText(QPoint(x, baseline), fm.elidedText(lines.at(i), Qt::ElideRight, width));
+        }
+        p->restore();
+    }
+};
+}
 
