@@ -0,0 +1,610 @@
+/*
+ * Windows 7 Explorer style navigation pane.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "kfilewin7navpane.h"
+
+#include <QPainter>
+#include <QStyledItemDelegate>
+
+#include <Solid/StorageAccess>
+#include <Solid/StorageDrive>
+
+#include <KFilePlacesModel>
+#include <KLocalizedString>
+
+#include <KIO/ListJob>
+#include <Solid/Device>
+#include <Solid/StorageVolume>
+#include <KIO/UDSEntry>
+
+#include <QCollator>
+#include <QDir>
+#include <functional>
+#include <memory>
+#include <QHeaderView>
+#include <QMenu>
+#include <QMouseEvent>
+#include <QPainter>
+#include <QStandardItemModel>
+#include <QStandardPaths>
+
+namespace
+{
+enum Roles {
+    UrlRole = Qt::UserRole + 1,
+    UdiRole,
+    LazyRole, // children (subfolders) are listed when the item is expanded
+    LoadedRole,
+};
+
+QUrl localUrl(QStandardPaths::StandardLocation location)
+{
+    return QUrl::fromLocalFile(QStandardPaths::writableLocation(location));
+}
+
+QUrl normalized(const QUrl &url)
+{
+    return url.adjusted(QUrl::StripTrailingSlash | QUrl::NormalizePathSegments);
+}
+}
+
+/** Windows 7 places the icon 6 px into the row and the name 19 px after it (21 for the top level) */
+class KFileWin7NavDelegate : public QStyledItemDelegate
+{
+public:
+    using QStyledItemDelegate::QStyledItemDelegate;
+    void paint(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        const QIcon icon = index.data(Qt::DecorationRole).value<QIcon>();
+        const QString text = index.data(Qt::DisplayRole).toString();
+        if (text.isEmpty() && icon.isNull()) {
+            return;
+        }
+        const QRect r = option.rect;
+        const int ix = r.left() + 6;
+        const bool enabled = index.flags() & Qt::ItemIsEnabled;
+        if (!icon.isNull()) {
+            painter->drawPixmap(ix, r.top() + (r.height() - 16) / 2, icon.pixmap(QSize(16, 16), enabled ? QIcon::Normal : QIcon::Disabled));
+        }
+        const int tx = ix + (index.parent().isValid() ? 19 : 21);
+        painter->save();
+        painter->setFont(option.font);
+        painter->setPen(enabled ? QColor(Qt::black) : QColor(0x6d, 0x6d, 0x6d));
+        const QRect tr(tx, r.top(), r.right() - tx - 2, r.height());
+        painter->drawText(tr, Qt::AlignVCenter | Qt::AlignLeft, QFontMetrics(option.font).elidedText(text, Qt::ElideRight, tr.width()));
+        painter->restore();
+    }
+};
+
+KFileWin7NavPane::KFileWin7NavPane(QWidget *parent)
+    : QTreeView(parent)
+    , m_model(new QStandardItemModel(this))
+    , m_places(new KFilePlacesModel(this))
+{
+    setModel(m_model);
+    setHeaderHidden(true);
+    setFrameShape(QFrame::NoFrame);
+    setIndentation(12); // measured on Windows 7
+    setItemDelegate(new KFileWin7NavDelegate(this));
+    setIconSize(QSize(16, 16));
+    setUniformRowHeights(false);
+    setAnimated(false); // Windows 7 expands/collapses instantly
+    setMouseTracking(true);
+    setEditTriggers(QAbstractItemView::NoEditTriggers);
+    setSelectionMode(QAbstractItemView::SingleSelection);
+    setExpandsOnDoubleClick(false);
+    setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    setMinimumWidth(110);
+
+    auto *favorites = addGroup(i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Favorites"), QStringLiteral("favorites"), localUrl(QStandardPaths::DesktopLocation));
+    // same order as Windows 7: Desktop, Downloads, Recent Places
+    addChild(favorites, i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Desktop"), QStringLiteral("desktop"), localUrl(QStandardPaths::DesktopLocation));
+    addChild(favorites, i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Downloads"), QStringLiteral("folder-downloads"), localUrl(QStandardPaths::DownloadLocation));
+    addChild(favorites, i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Recent Places"), QStringLiteral("folder-recent"), QUrl(QStringLiteral("recentlyused:/locations/")));
+    addSpacer();
+
+    auto *libraries = addGroup(i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Libraries"), QStringLiteral("folder-library"), QUrl::fromLocalFile(QDir::homePath()));
+    makeLazy(addChild(libraries, i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Videos"), QStringLiteral("library-video"), localUrl(QStandardPaths::MoviesLocation)));
+    makeLazy(addChild(libraries, i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Documents"), QStringLiteral("library-txt"), localUrl(QStandardPaths::DocumentsLocation)));
+    makeLazy(addChild(libraries, i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Pictures"), QStringLiteral("library-images"), localUrl(QStandardPaths::PicturesLocation)));
+    makeLazy(addChild(libraries, i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Music"), QStringLiteral("library-music"), localUrl(QStandardPaths::MusicLocation)));
+    addSpacer();
+
+    // Windows 7's file dialogs show Homegroup only when the PC is in one (it is not): left out
+
+    m_computer = addGroup(i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Computer"), QStringLiteral("computer"), QUrl() /* in the file dialog "Computer" only expands */);
+    addSpacer();
+
+    makeLazy(addGroup(i18ndc("kio6-win7", "@item Windows 7 navigation pane", "Network"), QStringLiteral("gnome-fs-network"), QUrl(QStringLiteral("remote:/"))));
+
+    rebuildDevices();
+    connect(m_places, &QAbstractItemModel::rowsInserted, this, &KFileWin7NavPane::rebuildDevices);
+    connect(m_places, &QAbstractItemModel::rowsRemoved, this, &KFileWin7NavPane::rebuildDevices);
+    connect(m_places, &QAbstractItemModel::dataChanged, this, &KFileWin7NavPane::rebuildDevices);
+    connect(m_places, &KFilePlacesModel::errorMessage, this, &KFileWin7NavPane::errorMessage);
+    connect(this, &QTreeView::expanded, this, &KFileWin7NavPane::loadChildren);
+
+    // Favorites and Libraries are expanded by default, like in Windows 7
+    expand(favorites->index());
+    expand(libraries->index());
+
+
+    updateStyleSheet(false);
+}
