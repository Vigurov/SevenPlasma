+/*
+ * Windows 7 look for the KDE file dialog: breadcrumbs, address bar buttons.
+ * Shared ideas with the Aero Dolphin fork (Win7BreadcrumbPainter there).
+ *
+ * SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+#ifndef KFILEWIN7CHROME_H
+#define KFILEWIN7CHROME_H
+
+#include <functional>
+
+class KUrlNavigator;
+class QString;
+
+class QWidget;
+
+namespace KFileWin7
+{
+/** Location icon, Windows 7 breadcrumbs, trailing "▸" menu, history "▾" and Refresh inside the address bar */
+void decorateUrlNavigator(KUrlNavigator *nav, const std::function<void()> &reload);
+
+/** Path of a small dark "▾" image used in stylesheets (created on first use) */
+QString arrowDownImagePath();
+/** _NET_WM_STATE_SKIP_TASKBAR / SKIP_PAGER for @p window (X11) */
+void skipTaskbar(QWidget *window);
+/** Windows 7 common dialogs have only the close button: no minimize / maximize (Motif WM hints) */
+void closeButtonOnly(QWidget *window);
+}
+
+#endif
