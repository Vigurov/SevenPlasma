+// Windows 7 "Recycle Bin Properties" > "Don't move files to the Recycle Bin" (seven-control writes
+// Win7DeleteImmediately into the trash directory's group of ktrashrc): such files are deleted instead
+static bool win7DeleteImmediately(const QList<QUrl> &urls)
+{
+    if (urls.isEmpty()) {
+        return false;
+    }
+    const KConfig cfg(QStringLiteral("ktrashrc"), KConfig::SimpleConfig);
+    const QStorageInfo home(QDir::homePath());
+    for (const QUrl &url : urls) {
+        if (!url.isLocalFile()) {
+            return false;
+        }
+        const QStorageInfo vol(url.toLocalFile());
+        const QString dir = vol.device() == home.device()
+            ? QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/Trash")
+            : vol.rootPath() + QStringLiteral("/.Trash-%1").arg(getuid());
+        if (!cfg.group(dir).readEntry("Win7DeleteImmediately", false)) {
+            return false;
+        }
+    }
+    return true;
+}
