+void KFileWidgetPrivate::applyWin7Texts()
+{
+    // One text size everywhere like Segoe UI 9 in Windows 7 (the combo boxes would otherwise come out larger)
+    {
+        QFont f = q->font();
+        f.setPixelSize(12);
+        for (QWidget *w : {static_cast<QWidget *>(m_locationEdit), static_cast<QWidget *>(m_filterWidget)}) {
+            if (w) {
+                w->setFont(f);
+            }
+        }
+    }
+    // Windows 7 wording and plain text buttons
+    if (m_locationLabel) {
+        m_locationLabel->setText(i18ndc("kio6-win7", "@label Windows 7 file dialog", "File &name:"));
+        m_locationLabel->setAlignment(Qt::AlignRight | Qt::AlignVCenter);
+    }
+    if (m_filterLabel) {
+        m_filterLabel->setText(i18ndc("kio6-win7", "@label Windows 7 file dialog", "Save as &type:"));
+        m_filterLabel->setAlignment(Qt::AlignRight | Qt::AlignVCenter);
+    }
+    for (QComboBox *combo : {static_cast<QComboBox *>(m_locationEdit), static_cast<QComboBox *>(m_filterWidget)}) {
+        if (combo && combo->lineEdit()) {
+            combo->lineEdit()->setClearButtonEnabled(false);
+        }
+    }
+    // Windows 7: the "▾" of the file name opens the list of recent names even when it is empty (a white box)
+    if (m_locationEdit && !m_locationEdit->property("_seven_emptypopup").toBool()) {
+        m_locationEdit->setProperty("_seven_emptypopup", true);
+        struct EmptyPopup : QObject {
+            QComboBox *combo;
+            explicit EmptyPopup(QComboBox *c)
+                : QObject(c)
+                , combo(c)
+            {
+            }
+            bool eventFilter(QObject *, QEvent *e) override
+            {
+                if (e->type() != QEvent::MouseButtonPress) {
+                    return false;
+                }
+                const auto *me = static_cast<QMouseEvent *>(e);
+                if (me->position().x() < combo->width() - 20) {
+                    return false; // the text part: typing, not the list
+                }
+                if (combo->count() > 0) {
+                    // Windows 7 lists the recent names only (no folders, no pictures) in a box at least 6 rows high
+                    const QString current = combo->currentText();
+                    for (int i = 0; i < combo->count(); ++i) {
+                        const QString t = combo->itemText(i);
+                        const int slash = t.lastIndexOf(QLatin1Char('/'));
+                        if (slash >= 0) {
+                            combo->setItemText(i, t.mid(slash + 1));
+                        }
+                        combo->setItemIcon(i, QIcon());
+                    }
+                    combo->setEditText(current);
+                    combo->view()->setMinimumHeight(120);
+                    return false;
+                }
+                auto *box = new QFrame(combo, Qt::Popup);
+                box->setAttribute(Qt::WA_DeleteOnClose);
+                box->setStyleSheet(QStringLiteral("QFrame { background: white; border: 1px solid #646464; }"));
+                box->setGeometry(QRect(combo->mapToGlobal(QPoint(0, combo->height())), QSize(combo->width(), 122)));
+                // the arrow cell stays pressed while the box is open
+                combo->setProperty("_seven_popup_open", true);
+                combo->update();
+                QPointer<QComboBox> c = combo;
+                QObject::connect(box, &QObject::destroyed, combo, [c] {
+                    if (c) {
+                        c->setProperty("_seven_popup_open", false);
+                        c->update();
+                    }
+                });
+                box->show();
+                return true;
+            }
+        };
+        m_locationEdit->installEventFilter(new EmptyPopup(m_locationEdit));
+    }
+    // Windows 7 drop-down lists: a plain list right under the field (not a menu over it), the item under
+    // the mouse in #3399ff with white text, a thin dark frame
+    for (QComboBox *combo : {static_cast<QComboBox *>(m_locationEdit), static_cast<QComboBox *>(m_filterWidget)}) {
+        if (combo) {
+            combo->setStyleSheet(QStringLiteral("QComboBox { combobox-popup: 0; }"));
+            combo->view()->setItemDelegate(new QStyledItemDelegate(combo->view())); // (rows sized by the style sheet)
+            combo->view()->setStyleSheet(QStringLiteral(
+                "QAbstractItemView { border: 1px solid #646464; background: white; outline: 0; padding: 0px; margin: 0px;"
+                " selection-background-color: #3399ff; selection-color: white; }"
+                "QAbstractItemView::item { height: 16px; min-height: 16px; max-height: 16px; padding: 0px 2px; margin: 0px; border: none; }"
+                "QAbstractItemView::item:selected, QAbstractItemView::item:hover { background: #3399ff; color: white; }"));
+        }
+    }
+    for (QPushButton *b : {m_okButton, m_cancelButton}) {
+        if (b) {
+            b->setIcon(QIcon());
+            // seen as 86 x 24 (the picture keeps 1 px of air on each side)
+            b->setMinimumWidth(88);
+            b->setFixedHeight(26);
+        }
+    }
+    // both seen 23 px high; the drop-down list is drawn 1 px inside its box
+    if (m_locationEdit) {
+        m_locationEdit->setFixedHeight(23);
+    }
+    if (m_filterWidget) {
+        m_filterWidget->setFixedHeight(25);
+    }
+    for (QLabel *l : {m_locationLabel, m_filterLabel}) {
+        if (l) {
+            l->setMinimumWidth(108);
+        }
+    }
 }
 
