+                return std::make_pair(nullptr, KIO::ERR_USER_CANCELED);
+            }
+        }
+        const QUrl url = freeScreenshotUrl(destUrl);
+        if (url.isEmpty()) {
+            return std::make_pair(nullptr, KIO::ERR_USER_CANCELED);
+        }
+        return std::make_pair(putDataAsyncTo(url, png, widget, KIO::JobFlags()), KJob::NoError);
