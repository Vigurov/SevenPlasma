+static QUrl freeScreenshotUrl(const QUrl &dir)
+{
+    QString local;
+    if (dir.isLocalFile()) {
+        local = dir.toLocalFile();
+    } else if (dir.scheme() == QLatin1String("desktop")) {
+        local = QStandardPaths::writableLocation(QStandardPaths::DesktopLocation) + dir.path();
+    }
+    for (int n = 1; n < 100000; ++n) {
+        const QString name = QStringLiteral("Знімок екрана (%1).png").arg(n);
+        if (local.isEmpty() || !QFileInfo::exists(QDir(local).filePath(name))) {
+            QUrl u = dir;
+            u.setPath(QDir(dir.path().isEmpty() ? QStringLiteral("/") : dir.path()).filePath(name));
+            return u;
+        }
+    }
+    return QUrl();
 }
 
