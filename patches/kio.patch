 using namespace KIO;
 
+// Windows 7 names copies made in the same folder "Name - копія.ext", then "Name - копія (2).ext" ...
+// (KDE: "Name (1).ext"). Remote folders keep KDE's suggestion.
+// desktop:/... is the Desktop folder (the desktop's own view uses it)
+static QUrl win7LocalUrl(const QUrl &u)
+{
+    if (u.scheme() == QLatin1String("desktop")) {
+        QUrl l = QUrl::fromLocalFile(QStandardPaths::writableLocation(QStandardPaths::DesktopLocation));
+        const QString sub = u.path();
+        if (!sub.isEmpty() && sub != QLatin1String("/")) {
+            l.setPath(Utils::concatPaths(l.path(), sub));
+        }
+        return l;
+    }
+    return u;
+}
+
+static QString win7SuggestName(const QUrl &destDirectoryIn, const QString &name)
+{
+    const QUrl destDirectory = win7LocalUrl(destDirectoryIn);
+    if (!destDirectory.isLocalFile()) {
+        return KFileUtils::suggestName(destDirectory, name);
+    }
+    const QString dir = destDirectory.toLocalFile();
+    const QFileInfo fi(dir + QLatin1Char('/') + name);
+    QString base = name, ext;
+    const int dot = name.lastIndexOf(QLatin1Char('.'));
+    if (!fi.isDir() && dot > 0) {
+        base = name.left(dot);
+        ext = name.mid(dot);
+    }
+    const QString copy = QStringLiteral(" - копія");
+    QString candidate = base + copy + ext;
+    for (int n = 2; QFileInfo::exists(dir + QLatin1Char('/') + candidate) || QFileInfo(dir + QLatin1Char('/') + candidate).isSymLink(); ++n) {
+        candidate = base + copy + QStringLiteral(" (%1)").arg(n) + ext;
+    }
+    return candidate;
+}
+
