+void KFileWin7NavPane::drawRow(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const
+{
+    // Windows 7 highlights the whole row (arrow included) with a rounded box
+    if (index.flags() & Qt::ItemIsEnabled) {
+        const bool selected = selectionModel() && selectionModel()->isSelected(index);
+        const bool hovered = (index == m_hoverIndex);
+        if (selected || hovered) {
+            const QRectF box(1.5, option.rect.top() + 0.5, viewport()->width() - 3, option.rect.height() - 1);
+            QColor top, bottom, border;
+            if (selected && hasFocus()) {
+                top = QColor(0xdc, 0xeb, 0xfc);
+                bottom = QColor(0xc1, 0xdb, 0xfc);
+                border = hovered ? QColor(0x7d, 0xa2, 0xce) : QColor(0x84, 0xac, 0xdd);
+            } else if (selected && !hovered) {
+                top = QColor(0xf8, 0xf8, 0xf8);
+                bottom = QColor(0xe5, 0xe5, 0xe5);
+                border = QColor(0xd9, 0xd9, 0xd9);
+            } else if (selected) {
+                top = QColor(0xdc, 0xeb, 0xfc);
+                bottom = QColor(0xc1, 0xdb, 0xfc);
+                border = QColor(0x7d, 0xa2, 0xce);
+            } else {
+                top = QColor(0xfa, 0xfb, 0xfd);
+                bottom = QColor(0xe8, 0xf1, 0xfc);
+                border = QColor(0xb8, 0xd6, 0xfb);
+            }
+            QLinearGradient gradient(box.topLeft(), box.bottomLeft());
+            gradient.setColorAt(0, top);
+            gradient.setColorAt(1, bottom);
+            painter->save();
+            painter->setRenderHint(QPainter::Antialiasing);
+            painter->setPen(border);
+            painter->setBrush(gradient);
+            painter->drawRoundedRect(box, 3, 3);
+            painter->restore();
+        }
+    }
+    QTreeView::drawRow(painter, option, index);
+}
+
+QRect KFileWin7NavPane::arrowRect(const QModelIndex &index) const
+{
+    const QRect item = visualRect(index);
+    return QRect(item.left() - indentation(), item.top(), indentation(), item.height());
+}
+
+void KFileWin7NavPane::mouseMoveEvent(QMouseEvent *event)
+{
+    const QModelIndex index = indexAt(event->pos());
+    const QPersistentModelIndex hover = (index.flags() & Qt::ItemIsEnabled) ? QPersistentModelIndex(index) : QPersistentModelIndex();
+    const bool arrowHot = hover.isValid() && model()->hasChildren(hover) && arrowRect(hover).contains(event->pos());
+    if (hover != m_hoverIndex || arrowHot != m_arrowHot) {
+        m_hoverIndex = hover;
+        m_arrowHot = arrowHot;
+        viewport()->update();
+    }
+    QTreeView::mouseMoveEvent(event);
+}
+
+void KFileWin7NavPane::drawBranches(QPainter *painter, const QRect &rect, const QModelIndex &index) const
+{
+    // No tree lines; expand arrows only while the mouse is over the pane (as in Windows 7)
+    if (!m_hovered || !model()->hasChildren(index)) {
+        return;
+    }
+    const int ind = indentation();
+    const QRectF box(rect.right() - ind + 1, rect.top(), ind, rect.height());
+    const QPointF c = box.center();
+
+    // The arrow under the mouse turns light blue
+    const bool hot = m_arrowHot && index == m_hoverIndex;
+
+    painter->save();
+    painter->setRenderHint(QPainter::Antialiasing);
+    if (isExpanded(index)) {
+        // Filled dark triangle pointing down-right
+        QPolygonF tri({QPointF(c.x() + 3, c.y() - 3), QPointF(c.x() + 3, c.y() + 3), QPointF(c.x() - 3, c.y() + 3)});
+        painter->setPen(QPen(hot ? QColor(0x1c, 0x97, 0xea) : QColor(0x26, 0x26, 0x26), 1));
+        painter->setBrush(hot ? QColor(0x82, 0xd4, 0xf8) : QColor(0x59, 0x59, 0x59));
+        painter->drawPolygon(tri);
+    } else {
+        // Hollow grey triangle pointing right
+        QPolygonF tri({QPointF(c.x() - 2, c.y() - 4), QPointF(c.x() + 2, c.y()), QPointF(c.x() - 2, c.y() + 4)});
+        painter->setPen(QPen(hot ? QColor(0x1c, 0x97, 0xea) : QColor(0xa6, 0xa6, 0xa6), 1));
+        painter->setBrush(hot ? QColor(0xb9, 0xe6, 0xfb) : Qt::white);
+        painter->drawPolygon(tri);
+    }
+    painter->restore();
+}
+
+QSize KFileWin7NavPane::sizeHint() const
+{
+    return QSize(163, QTreeView::sizeHint().height()); // Windows 7: the pane is 166 px with its line
+}
