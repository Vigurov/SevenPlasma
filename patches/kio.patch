+        if (!mimeData->hasImage()) {
+            return std::make_pair(nullptr, KIO::ERR_USER_CANCELED);
+        }
+        // the picture as the application already encoded it (Discord, browsers: image/png) is written as is --
+        // re-encoding a 12 MP photo took seconds; only a bare image is encoded, with light compression
+        QByteArray png = mimeData->data(QStringLiteral("image/png"));
